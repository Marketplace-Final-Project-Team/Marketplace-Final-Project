# Environment variables for Marketplace project

# ===== SQL Server =====
DB_SERVER=database
DB_PORT=1433
DB_NAME=MarketplaceDB
DB_USER=sa
DB_PASSWORD=
ACCEPT_EULA=Y
MSSQL_PID=Developer

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ===== Backend =====
BACKEND_PORT=8080

# ===== Frontend =====
FRONTEND_PORT=3000

# ===== Nginx =====
NGINX_PORT=80

# ===== Prometheus =====
PROMETHEUS_PORT=9090

# ===== Grafana =====
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ===== AWS S3 =====
AWS_REGION=
AWS_S3_BUCKET=
