@page "/login"
@model Marketplace.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вхід";
}

<section class="auth-card" aria-labelledby="login-title">
    <div class="auth-card__header">
        <p class="auth-kicker">З поверненням</p>
        <h2 id="login-title">Увійдіть до акаунта</h2>
        <p>Продовжуйте покупки, перевіряйте замовлення або керуйте магазином.</p>
    </div>

    <form method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

        <div class="field">
            <label asp-for="Input.Email">Електронна пошта</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">@@</span>
                <input asp-for="Input.Email"
                       autocomplete="email"
                       inputmode="email"
                       placeholder="name@example.com"
                       autofocus />
            </div>
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="field">
            <div class="field-label-row">
                <label asp-for="Input.Password">Пароль</label>
                <span class="field-hint">Мінімум 8 символів</span>
            </div>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="Input.Password"
                       autocomplete="current-password"
                       placeholder="Введіть пароль"
                       data-password-input />
                <button class="password-toggle"
                        type="button"
                        data-password-toggle
                        aria-label="Показати пароль"
                        aria-pressed="false">
                    Показати
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <label class="checkbox">
            <input asp-for="Input.RememberMe" />
            <span>Залишатися в системі</span>
        </label>

        <button class="button button--primary" type="submit">
            Увійти
            <span aria-hidden="true">→</span>
        </button>
    </form>

    <div class="auth-divider"><span>або</span></div>

    <p class="auth-switch">
        Ще не маєте акаунта?
        <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Створити акаунт</a>
    </p>

    <p class="auth-note">
        Входячи, ви погоджуєтеся з правилами користування та політикою конфіденційності.
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
