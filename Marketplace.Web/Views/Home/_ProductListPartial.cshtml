@model Marketplace.Web.Models.CatalogIndexViewModel

<div class="home-section__heading align-items-end mb-4">
    <div>
        <span class="home-section__kicker">@Localizer["Каталог"]</span>
        <h2>@SharedLocalizer["Усі товари"]</h2>
    </div>

    <form method="get" id="sortForm" class="d-flex align-items-center gap-2">
        <input type="hidden" name="search" value="@Model.Search" />
        @if (Model.CategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
        }
        <label for="sortBySelect" class="text-muted small text-nowrap">@Localizer["Сортування:"]</label>
        <select id="sortBySelect" name="sortBy" class="form-select form-select-sm js-async-sort" style="width: auto;">
            <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">@Localizer["Спочатку нові"]</option>
            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@Localizer["Дешевші"]</option>
            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@Localizer["Дорожчі"]</option>
        </select>
    </form>
</div>

@if (Model.Products == null || Model.Products.Count == 0)
{
    <div class="text-center py-5">
        <div class="fs-1 text-muted mb-2">□</div>
        <h4>@Localizer["Товарів не знайдено"]</h4>
        <p class="text-muted">@Localizer["Спробуйте змінити пошуковий запит або обрати іншу категорію."]</p>
        <a href="javascript:void(0)" class="home-button home-button--ghost mt-2 js-reset-filters">@Localizer["Скинути всі фільтри"]</a>
    </div>
}
else
{
    <div class="home-products">
        @for (var index = 0; index < Model.Products.Count; index++)
        {
            var product = Model.Products[index];
            var colorClass = index % 3 == 0 ? "blue" : index % 3 == 1 ? "violet" : "orange";
            var productName = (await ProductTranslator.GetLocalizedAsync(product.Id, product.Name, product.Description, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)).Name;
            var filledStars = Math.Clamp((int)Math.Round(product.AverageRating), 0, 5);

            <article class="home-product">
                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="home-product__media home-product__media--@colorClass">
                    @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                    {
                        <img src="@product.MainImageUrl" alt="@productName" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(productName) ? "?" : productName[..1].ToUpperInvariant())</span>
                    }
                    <small>@Localizer["В наявності"]</small>
                </a>
                <div class="home-product__body">
                    <div class="home-product__category">@(string.IsNullOrEmpty(product.CategoryName) ? Localizer["Без категорії"].Value : SharedLocalizer[product.CategoryName].Value)</div>
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="home-product__name">@productName</a>

                    <div class="home-product__rating" aria-label="@Localizer["Рейтинг {0} з 5, {1} відгуків", product.AverageRating.ToString("0.0"), product.ReviewCount]">
                        <span class="home-product__stars" aria-hidden="true">
                            <span>@(new string('★', filledStars))</span><span class="home-product__stars-empty">@(new string('★', 5 - filledStars))</span>
                        </span>
                        <span class="home-product__review-count">@(product.ReviewCount > 0 ? $"{product.AverageRating:0.0} · {product.ReviewCount}" : Localizer["Без відгуків"].Value)</span>
                    </div>

                    <div class="home-product__bottom">
                        <div class="home-product__price @(product.HasDiscount ? "home-product__price--discount" : null)">
                            <div class="home-product__price-row">
                                <strong class="home-product__price-current @(product.HasDiscount ? "home-product__price-current--discount" : null)">@product.Price.ToString("N2") ₴</strong>
                                @if (product.HasDiscount && product.OriginalPrice.HasValue)
                                {
                                    <span class="home-product__price-old">@product.OriginalPrice.Value.ToString("N2") ₴</span>
                                }
                            </div>
                            @if (product.HasDiscount && product.OriginalPrice.HasValue)
                            {
                                <span class="home-product__discount-badge">−@product.DiscountPercent!.Value.ToString("0.##")%</span>
                            }
                        </div>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="home-product__cart-form">
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button type="submit" class="home-product__add" aria-label="@Localizer["Додати"] @productName @Localizer["до кошика"]">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 9.1a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L20.4 8H7"/><circle cx="10" cy="19" r="1.25"/><circle cx="17" cy="19" r="1.25"/></svg>
                                <span>@Localizer["До кошика"]</span>
                            </button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5">
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link js-async-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </div>
    }
}
