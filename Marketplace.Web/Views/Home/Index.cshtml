@model Marketplace.Web.Models.HomeViewModel

@{
    ViewData["Title"] = SharedLocalizer["Головна"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    @{
        var heroSlides = Model.Categories.Where(c => !string.IsNullOrWhiteSpace(c.ImageUrl)).ToList();

        // Wikimedia-hosted category photos are stored as 500px thumbnails; the hero is far wider,
        // so ask for the 1280px rendition first and keep the stored one as a fallback layer.
        string HeroBackground(string url)
        {
            var safe = url.Replace("'", "%27");
            var large = safe.Contains("upload.wikimedia.org") ? safe.Replace("/500px-", "/1280px-") : safe;
            return large == safe ? $"url('{safe}')" : $"url('{large}'), url('{safe}')";
        }
    }

    @if (heroSlides.Count > 0)
    {
        <section class="home-carousel" aria-label="@SharedLocalizer["Категорії"]">
            <div id="homeHeroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000" data-bs-pause="hover" data-bs-touch="true">
                @if (heroSlides.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < heroSlides.Count; i++)
                        {
                            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)"
                                    aria-label="@SharedLocalizer[heroSlides[i].Name]"></button>
                        }
                    </div>
                }
                <div class="carousel-inner">
                    @for (var i = 0; i < heroSlides.Count; i++)
                    {
                        var slide = heroSlides[i];
                        <div class="carousel-item @(i == 0 ? "active" : null)">
                            <a asp-controller="Catalogue" asp-action="Index" asp-route-categoryId="@slide.Id"
                               class="home-carousel__slide" style="background-image:@Html.Raw(HeroBackground(slide.ImageUrl!))">
                                <span class="home-carousel__caption">
                                    <small>@SharedLocalizer["Категорії"]</small>
                                    <strong>@SharedLocalizer[slide.Name]</strong>
                                    <em>@slide.ProductCount @(slide.ProductCount == 1 ? Localizer["товар"].Value : slide.ProductCount is >= 2 and <= 4 ? Localizer["товари"].Value : Localizer["товарів"].Value)</em>
                                </span>
                            </a>
                        </div>
                    }
                </div>
                @if (heroSlides.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
                        <span class="home-carousel__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="M15 6 9 12 15 18" /></svg>
                        </span>
                        <span class="visually-hidden">@Localizer["Попередній"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
                        <span class="home-carousel__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="M9 6 15 12 9 18" /></svg>
                        </span>
                        <span class="visually-hidden">@Localizer["Наступний"]</span>
                    </button>
                }
            </div>
        </section>
    }

    @foreach (var (categorySection, sectionIndex) in Model.CategorySections.Select((section, i) => (section, i)))
    {
        var carouselId = $"homeCarousel{sectionIndex}";
        <section class="home-section home-featured">
            <div class="home-section__heading">
                <div>
                    <span class="home-section__kicker">@Localizer["Обирайте швидше"]</span>
                    <h2>@SharedLocalizer[categorySection.CategoryName]</h2>
                </div>
                <div class="home-section__actions">
                    @if (sectionIndex == 0)
                    {
                        <div class="home-view-bar">
                            <span class="home-view-bar__label">@Localizer["Вигляд товарів"]</span>
                            <div class="home-view-toggle" role="group" aria-label="@Localizer["Режим перегляду товарів"]">
                                <button type="button" class="home-view-toggle__btn" data-view-toggle="list" aria-label="@Localizer["Список"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M8 6h13" /><path d="M8 12h13" /><path d="M8 18h13" /><path d="M3 6h.01" /><path d="M3 12h.01" /><path d="M3 18h.01" /></svg>
                                    <span>@Localizer["Список"]</span>
                                </button>
                                <button type="button" class="home-view-toggle__btn" data-view-toggle="grid" aria-label="@Localizer["Палітра"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="3" y="3" width="7" height="7" rx="1.2" /><rect x="14" y="3" width="7" height="7" rx="1.2" /><rect x="14" y="14" width="7" height="7" rx="1.2" /><rect x="3" y="14" width="7" height="7" rx="1.2" /></svg>
                                    <span>@Localizer["Палітра"]</span>
                                </button>
                                <button type="button" class="home-view-toggle__btn" data-view-toggle="slider" aria-label="@Localizer["Карусель"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="7" y="4" width="10" height="16" rx="1.5" /><path d="M2 8v8" /><path d="M22 8v8" /></svg>
                                    <span>@Localizer["Карусель"]</span>
                                </button>
                            </div>
                        </div>
                    }
                    <a asp-controller="Catalogue" asp-action="Index" asp-route-categoryId="@categorySection.CategoryId">@Localizer["Дивитися більше →"]</a>
                </div>
            </div>

            <div data-products-view="grid">
                <div class="home-products">
                    @for (var index = 0; index < categorySection.Products.Count; index++)
                    {
                        var product = categorySection.Products[index];
                        var productName = (await ProductTranslator.GetLocalizedAsync(product.Id, product.Name, product.Description, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)).Name;
                        var colorClass = index % 3 == 0 ? "blue" : index % 3 == 1 ? "violet" : "orange";
                        var filledStars = Math.Clamp((int)Math.Round(product.AverageRating), 0, 5);
                        var hasDiscount = product.OriginalPrice.HasValue && product.OriginalPrice.Value > product.Price;
                        <article class="home-product position-relative">

                            <!-- ПЛАШКА 18+ -->
                            @if (product.IsAgeRestricted)
                            {
                                <span class="position-absolute top-0 end-0 bg-danger text-white text-xs fw-bold px-2 py-1 rounded-pill z-1 m-2 shadow">
                                    18+
                                </span>
                            }

                            <button type="button" class="home-product__media home-product__media--@colorClass border-0 w-100 text-start"
                                    onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                                {
                                    <img src="@product.MainImageUrl" alt="@productName" />
                                }
                                else
                                {
                                    <span>@productName[..1].ToUpperInvariant()</span>
                                }
                                <small>@(product.Quantity > 0 ? Localizer["В наявності"].Value : Localizer["Немає в наявності"].Value)</small>
                            </button>

                            <div class="home-product__body">
                                <div class="home-product__category">@SharedLocalizer[product.CategoryName]</div>
                                <button type="button" class="home-product__name border-0 bg-transparent p-0 text-start"
                                        onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                    @productName
                                </button>
                                <div class="home-product__rating" aria-label="@Localizer["Рейтинг {0} з 5, {1} відгуків", product.AverageRating.ToString("0.0"), product.ReviewCount]">
                                    <span class="home-product__stars" aria-hidden="true">
                                        <span>@(new string('★', filledStars))</span><span class="home-product__stars-empty">@(new string('★', 5 - filledStars))</span>
                                    </span>
                                    <span class="home-product__review-count">@(product.ReviewCount > 0 ? $"{product.AverageRating:0.0} · {product.ReviewCount}" : Localizer["Без відгуків"].Value)</span>
                                </div>
                                <div class="home-product__bottom">
                                    <div class="home-product__price @(hasDiscount ? "home-product__price--discount" : null)">
                                        <div class="home-product__price-row">
                                            <strong class="home-product__price-current @(hasDiscount ? "home-product__price-current--discount" : null)">@product.Price.ToString("N2") ₴</strong>
                                            @if (hasDiscount)
                                            {
                                                <span class="home-product__price-old">@product.OriginalPrice!.Value.ToString("N2") ₴</span>
                                            }
                                        </div>
                                        @if (hasDiscount && product.DiscountPercent.HasValue)
                                        {
                                            <span class="home-product__discount-badge">−@product.DiscountPercent.Value.ToString("0.##")%</span>
                                        }
                                    </div>
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="home-product__cart-form">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="home-product__add" aria-label="@Localizer["Додати {0} до кошика", productName]">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 9.1a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L20.4 8H7"/><circle cx="10" cy="19" r="1.25"/><circle cx="17" cy="19" r="1.25"/></svg>
                                            <span>@Localizer["До кошика"]</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <div data-products-view="list" hidden>
                <div class="home-product-list">
                    @for (var index = 0; index < categorySection.Products.Count; index++)
                    {
                        var product = categorySection.Products[index];
                        var productName = (await ProductTranslator.GetLocalizedAsync(product.Id, product.Name, product.Description, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)).Name;
                        var filledStars = Math.Clamp((int)Math.Round(product.AverageRating), 0, 5);
                        var hasDiscount = product.OriginalPrice.HasValue && product.OriginalPrice.Value > product.Price;
                        <div class="home-product-list__row">
                            <button type="button" class="home-product-list__media border-0"
                                    onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                                {
                                    <img src="@product.MainImageUrl" alt="@productName" />
                                }
                                else
                                {
                                    <span>@productName[..1].ToUpperInvariant()</span>
                                }
                                @if (product.IsAgeRestricted)
                                {
                                    <span class="home-product-list__age-badge">18+</span>
                                }
                            </button>
                            <div class="home-product-list__info">
                                <div class="home-product__category">@SharedLocalizer[product.CategoryName]</div>
                                <button type="button" class="home-product-list__name border-0 bg-transparent p-0 text-start"
                                        onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                    @productName
                                </button>
                                <div class="home-product__rating" aria-label="@Localizer["Рейтинг {0} з 5, {1} відгуків", product.AverageRating.ToString("0.0"), product.ReviewCount]">
                                    <span class="home-product__stars" aria-hidden="true"><span>@(new string('★', filledStars))</span><span class="home-product__stars-empty">@(new string('★', 5 - filledStars))</span></span>
                                    <span class="home-product__review-count">@(product.ReviewCount > 0 ? $"{product.AverageRating:0.0} · {product.ReviewCount}" : Localizer["Без відгуків"].Value)</span>
                                </div>
                            </div>
                            <div class="home-product-list__price @(hasDiscount ? "home-product-list__price--discount" : null)">
                                <strong class="@(hasDiscount ? "home-product__price-current--discount" : null)">@product.Price.ToString("N2") ₴</strong>
                                @if (hasDiscount)
                                {
                                    <span class="home-product__price-old">@product.OriginalPrice!.Value.ToString("N2") ₴</span>
                                    @if (product.DiscountPercent.HasValue)
                                    {
                                        <span class="home-product__discount-badge">−@product.DiscountPercent.Value.ToString("0.##")%</span>
                                    }
                                }
                            </div>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="home-product-list__add" aria-label="@Localizer["Додати {0} до кошика", productName]">@Localizer["До кошика"]</button>
                            </form>
                        </div>
                    }
                </div>
            </div>


            <div data-products-view="slider" hidden>
                <div id="@carouselId" class="carousel slide home-product-carousel" data-bs-ride="false" data-bs-interval="false">
                    <div class="carousel-inner">
                        @for (var index = 0; index < categorySection.Products.Count; index++)
                        {
                            var product = categorySection.Products[index];
                            var productName = (await ProductTranslator.GetLocalizedAsync(product.Id, product.Name, product.Description, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)).Name;
                            var filledStars = Math.Clamp((int)Math.Round(product.AverageRating), 0, 5);
                            var hasDiscount = product.OriginalPrice.HasValue && product.OriginalPrice.Value > product.Price;
                            <div class="carousel-item @(index == 0 ? "active" : "")">
                                <div class="home-product-slide">
                                    <button type="button" class="home-product-slide__media border-0"
                                            onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                        @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                                        {
                                            <img src="@product.MainImageUrl" alt="@productName" />
                                        }
                                        else
                                        {
                                            <span>@productName[..1].ToUpperInvariant()</span>
                                        }
                                        @if (product.IsAgeRestricted)
                                        {
                                            <span class="home-product-list__age-badge">18+</span>
                                        }
                                    </button>
                                    <div class="home-product-slide__body">
                                        <div class="home-product__category">@SharedLocalizer[product.CategoryName]</div>
                                        <button type="button" class="home-product-slide__name border-0 bg-transparent p-0 text-start"
                                                onclick="checkAgeAndAction('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                                            @productName
                                        </button>
                                        <div class="home-product__rating" aria-label="@Localizer["Рейтинг {0} з 5, {1} відгуків", product.AverageRating.ToString("0.0"), product.ReviewCount]">
                                            <span class="home-product__stars" aria-hidden="true"><span>@(new string('★', filledStars))</span><span class="home-product__stars-empty">@(new string('★', 5 - filledStars))</span></span>
                                            <span class="home-product__review-count">@(product.ReviewCount > 0 ? $"{product.AverageRating:0.0} · {product.ReviewCount}" : Localizer["Без відгуків"].Value)</span>
                                        </div>
                                        <div class="home-product__bottom">
                                            <div class="home-product__price @(hasDiscount ? "home-product__price--discount" : null)">
                                                <div class="home-product__price-row">
                                                    <strong class="home-product__price-current @(hasDiscount ? "home-product__price-current--discount" : null)">@product.Price.ToString("N2") ₴</strong>
                                                    @if (hasDiscount)
                                                    {
                                                        <span class="home-product__price-old">@product.OriginalPrice!.Value.ToString("N2") ₴</span>
                                                    }
                                                </div>
                                                @if (hasDiscount && product.DiscountPercent.HasValue)
                                                {
                                                    <span class="home-product__discount-badge">−@product.DiscountPercent.Value.ToString("0.##")%</span>
                                                }
                                            </div>
                                            <form asp-controller="Cart" asp-action="Add" method="post" class="home-product__cart-form">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="home-product__add" aria-label="@Localizer["Додати {0} до кошика", productName]">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 9.1a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L20.4 8H7"/><circle cx="10" cy="19" r="1.25"/><circle cx="17" cy="19" r="1.25"/></svg>
                                                    <span>@Localizer["До кошика"]</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Попередній"]</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">@Localizer["Наступний"]</span>
                    </button>
                </div>
            </div>
        </section>
    }

    @if (Model.RecentlyViewed.Count > 0)
    {
        <section class="home-section">
            <div class="home-section__heading">
                <div>
                    <span class="home-section__kicker">@Localizer["Ваша історія"]</span>
                    <h2>@Localizer["Нещодавно переглянуті"]</h2>
                </div>
                <a asp-controller="Catalog" asp-action="Index">@Localizer["Увесь каталог →"]</a>
            </div>
            <div class="home-products">
                @for (var index = 0; index < Model.RecentlyViewed.Count; index++)
                {
                    var product = Model.RecentlyViewed[index];
                    var productName = (await ProductTranslator.GetLocalizedAsync(product.Id, product.Name, string.Empty, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)).Name;
                    var colorClass = index % 3 == 0 ? "blue" : index % 3 == 1 ? "violet" : "orange";
                    <article class="home-product">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="home-product__media home-product__media--@colorClass">
                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl" alt="@productName" />
                            }
                            else
                            {
                                <span>@productName[..1].ToUpperInvariant()</span>
                            }
                            <small>@Localizer["Переглянуто"]</small>
                        </a>
                        <div class="home-product__body">
                            <div class="home-product__category">@SharedLocalizer[product.CategoryName]</div>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@product.Id" class="home-product__name">@productName</a>
                            <div class="home-product__bottom">
                                <strong>@product.Price.ToString("N2") ₴</strong>
                                @if (product.OriginalPrice.HasValue)
                                {
                                    <del class="text-muted small">@product.OriginalPrice.Value.ToString("N2") ₴</del>
                                    <span class="badge bg-danger">−@product.DiscountPercent.ToString("0.##")%</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="home-section">
        <div class="home-section__heading">
            <div>
                <span class="home-section__kicker">@Localizer["Обирайте швидше"]</span>
                <h2>@Localizer["Популярні категорії"]</h2>
            </div>
            <a asp-controller="Catalogue" asp-action="Index">@Localizer["Увесь каталог →"]</a>
        </div>

        @if (Model.Categories.Count == 0)
        {
            <p class="text-secondary">@Localizer["Категорії ще не додані."]</p>
        }
        else
        {
            <div class="category-grid">
                @foreach (var category in Model.Categories)
                {
                    var hasImage = !string.IsNullOrWhiteSpace(category.ImageUrl);
                    <a asp-controller="Catalogue" asp-action="Index" asp-route-categoryId="@category.Id"
                       class="category-card @(hasImage ? "category-card--photo" : $"category-card--{category.ColorClass}")"
                       style="@(hasImage ? $"background-image:url('{category.ImageUrl}')" : null)">
                        @if (!hasImage)
                        {
                            <span class="category-card__icon">@category.Icon</span>
                        }
                        <strong>@SharedLocalizer[category.Name]</strong>
                        <small>@category.ProductCount @(category.ProductCount == 1 ? Localizer["товар"].Value : category.ProductCount is >= 2 and <= 4 ? Localizer["товари"].Value : Localizer["товарів"].Value)</small>
                    </a>
                }
            </div>
        }
    </section>

    <section class="home-benefits" aria-label="@Localizer["Переваги LUNEXA"]">
        <div><span>✓</span><p><strong>@Localizer["Перевірені товари"]</strong><small>@Localizer["зрозумілий статус наявності"]</small></p></div>
        <div><span>↺</span><p><strong>@Localizer["Просте повернення"]</strong><small>@Localizer["прозорий процес покупки"]</small></p></div>
        <div><span>□</span><p><strong>@Localizer["Зручний кошик"]</strong><small>@Localizer["керуйте кількістю онлайн"]</small></p></div>
        <div><span>→</span><p><strong>@Localizer["Контроль доставки"]</strong><small>@Localizer["від замовлення до отримання"]</small></p></div>
    </section>
</div>

<!-- МОДАЛЬНЕ ВІКНО 18+ -->
<div id="ageVerificationModal" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 z-3 d-flex align-items-center justify-content-center p-3" style="backdrop-filter: blur(4px);">
    <div class="bg-white rounded-4 shadow-lg p-4 text-center" style="max-width: 400px; width: 100%;">
        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger fs-3 fw-bold mb-3" style="width: 64px; height: 64px;">
            18+
        </div>
        <h3 class="fs-4 fw-bold text-dark mb-2">@Localizer["Підтвердження віку"]</h3>
        <p class="text-secondary small mb-4">
            @Localizer["Цей контент містить товари для повнолітніх. Вам вже виповнилося 18 років?"]
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button onclick="confirmAge(false)" class="btn btn-light w-100 fw-medium">@Localizer["Ні, мені менше 18"]</button>
            <button onclick="confirmAge(true)" class="btn btn-danger w-100 fw-medium">@Localizer["Так, мені є 18"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pendingTargetUrl = null;
        const modal = document.getElementById('ageVerificationModal');

        function checkAgeAndAction(entityId, isRestricted) {
            const isAdultConfirmed = localStorage.getItem('age_verified') === 'true';

            if (isRestricted && !isAdultConfirmed) {
                pendingTargetUrl = `/Catalogue/Details/${entityId}`;
                modal.classList.remove('d-none');
            } else {
                window.location.href = `/Catalogue/Details/${entityId}`;
            }
        }

        function confirmAge(isAdult) {
            if (isAdult) {
                localStorage.setItem('age_verified', 'true');
                modal.classList.add('d-none');

                if (pendingTargetUrl) {
                    window.location.href = pendingTargetUrl;
                }
            } else {
                alert("@Localizer["Доступ обмежено для осіб молодше 18 років."]");
                modal.classList.add('d-none');
            }
        }
    </script>
    <script src="~/js/home-products-view.js" asp-append-version="true"></script>
}
