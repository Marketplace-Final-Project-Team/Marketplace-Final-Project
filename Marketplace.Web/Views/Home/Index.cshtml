@model Marketplace.Web.Models.CatalogIndexViewModel

@{
    ViewData["Title"] = "Головна";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <!-- HERO СЕКЦІЯ -->
    <section class="home-hero">
        <div class="home-hero__content">
            <div class="home-pill"><span></span> Покупки без зайвих кроків</div>
            <h1>Усе потрібне — <em>в одному місці</em></h1>
            <p>Знаходьте товари для роботи, дому й відпочинку. Порівнюйте пропозиції, додавайте до кошика та стежте за доставкою.</p>

            <form asp-controller="Catalog" asp-action="Index" method="get" class="home-search" role="search" style="position: relative;">
                <span aria-hidden="true">⌕</span>
                <input name="search" 
                       id="searchInput" 
                       value="@Model?.Search" 
                       placeholder="Що ви шукаєте?" 
                       aria-label="Пошук товарів" 
                       autocomplete="off" />

                @if (Model?.CategoryId.HasValue == true)
                {
                    <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                }
                @if (!string.IsNullOrEmpty(Model?.SortBy))
                {
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                }
                <button type="submit">Знайти</button>

                <ul id="searchSuggestions" class="search-suggestions" style="display: none;"></ul>
            </form>

            <div class="home-hero__actions">
                <a href="#catalog-products" class="home-button home-button--primary">Перейти до товарів <span>↓</span></a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Auth" asp-action="SignUp" class="home-button home-button--ghost">Створити акаунт</a>
                }
                else
                {
                    <a asp-controller="Order" asp-action="Index" class="home-button home-button--ghost">Мої замовлення</a>
                }
            </div>

            <div class="home-hero__proof">
                <div class="home-avatars" aria-hidden="true">
                    <span>А</span><span>М</span><span>О</span>
                </div>
                <div><strong>Зручно для кожного</strong><small>від пошуку до доставки</small></div>
            </div>
        </div>

        <div class="home-hero__visual" aria-label="Популярні пропозиції">
            <div class="visual-orbit visual-orbit--one"></div>
            <div class="visual-orbit visual-orbit--two"></div>

            <div class="visual-main-card">
                <div class="visual-main-card__top">
                    <span class="visual-tag">Вибір тижня</span>
                    <span class="visual-heart" aria-hidden="true">♡</span>
                </div>
                <div class="visual-product">
                    <div class="visual-product__halo"></div>
                    <div class="visual-product__shape" aria-hidden="true">
                        <span></span>
                    </div>
                </div>
                <div class="visual-main-card__copy">
                    <small>Техніка для щоденних справ</small>
                    <strong>Знижки до 30%</strong>
                    <a href="#catalog-products">Переглянути пропозиції →</a>
                </div>
            </div>

            <div class="visual-float-card visual-float-card--rating">
                <span class="visual-float-card__icon">★</span>
                <div><strong>4.9</strong><small>оцінка покупців</small></div>
            </div>
            <div class="visual-float-card visual-float-card--delivery">
                <span class="visual-float-card__icon">✓</span>
                <div><strong>Швидка доставка</strong><small>статус завжди під рукою</small></div>
            </div>
        </div>
    </section>

    <!-- ПЕРЕВАГИ -->
    <section class="home-benefits" aria-label="Переваги маркетплейсу">
        <div><span>✓</span><p><strong>Перевірені товари</strong><small>зрозумілий статус наявності</small></p></div>
        <div><span>↺</span><p><strong>Просте повернення</strong><small>прозорий процес покупки</small></p></div>
        <div><span>□</span><p><strong>Зручний кошик</strong><small>керуйте кількістю онлайн</small></p></div>
        <div><span>→</span><p><strong>Контроль доставки</strong><small>від замовлення до отримання</small></p></div>
    </section>

    <!-- КАТЕГОРІЇ -->
    <section class="home-section">
        <div class="home-section__heading">
            <div>
                <span class="home-section__kicker">Обирайте швидше</span>
                <h2>Популярні категорії</h2>
            </div>
            @if (Model?.CategoryId.HasValue == true)
            {
                <a asp-action="Index" class="text-primary js-reset-filters">Скинути фільтр категорій ✕</a>
            }
        </div>

        <div class="category-grid">
            <a asp-action="Index" asp-route-search="@Model?.Search" asp-route-sortBy="@Model?.SortBy" class="category-card category-card--blue @(Model?.CategoryId.HasValue != true ? "border border-2 border-primary" : "")">
                <span class="category-card__icon">⌁</span>
                <strong>Усі категорії</strong>
                <small>Переглянути все</small>
            </a>
          @if (Model?.Categories != null)
{
    foreach (var cat in Model.Categories)
    {
        var isSelected = Model.CategoryId?.ToString() == cat.Value;
        <a asp-action="Index" asp-route-categoryId="@cat.Value" asp-route-search="@Model?.Search" asp-route-sortBy="@Model?.SortBy" class="category-card category-card--violet @(isSelected ? "border border-2 border-primary" : "")">
            <span class="category-card__icon">⌂</span>
            <strong>@cat.Text</strong>
            <small>Категорія</small>
        </a>
    }
}
        </div>
    </section>

    <!-- СЕКЦІЯ ТОВАРІВ -->
    <section class="home-section home-featured" id="catalog-products">
        @if (Model != null)
        {
            @await Html.PartialAsync("_ProductListPartial", Model)
        }
    </section>

    <!-- ПРОМО ДЛЯ ПРОДАВЦІВ -->
    <section class="home-promo">
        <div class="home-promo__content">
            <span class="home-section__kicker">Для продавців</span>
            <h2>Перетворіть ідею на власний магазин</h2>
            <p>Додавайте товари, керуйте залишками та отримуйте замовлення в одному робочому просторі.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Business" asp-action="Create" class="home-button home-button--light">Створити бізнес →</a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="SignUp" class="home-button home-button--light">Почати продавати →</a>
            }
        </div>
        <div class="home-promo__dashboard" aria-hidden="true">
            <div class="dashboard-top"><span></span><span></span><span></span></div>
            <div class="dashboard-body">
                <div class="dashboard-sidebar"></div>
                <div class="dashboard-content">
                    <span></span>
                    <div class="dashboard-bars"><i></i><i></i><i></i><i></i><i></i></div>
                    <div class="dashboard-lines"><i></i><i></i><i></i></div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('catalog-products');
            const searchInput = document.getElementById('searchInput');
            const suggestionsBox = document.getElementById('searchSuggestions');
            let debounceTimer;

            function updateCategoryHighlight(targetUrl) {
                const urlObj = new URL(targetUrl, window.location.origin);
                const activeCategoryId = urlObj.searchParams.get('categoryId');

                document.querySelectorAll('.category-card').forEach(card => {
                    const cardHref = card.getAttribute('href');
                    if (!cardHref) return;

                    const cardUrl = new URL(cardHref, window.location.origin);
                    const cardCategoryId = cardUrl.searchParams.get('categoryId');

                    const isSelected = (!activeCategoryId && !cardCategoryId) || 
                                       (activeCategoryId && activeCategoryId === cardCategoryId);

                    if (isSelected) {
                        card.classList.add('border', 'border-2', 'border-primary');
                    } else {
                        card.classList.remove('border', 'border-2', 'border-primary');
                    }
                });
            }

            async function loadProducts(url) {
                if (!container) return;
                try {
                    container.style.opacity = '0.5';

                    const response = await fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) throw new Error('Помилка завантаження даних');

                    const html = await response.text();
                    container.innerHTML = html;

                    history.pushState(null, '', url);
                    updateCategoryHighlight(url);
                } catch (err) {
                    console.error('Помилка завантаження товарів:', err);
                } finally {
                    container.style.opacity = '1';
                }
            }

            function escapeRegExp(string) {
                return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }

            if (searchInput && suggestionsBox) {
                searchInput.addEventListener('input', (e) => {
                    clearTimeout(debounceTimer);
                    const query = e.target.value.trim();

                    if (query.length < 2) {
                        suggestionsBox.style.display = 'none';
                        suggestionsBox.innerHTML = '';
                        return;
                    }

                    debounceTimer = setTimeout(async () => {
                        try {
                            const response = await fetch(`/Home/AutoComplete?term=${encodeURIComponent(query)}`);
                            if (!response.ok) return;

                            const suggestions = await response.json();

                            if (!suggestions || suggestions.length === 0) {
                                suggestionsBox.style.display = 'none';
                                return;
                            }

                            const safeQuery = escapeRegExp(query);
                            const regex = new RegExp(`(${safeQuery})`, 'gi');

                            suggestionsBox.innerHTML = suggestions.map(item => {
                                const name = item.name || '';
                                const highlighted = name.replace(regex, '<mark>$1</mark>');
                                const displayPrice = item.hasActiveDiscount && item.discountedPrice ? item.discountedPrice : item.price;

                                return `
                                    <li data-id="${item.id}" data-value="${name}" class="d-flex align-items-center justify-content-between p-2">
                                        <span>${highlighted}</span>
                                        <small class="text-primary fw-bold ms-2">${displayPrice}</small>
                                    </li>`;
                            }).join('');

                            suggestionsBox.style.display = 'block';
                        } catch (err) {
                            console.error('Помилка автодоповнення:', err);
                        }
                    }, 250);
                });

                suggestionsBox.addEventListener('click', (e) => {
                    const item = e.target.closest('li');
                    if (item) {
                        const productId = item.dataset.id;
                        if (productId) {
                            window.location.href = `/Catalog/Details/${productId}`;
                        } else {
                            searchInput.value = item.dataset.value;
                            suggestionsBox.style.display = 'none';
                            searchInput.closest('form').submit();
                        }
                    }
                });

                document.addEventListener('click', (e) => {
                    if (!e.target.closest('.home-search')) {
                        suggestionsBox.style.display = 'none';
                    }
                });
            }

            document.addEventListener('click', (e) => {
                const link = e.target.closest('.category-card, .js-async-link');
                if (link && link.getAttribute('href') && !link.getAttribute('href').startsWith('#')) {
                    e.preventDefault();
                    loadProducts(link.href);
                }

                if (e.target.closest('.js-reset-filters')) {
                    e.preventDefault();
                    loadProducts('@Url.Action("Index", "Home")');
                }
            });

            document.addEventListener('change', (e) => {
                if (e.target.classList.contains('js-async-sort')) {
                    const form = e.target.closest('form');
                    const formData = new FormData(form);
                    const params = new URLSearchParams(formData).toString();
                    const url = `${window.location.pathname}?${params}`;

                    loadProducts(url);
                }
            });

            window.addEventListener('popstate', () => {
                loadProducts(window.location.href);
            });
        });
    </script>
}