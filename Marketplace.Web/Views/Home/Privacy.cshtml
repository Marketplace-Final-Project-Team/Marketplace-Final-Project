@{
    ViewData["Title"] = Localizer["Політика конфіденційності"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@Localizer["Політика конфіденційності"]</div>
        <h1>@Localizer["Як ми обробляємо ваші персональні дані"]</h1>
        <p>@Localizer["Ця політика пояснює, які дані MarketPlace збирає, для чого їх використовує, кому може передавати та як ви можете керувати своїми даними."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Загальні положення"]</h2>
        <p class="support-section__lead">
            @Localizer["Ця Політика конфіденційності регулює порядок збору, зберігання, використання та захисту персональних даних користувачів платформи MarketPlace («ми», «нас», «Платформа»). Реєструючись на Платформі або продовжуючи користуватися нею, ви підтверджуєте, що ознайомились з умовами цієї Політики та погоджуєтесь з ними."]
        </p>
        <p class="support-section__lead">
            @Localizer["Політика поширюється на всіх користувачів Платформи - покупців, продавців та відвідувачів, які переглядають каталог без реєстрації."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Які дані ми збираємо"]</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Категорія даних"]</th><th>@Localizer["Приклади"]</th><th>@Localizer["Джерело"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Реєстраційні дані"]</td>
                        <td>@Localizer["Ім'я користувача, електронна пошта, хеш пароля"]</td>
                        <td>@Localizer["Надаються вами під час реєстрації"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Контактні та адресні дані"]</td>
                        <td>@Localizer["Телефон, країна, місто, вулиця та номер будинку для доставки"]</td>
                        <td>@Localizer["Вводяться під час оформлення замовлення"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані про замовлення"]</td>
                        <td>@Localizer["Історія покупок, обраний спосіб доставки й оплати, статус замовлення"]</td>
                        <td>@Localizer["Формуються під час використання Платформи"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані продавця"]</td>
                        <td>@Localizer["Назва магазину, опис, логотип, банківські реквізити для виплат"]</td>
                        <td>@Localizer["Надаються під час створення бізнес-акаунту"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Технічні дані"]</td>
                        <td>@Localizer["IP-адреса, тип браузера, кукі-файли, журнали відвідувань"]</td>
                        <td>@Localizer["Збираються автоматично, докладніше - у"] <a asp-controller="Home" asp-action="CookiePolicy">@SharedLocalizer["Політика кукі"]</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Мета обробки даних"]</h2>
        <p class="support-section__lead">@Localizer["Ми обробляємо персональні дані виключно для таких цілей:"]</p>
        <ul>
            <li>@Localizer["створення та адміністрування вашого облікового запису;"]</li>
            <li>@Localizer["оформлення, обробка та доставка замовлень;"]</li>
            <li>@Localizer["обробка платежів і повернень коштів;"]</li>
            <li>@Localizer["зв'язок щодо статусу замовлення, підтримки чи зміни в акаунті;"]</li>
            <li>@Localizer["запобігання шахрайству та забезпечення безпеки Платформи;"]</li>
            <li>@Localizer["покращення роботи сайту на основі статистики використання;"]</li>
            <li>@Localizer["виконання вимог законодавства (податкова звітність, розгляд спорів)."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Кому ми передаємо дані"]</h2>
        <p class="support-section__lead">
            @Localizer["Ми не продаємо персональні дані третім особам. Обмежений обсяг даних може передаватися лише таким категоріям отримувачів і лише в обсязі, необхідному для виконання їхньої функції:"]
        </p>
        <ul>
            <li><strong>@Localizer["Продавцям"]</strong> - @Localizer["ім'я покупця, адреса доставки та склад замовлення, необхідні для його виконання;"]</li>
            <li><strong>@Localizer["Службам доставки"]</strong> @Localizer["(Нова пошта, Укрпошта, Meest Express) - контактні дані отримувача та адреса;"]</li>
            <li><strong>@Localizer["Платіжним провайдерам"]</strong> - @Localizer["дані, необхідні для проведення й підтвердження оплати;"]</li>
            <li><strong>@Localizer["Державним органам"]</strong> - @Localizer["виключно за законною вимогою відповідно до чинного законодавства."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Термін зберігання"]</h2>
        <p class="support-section__lead">
            @Localizer["Дані облікового запису зберігаються протягом усього періоду його існування. Дані про замовлення зберігаються не менше 3 років з моменту завершення замовлення для цілей бухгалтерського обліку та розгляду можливих спорів. Після видалення акаунту дані знеособлюються або видаляються протягом 30 днів, за винятком випадків, коли подальше зберігання вимагається законодавством."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Ваші права"]</h2>
        <p class="support-section__lead">@Localizer["Щодо своїх персональних даних ви маєте право:"]</p>
        <ul>
            <li>@Localizer["отримати доступ до даних, які ми про вас зберігаємо;"]</li>
            <li>@Localizer["вимагати виправлення неточних або неповних даних;"]</li>
            <li>@Localizer["вимагати видалення даних («право бути забутим»), якщо відсутні законні підстави для їх подальшого зберігання;"]</li>
            <li>@Localizer["відкликати згоду на обробку даних у будь-який момент;"]</li>
            <li>@Localizer["заперечити проти обробки даних для маркетингових цілей;"]</li>
            <li>@Localizer["отримати копію своїх даних у машиночитному форматі."]</li>
        </ul>
        <p class="support-section__lead">
            @Localizer["Для реалізації будь-якого з цих прав звертайтеся через сторінку"] <a asp-controller="Home" asp-action="Support">@Localizer["Підтримки"]</a>.
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Безпека даних"]</h2>
        <p class="support-section__lead">
            @Localizer["Паролі зберігаються виключно у вигляді криптографічних хешів і ніколи не зберігаються у відкритому вигляді. Доступ до персональних даних мають лише уповноважені співробітники, яким це необхідно для виконання службових обов'язків. З'єднання з Платформою захищене протоколом HTTPS."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Зміни до Політики"]</h2>
        <p class="support-section__lead">
            @Localizer["Ми можемо періодично оновлювати цю Політику. Про суттєві зміни ми повідомимо на цій сторінці із зазначенням дати останнього оновлення. Продовження використання Платформи після внесення змін означає вашу згоду з оновленою версією Політики."]
        </p>
    </section>
</div>
