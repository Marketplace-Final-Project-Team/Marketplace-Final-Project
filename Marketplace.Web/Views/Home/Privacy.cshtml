@{
    ViewData["Title"] = Localizer["Політика конфіденційності"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@Localizer["Політика конфіденційності"]</div>
        <h1>@Localizer["Як ми обробляємо ваші персональні дані"]</h1>
        <p>@Localizer["Ця політика пояснює, які дані MarketPlace збирає, для чого їх використовує, на якій підставі, кому може передавати, як довго зберігає та як ви можете керувати своїми даними."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року. Це перша опублікована версія Політики."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Загальні положення"]</h2>
        <p class="support-section__lead">
            @Localizer["Ця Політика конфіденційності (далі - «Політика») регулює порядок збору, зберігання, використання, передачі та захисту персональних даних користувачів платформи MarketPlace («ми», «нас», «Платформа»). Реєструючись на Платформі, оформлюючи замовлення або продовжуючи користуватися сайтом, ви підтверджуєте, що ознайомились з умовами цієї Політики та погоджуєтесь з ними."]
        </p>
        <p class="support-section__lead">
            @Localizer["Політика поширюється на всіх користувачів Платформи - покупців, продавців (власників і працівників бізнес-акаунтів) та відвідувачів, які переглядають каталог без реєстрації. Вона діє в межах, необхідних для функціонування Платформи, і не поширюється на сайти третіх осіб, посилання на які можуть траплятися в каталозі чи відгуках."]
        </p>
        <p class="support-section__lead">
            @Localizer["Розпорядником персональних даних є"] <strong>@Localizer["MarketPlace"]</strong> @Localizer["(реквізити юридичної особи публікуються в розділі «Контакти» цієї сторінки після завершення реєстрації суб'єкта господарювання). До моменту реєстрації запити щодо персональних даних приймаються на адресу, вказану в розділі 12."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Терміни та визначення"]</h2>
        <ul>
            <li><strong>@Localizer["Персональні дані"]</strong> - @Localizer["будь-яка інформація, що прямо чи опосередковано стосується фізичної особи, яку ідентифіковано або можна ідентифікувати;"]</li>
            <li><strong>@Localizer["Обробка"]</strong> - @Localizer["будь-яка дія з персональними даними: збір, реєстрація, зберігання, зміна, використання, передача, знеособлення чи видалення;"]</li>
            <li><strong>@Localizer["Користувач"]</strong> - @Localizer["будь-яка фізична особа, яка користується Платформою як покупець, продавець або відвідувач;"]</li>
            <li><strong>@Localizer["Бізнес-акаунт"]</strong> - @Localizer["обліковий запис продавця, створений для розміщення товарів і обробки замовлень;"]</li>
            <li><strong>@Localizer["Платформа"]</strong> - @Localizer["вебсайт і всі повʼязані сервіси MarketPlace."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Які дані ми збираємо"]</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Категорія даних"]</th><th>@Localizer["Приклади"]</th><th>@Localizer["Джерело"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Реєстраційні дані"]</td>
                        <td>@Localizer["Ім'я користувача, електронна пошта, хеш пароля"]</td>
                        <td>@Localizer["Надаються вами під час реєстрації"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Контактні та адресні дані"]</td>
                        <td>@Localizer["Телефон, країна, місто, вулиця та номер будинку для доставки"]</td>
                        <td>@Localizer["Вводяться під час оформлення замовлення чи в адресній книзі профілю"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані про замовлення"]</td>
                        <td>@Localizer["Історія покупок, обраний спосіб доставки й оплати, статус замовлення, заявки на повернення"]</td>
                        <td>@Localizer["Формуються під час використання Платформи"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані продавця"]</td>
                        <td>@Localizer["Назва магазину, опис, логотип, номер картки для виплат, склад команди магазину"]</td>
                        <td>@Localizer["Надаються під час створення та ведення бізнес-акаунту"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані про взаємодію з товарами"]</td>
                        <td>@Localizer["Нещодавно переглянуті товари, список бажань, збережені пошукові фільтри, відгуки та запитання до продавця"]</td>
                        <td>@Localizer["Формуються автоматично під час перегляду каталогу"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Комунікаційні дані"]</td>
                        <td>@Localizer["Зміст звернень до підтримки, листування щодо спорів і повернень"]</td>
                        <td>@Localizer["Надаються вами під час звернення"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Технічні дані"]</td>
                        <td>@Localizer["IP-адреса, тип браузера й пристрою, кукі-файли, журнали відвідувань"]</td>
                        <td>@Localizer["Збираються автоматично, докладніше - у"] <a asp-controller="Home" asp-action="CookiePolicy">@SharedLocalizer["Політика кукі"]</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="support-section__lead">
            @Localizer["Ми не збираємо дані про стан здоров'я, релігійні чи політичні переконання та інші «чутливі» категорії персональних даних і просимо не вказувати таку інформацію в текстах відгуків, запитань до продавця чи звернень у підтримку."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Правові підстави обробки"]</h2>
        <p class="support-section__lead">@Localizer["Залежно від категорії даних ми обробляємо їх на одній із таких підстав:"]</p>
        <ul>
            <li><strong>@Localizer["Виконання договору"]</strong> - @Localizer["дані, необхідні для реєстрації акаунту, оформлення й доставки замовлення, обробки оплати та повернень;"]</li>
            <li><strong>@Localizer["Згода"]</strong> - @Localizer["функціональні кукі, маркетингові розсилки та інші необов'язкові функції - ви можете відкликати згоду в будь-який момент;"]</li>
            <li><strong>@Localizer["Законний інтерес"]</strong> - @Localizer["запобігання шахрайству, забезпечення безпеки Платформи, покращення роботи сайту на основі знеособленої статистики;"]</li>
            <li><strong>@Localizer["Юридичний обов'язок"]</strong> - @Localizer["зберігання даних про фінансові операції для податкової звітності та розгляду законних запитів державних органів."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Мета обробки даних"]</h2>
        <p class="support-section__lead">@Localizer["Ми обробляємо персональні дані виключно для таких цілей:"]</p>
        <ul>
            <li>@Localizer["створення та адміністрування вашого облікового запису;"]</li>
            <li>@Localizer["оформлення, обробка та доставка замовлень;"]</li>
            <li>@Localizer["обробка платежів і повернень коштів;"]</li>
            <li>@Localizer["зв'язок щодо статусу замовлення, підтримки чи зміни в акаунті;"]</li>
            <li>@Localizer["показ товарів, релевантних вашим переглядам і історії покупок (без прийняття юридично значущих рішень на основі профілювання);"]</li>
            <li>@Localizer["запобігання шахрайству та забезпечення безпеки Платформи;"]</li>
            <li>@Localizer["покращення роботи сайту на основі знеособленої статистики використання;"]</li>
            <li>@Localizer["виконання вимог законодавства (податкова звітність, розгляд спорів, запити уповноважених органів)."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Автоматизована обробка"]</h2>
        <p class="support-section__lead">
            @Localizer["Платформа використовує прості автоматизовані механізми - сортування каталогу за популярністю, добірку «Нещодавно переглянуті», показ товарів тієї ж категорії у блоці «Схожі товари». Жоден із цих механізмів не ухвалює рішень, що мають для вас юридичні наслідки чи суттєво вас стосуються (наприклад, не впливає на можливість реєстрації, оформлення замовлення чи доступ до Платформи) - фінальний вибір завжди залишається за вами."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Кому ми передаємо дані"]</h2>
        <p class="support-section__lead">
            @Localizer["Ми не продаємо персональні дані третім особам. Обмежений обсяг даних може передаватися лише таким категоріям отримувачів і лише в обсязі, необхідному для виконання їхньої функції:"]
        </p>
        <ul>
            <li><strong>@Localizer["Продавцям"]</strong> - @Localizer["ім'я покупця, адреса доставки та склад замовлення, необхідні для його виконання;"]</li>
            <li><strong>@Localizer["Службам доставки"]</strong> @Localizer["(Нова пошта, Укрпошта, Meest Express) - контактні дані отримувача та адреса чи відділення;"]</li>
            <li><strong>@Localizer["Платіжному провайдеру"]</strong> @Localizer["(LiqPay) - дані, необхідні для проведення й підтвердження оплати та виплат продавцям;"]</li>
            <li><strong>@Localizer["Постачальникам інфраструктури"]</strong> - @Localizer["хостинг, сховище зображень товарів і база даних, які обробляють дані від нашого імені на підставі договору й лише за нашими інструкціями;"]</li>
            <li><strong>@Localizer["Державним органам"]</strong> - @Localizer["виключно за законною вимогою відповідно до чинного законодавства."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Міжнародна передача даних"]</h2>
        <p class="support-section__lead">
            @Localizer["Частина постачальників інфраструктури, якими ми користуємось (зокрема хостинг і сховище зображень товарів), може фізично розміщувати сервери за межами України. У таких випадках ми покладаємось на договірні гарантії постачальника щодо належного рівня захисту даних і передаємо лише мінімально необхідний обсяг інформації."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Термін зберігання"]</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Категорія даних"]</th><th>@Localizer["Строк зберігання"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Дані облікового запису"]</td>
                        <td>@Localizer["Протягом усього періоду існування акаунту"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані про замовлення та платежі"]</td>
                        <td>@Localizer["Не менше 3 років з моменту завершення замовлення (бухгалтерський облік, розгляд спорів)"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Звернення до підтримки"]</td>
                        <td>@Localizer["До 3 років з моменту закриття звернення"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Технічні журнали (IP-адреси, логи доступу)"]</td>
                        <td>@Localizer["До 12 місяців"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Дані видаленого акаунту"]</td>
                        <td>@Localizer["Знеособлюються або видаляються протягом 30 днів, окрім даних, збереження яких вимагає закон"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["10. Ваші права"]</h2>
        <p class="support-section__lead">@Localizer["Щодо своїх персональних даних ви маєте право:"]</p>
        <ul>
            <li>@Localizer["отримати доступ до даних, які ми про вас зберігаємо, та копію цих даних у машиночитному форматі;"]</li>
            <li>@Localizer["вимагати виправлення неточних або неповних даних;"]</li>
            <li>@Localizer["вимагати видалення даних («право бути забутим»), якщо відсутні законні підстави для їх подальшого зберігання;"]</li>
            <li>@Localizer["вимагати обмеження обробки в окремих випадках, передбачених законодавством;"]</li>
            <li>@Localizer["відкликати згоду на обробку даних у будь-який момент, без наслідків для раніше здійсненої обробки;"]</li>
            <li>@Localizer["заперечити проти обробки даних для маркетингових цілей;"]</li>
            <li>@Localizer["подати скаргу до уповноваженого органу з питань захисту персональних даних, якщо вважаєте, що ваші права порушено."]</li>
        </ul>
        <p class="support-section__lead">
            @Localizer["Для реалізації будь-якого з цих прав звертайтеся через сторінку"] <a asp-controller="Home" asp-action="Support">@Localizer["Підтримки"]</a>. @Localizer["Ми відповідаємо на запити щодо персональних даних не пізніше ніж протягом 30 календарних днів."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["11. Безпека даних"]</h2>
        <p class="support-section__lead">
            @Localizer["Паролі зберігаються виключно у вигляді криптографічних хешів (алгоритм PBKDF2 у складі ASP.NET Core Identity) і ніколи не зберігаються у відкритому вигляді. Доступ до персональних даних мають лише уповноважені співробітники, яким це необхідно для виконання службових обов'язків, за принципом мінімально необхідного доступу. З'єднання з Платформою захищене протоколом HTTPS, а форми на сайті захищені від підробки запитів (CSRF-токени)."]
        </p>
        <p class="support-section__lead">
            @Localizer["У разі виявлення інциденту, що загрожує безпеці персональних даних, ми повідомимо про нього постраждалих користувачів та, за потреби, уповноважений орган - у строки, передбачені законодавством."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["12. Діти та вікові обмеження"]</h2>
        <p class="support-section__lead">
            @Localizer["Платформа не призначена для осіб молодше 18 років, і ми свідомо не збираємо персональні дані дітей. Якщо вам стало відомо, що дитина надала нам свої дані без згоди батьків чи опікунів, повідомте про це через сторінку Підтримки - ми видалимо такі дані."]
        </p>
        <p class="support-section__lead">
            @Localizer["Окремо від віку реєстрації діє вікове підтвердження для перегляду товарів категорії 18+: підтвердження зберігається в технічному кукі-файлі протягом 30 днів і не повʼязується з обліковим записом."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["13. Маркетингові комунікації"]</h2>
        <p class="support-section__lead">
            @Localizer["Наразі Платформа не надсилає маркетингові розсилки електронною поштою. Якщо в майбутньому ми додамо таку функцію, вона буде доступна лише за вашою окремою згодою (opt-in) і з можливістю відписатися в один клік у кожному листі."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["14. Зміни до Політики"]</h2>
        <p class="support-section__lead">
            @Localizer["Ми можемо періодично оновлювати цю Політику. Про суттєві зміни ми повідомимо на цій сторінці із зазначенням дати останнього оновлення, а за наявності контактних даних - і особисто. Продовження використання Платформи після внесення змін означає вашу згоду з оновленою версією Політики."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["15. Контакти"]</h2>
        <p class="support-section__lead">
            @Localizer["З питань, пов'язаних з обробкою персональних даних, звертайтеся на"] <a href="mailto:privacy@marketplace.local">privacy@marketplace.local</a> @Localizer["або через сторінку"] <a asp-controller="Home" asp-action="Support">@Localizer["Підтримки"]</a>.
        </p>
    </section>
</div>
