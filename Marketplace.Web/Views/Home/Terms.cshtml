@{
    ViewData["Title"] = SharedLocalizer["Умови використання"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@SharedLocalizer["Умови використання"]</div>
        <h1>@Localizer["Правила користування платформою MarketPlace"]</h1>
        <p>@Localizer["Ці Умови регулюють відносини між MarketPlace, покупцями та продавцями, які реєструються й здійснюють операції на Платформі."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року. Це перша опублікована версія Умов."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Прийняття умов"]</h2>
        <p class="support-section__lead">
            @Localizer["Реєструючи обліковий запис або здійснюючи покупку без реєстрації, ви укладаєте угоду з MarketPlace і погоджуєтесь дотримуватись цих Умов використання, а також Політики конфіденційності та Політики кукі. Якщо ви не погоджуєтесь із будь-яким положенням, будь ласка, не використовуйте Платформу."]
        </p>
        <p class="support-section__lead">
            @Localizer["Ці Умови є повним текстом угоди між вами і MarketPlace щодо користування Платформою й замінюють собою будь-які попередні усні чи письмові домовленості з цього приводу."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Терміни та визначення"]</h2>
        <ul>
            <li><strong>@Localizer["Платформа"]</strong> - @Localizer["вебсайт MarketPlace і всі повʼязані сервіси;"]</li>
            <li><strong>@Localizer["Покупець"]</strong> - @Localizer["користувач, який переглядає каталог і/або оформлює замовлення;"]</li>
            <li><strong>@Localizer["Продавець"]</strong> - @Localizer["користувач, який керує бізнес-акаунтом і розміщує товари на продаж;"]</li>
            <li><strong>@Localizer["Товар"]</strong> - @Localizer["предмет, розміщений продавцем у каталозі Платформи;"]</li>
            <li><strong>@Localizer["Замовлення"]</strong> - @Localizer["оформлена покупцем заявка на купівлю одного чи кількох товарів;"]</li>
            <li><strong>@Localizer["Адміністрація"]</strong> - @Localizer["команда MarketPlace, що здійснює модерацію та підтримку Платформи."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Право на використання Платформи"]</h2>
        <ul>
            <li>@Localizer["Реєструватися та здійснювати покупки на Платформі можуть особи, яким виповнилося 18 років, або особи віком від 14 років за згодою батьків чи законних представників;"]</li>
            <li>@Localizer["Доступ до товарів категорії 18+ додатково вимагає окремого підтвердження повноліття безпосередньо в каталозі - незалежно від віку, вказаного під час реєстрації;"]</li>
            <li>@Localizer["Використовуючи Платформу від імені юридичної особи чи ФОП (наприклад, під час створення бізнес-акаунту), ви підтверджуєте наявність повноважень діяти від її імені."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Реєстрація облікового запису"]</h2>
        <ul>
            <li>@Localizer["Для оформлення замовлень і продажу товарів необхідна реєстрація з підтвердженням електронної пошти;"]</li>
            <li>@Localizer["Ви зобов'язані надавати достовірну інформацію про себе під час реєстрації та оновлювати її в разі зміни;"]</li>
            <li>@Localizer["Ви несете відповідальність за конфіденційність свого пароля та всі дії, вчинені під вашим обліковим записом;"]</li>
            <li>@Localizer["Про підозру на несанкціонований доступ до акаунту необхідно негайно повідомити підтримку та змінити пароль;"]</li>
            <li>@Localizer["Один користувач може мати лише один обліковий запис покупця, якщо інше не погоджено окремо з адміністрацією;"]</li>
            <li>@Localizer["MarketPlace залишає за собою право призупинити або заблокувати обліковий запис у разі порушення цих Умов, а також видалити акаунт на прохання користувача відповідно до Політики конфіденційності."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Купівля товарів"]</h2>
        <ul>
            <li>@Localizer["Ціни на товари вказані в гривнях і включають усі обов'язкові збори, якщо не зазначено інше;"]</li>
            <li>@Localizer["Картка товару, кількість на складі та ціна можуть змінюватися продавцем у будь-який момент до оформлення замовлення;"]</li>
            <li>@Localizer["Оформлення замовлення є пропозицією купівлі, яка вважається прийнятою після підтвердження продавцем; до цього моменту продавець може відхилити замовлення, наприклад, через відсутність товару;"]</li>
            <li>@Localizer["Замовлення проходить послідовні статуси: очікує підтвердження → підтверджено → відправлено → доставлено, а також може бути скасоване на будь-якому етапі до відправлення;"]</li>
            <li>@Localizer["Якщо замовлення містить товари від кількох продавців, кожен продавець обробляє й відправляє свою частину замовлення окремо."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Оплата та Захист покупця"]</h2>
        <ul>
            <li>@Localizer["Доступні способи оплати: онлайн-оплата карткою через платіжну систему LiqPay та оплата готівкою або карткою під час отримання;"]</li>
            <li>@Localizer["Під час онлайн-оплати кошти резервуються Платформою і не переказуються продавцю одразу;"]</li>
            <li>@Localizer["Переказ коштів продавцю відбувається лише після того, як покупець підтвердить отримання товару, або автоматично - після завершення 14-денного строку з моменту доставки, якщо претензій не було подано. Цей механізм називається «Захист покупця» і дає час перевірити товар до того, як гроші дійдуть до продавця;"]</li>
            <li>@Localizer["Для замовлень з оплатою при отриманні «Захист покупця» діє в частині можливості оформити повернення чи спір - деталі у Політиці повернення;"]</li>
            <li>@Localizer["У разі скасування замовлення до відправлення кошти повертаються покупцю в повному обсязі тим самим способом, яким було здійснено оплату."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Знижки та промокоди"]</h2>
        <ul>
            <li>@Localizer["Продавці можуть встановлювати знижки на рівні окремого товару, категорії або всього магазину, а також персональні знижки для конкретного покупця;"]</li>
            <li>@Localizer["Якщо до товару застосовується кілька видів знижок одночасно, використовується найбільша з них - знижки не підсумовуються;"]</li>
            <li>@Localizer["Промокоди діють у межах строку, вказаного продавцем, можуть бути одноразовими та застосовуються під час оформлення замовлення;"]</li>
            <li>@Localizer["MarketPlace залишає за собою право анулювати замовлення, оформлені з використанням промокодів, отриманих шляхом зловживання чи технічної помилки."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Права та обов'язки продавців"]</h2>
        <ul>
            <li>@Localizer["Продавець самостійно встановлює ціни, описи та фотографії своїх товарів і несе відповідальність за їх достовірність;"]</li>
            <li>@Localizer["Заборонено продавати контрафактну продукцію, товари, обіг яких обмежений законодавством, або товари, що вводять покупця в оману;"]</li>
            <li>@Localizer["Продавець зобов'язаний підтримувати актуальну інформацію про наявність товару на складі та оперативно обробляти замовлення;"]</li>
            <li>@Localizer["Продавець зобов'язаний оперативно реагувати на запити покупців щодо статусу замовлення, повернень і спорів;"]</li>
            <li>@Localizer["MarketPlace стягує комісію з кожного успішного продажу відповідно до тарифу, вказаного в кабінеті продавця (за замовчуванням - 20% від суми замовлення);"]</li>
            <li>@Localizer["Повний перелік вимог до продавців викладено в окремих"] <a asp-controller="Home" asp-action="SellerRules">@Localizer["Правилах для продавців"]</a>@Localizer[", які є невіддільною частиною цих Умов."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Товари категорії 18+"]</h2>
        <p class="support-section__lead">
            @Localizer["Окремі категорії товарів можуть містити контент, призначений виключно для повнолітніх. Такі товари позначаються міткою «18+», приховані від перегляду без підтвердження віку та доступні для продажу лише магазинам, чий статус 18+ підтверджено адміністрацією Платформи. Продовжуючи перегляд позначеного каталогу, ви підтверджуєте, що вам виповнилося 18 років."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["10. Відгуки та контент користувачів"]</h2>
        <ul>
            <li>@Localizer["Відгуки можуть залишати лише покупці, і вони мають ґрунтуватися на реальному досвіді використання товару чи взаємодії з продавцем;"]</li>
            <li>@Localizer["Розміщуючи відгук, фото, опис товару чи інший контент на Платформі, ви надаєте MarketPlace безоплатну, невиключну ліцензію на його показ і використання в межах роботи сервісу;"]</li>
            <li>@Localizer["Забороняється публікувати відгуки за винагороду, від імені інших осіб або створювати фейкові акаунти для накрутки рейтингу;"]</li>
            <li>@Localizer["Адміністрація має право видалити контент, що порушує ці Умови, законодавство чи права третіх осіб, без попереднього повідомлення."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["11. Заборонена поведінка"]</h2>
        <p class="support-section__lead">@Localizer["На Платформі заборонено:"]</p>
        <ul>
            <li>@Localizer["розміщувати неправдиву, образливу чи таку, що вводить в оману, інформацію;"]</li>
            <li>@Localizer["намагатись обійти механізми оплати чи комісії Платформи, домовляючись про пряму оплату поза сайтом;"]</li>
            <li>@Localizer["використовувати автоматизовані засоби (боти, скрапери) для масового збору даних із каталогу;"]</li>
            <li>@Localizer["публікувати відгуки за винагороду або створювати фейкові акаунти для накрутки рейтингу;"]</li>
            <li>@Localizer["видавати себе за іншу особу чи представника MarketPlace;"]</li>
            <li>@Localizer["намагатись порушити роботу Платформи (атаки типу «відмова в обслуговуванні», спроби несанкціонованого доступу тощо);"]</li>
            <li>@Localizer["здійснювати дії, що порушують чинне законодавство України."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["12. Інтелектуальна власність"]</h2>
        <p class="support-section__lead">
            @Localizer["Дизайн, логотип, програмний код та інші елементи Платформи є власністю MarketPlace і захищені законодавством про авторське право. Контент, який завантажують продавці (фото, описи товарів), залишається їхньою власністю, але, розміщуючи його на Платформі, продавець надає MarketPlace невиключну ліцензію на його використання для демонстрації товару в межах сервісу."]
        </p>
        <p class="support-section__lead">
            @Localizer["Якщо ви вважаєте, що розміщений на Платформі товар чи контент порушує ваші права інтелектуальної власності, надішліть звернення через сторінку Підтримки з описом порушення, посиланням на відповідний товар і підтвердженням ваших прав - ми розглянемо звернення та за наявності підстав приховаємо товар до з'ясування обставин."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["13. Обмеження відповідальності"]</h2>
        <p class="support-section__lead">
            @Localizer["MarketPlace виступає посередником між покупцями та продавцями і не є виробником або власником товарів, що продаються на Платформі. Відповідальність за якість, комплектність і відповідність товару опису несе продавець. Платформа надається «як є», без гарантій безперебійної чи безпомилкової роботи. MarketPlace не несе відповідальності за непрямі, випадкові чи наслідкові збитки, спричинені використанням Платформи, крім випадків, прямо передбачених законодавством."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["14. Форс-мажор"]</h2>
        <p class="support-section__lead">
            @Localizer["Жодна зі сторін не несе відповідальності за невиконання зобов'язань, спричинене обставинами непереборної сили: стихійне лихо, воєнні дії, дії органів влади, масштабні збої в роботі провайдерів зв'язку, енергопостачання чи платіжних систем, що перебувають поза розумним контролем сторони. Виконання зобов'язань відновлюється, щойно дія таких обставин припиняється."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["15. Врегулювання спорів"]</h2>
        <p class="support-section__lead">
            @Localizer["Спори щодо конкретного замовлення передусім вирішуються через інструмент «Відкрити спір» на сторінці замовлення за участю продавця та, за потреби, підтримки Платформи. Якщо спір не вдалося врегулювати таким чином, він підлягає вирішенню відповідно до законодавства України за місцем реєстрації MarketPlace."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["16. Загальні положення"]</h2>
        <ul>
            <li>@Localizer["Якщо будь-яке положення цих Умов буде визнано недійсним, це не впливає на чинність решти положень;"]</li>
            <li>@Localizer["MarketPlace може передавати свої права та обов'язки за цими Умовами повʼязаній особі в разі реорганізації бізнесу, повідомивши про це користувачів на цій сторінці;"]</li>
            <li>@Localizer["Неможливість негайної реалізації MarketPlace будь-якого права за цими Умовами не означає відмову від такого права в подальшому."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["17. Зміна умов"]</h2>
        <p class="support-section__lead">
            @Localizer["MarketPlace має право вносити зміни до цих Умов у будь-який час. Актуальна версія завжди доступна на цій сторінці з датою останнього оновлення. Продовження використання Платформи після публікації змін означає вашу згоду з оновленими Умовами."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["18. Контакти"]</h2>
        <p class="support-section__lead">
            @Localizer["З питань, пов'язаних із цими Умовами, звертайтеся на"] <a href="mailto:legal@marketplace.local">legal@marketplace.local</a> @Localizer["або через сторінку"] <a asp-controller="Home" asp-action="Support">@Localizer["Підтримки"]</a>.
        </p>
    </section>
</div>
