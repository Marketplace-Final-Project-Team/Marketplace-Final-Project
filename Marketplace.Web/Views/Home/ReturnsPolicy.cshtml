@{
    ViewData["Title"] = Localizer["Політика повернення та обміну"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@SharedLocalizer["Повернення та обмін"]</div>
        <h1>@Localizer["Як повернути товар або відкрити спір"]</h1>
        <p>@Localizer["Пояснюємо, коли можна повернути товар, як оформити заявку прямо в кабінеті замовлення та скільки часу займає розгляд."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Строк повернення"]</h2>
        <p class="support-section__lead">
            @Localizer["Ви можете оформити повернення товару належної якості протягом <strong>14 календарних днів</strong> з дати доставки замовлення - це період дії «Захисту покупця». Товар неналежної якості (пошкоджений, невідповідний опису) можна повернути в будь-який момент після виявлення проблеми через розділ «Відкрити спір»."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Як оформити повернення"]</h2>
        <p class="support-section__lead">@Localizer["Заявка подається прямо на сторінці деталей замовлення, без дзвінків чи листів:"]</p>
        <ul>
            <li>@Localizer["Відкрийте розділ"] <a asp-controller="Order" asp-action="Index">@Localizer["«Мої замовлення»"]</a> @Localizer["та оберіть потрібне замовлення зі статусом «Доставлено»;"]</li>
            <li>@Localizer["Натисніть кнопку «Оформити повернення» в блоці «Післяпродажний сервіс та безпека»;"]</li>
            <li>@Localizer["Оберіть причину повернення зі списку та за бажанням додайте коментар з деталями;"]</li>
            <li>@Localizer["Надішліть заявку - вона одразу зберігається і відображається у вас на сторінці замовлення;"]</li>
            <li>@Localizer["Очікуйте на зворотний зв'язок протягом 1–2 робочих днів."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Умови повернення товару належної якості"]</h2>
        <ul>
            <li>@Localizer["Товар не був у використанні, зберіг товарний вигляд, споживчі властивості, пломби та ярлики;"]</li>
            <li>@Localizer["Наявний документ, що підтверджує факт і умови купівлі (номер замовлення);"]</li>
            <li>@Localizer["Товар не входить до переліку, що не підлягає поверненню чи обміну (див. пункт 5)."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Повернення товару неналежної якості"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо товар пошкоджений, некомплектний або не відповідає опису в картці товару - скористайтесь кнопкою «Відкрити спір» на сторінці замовлення. Оберіть тип проблеми та опишіть ситуацію максимально детально. Команда підтримки маркетплейсу підключається до вирішення спору та зв'язується з вами протягом 24 годин. У такому разі повернення коштів або заміна товару відбувається за рахунок продавця, без додаткових витрат для покупця."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Товари, що не підлягають поверненню"]</h2>
        <ul>
            <li>@Localizer["товари особистої гігієни та нижня білизна;"]</li>
            <li>@Localizer["товари з порушеною заводською упаковкою, якщо цілісність упаковки впливає на можливість подальшого продажу;"]</li>
            <li>@Localizer["товари, виготовлені на замовлення покупця за індивідуальними характеристиками;"]</li>
            <li>@Localizer["харчові продукти та товари з обмеженим строком придатності."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Повернення коштів"]</h2>
        <p class="support-section__lead">
            @Localizer["Кошти повертаються тим самим способом, яким було здійснено оплату. Для оплати карткою онлайн повернення відбувається протягом 3–10 банківських днів після підтвердження повернення. Для замовлень з оплатою при отриманні кошти повертаються на вказані вами реквізити після узгодження з підтримкою."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Захист покупця"]</h2>
        <p class="support-section__lead">
            @Localizer["Кошти за будь-яке замовлення з онлайн-оплатою резервуються платформою і переказуються продавцю лише після того, як ви підтвердите отримання товару, або автоматично - після завершення 14-денного періоду без претензій. Це гарантує, що ви завжди маєте час перевірити товар і оформити повернення до того, як гроші дійдуть до продавця."]
        </p>
    </section>
</div>
