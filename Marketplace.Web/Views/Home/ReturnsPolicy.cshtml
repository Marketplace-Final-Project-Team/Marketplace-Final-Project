@{
    ViewData["Title"] = Localizer["Політика повернення та обміну"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@SharedLocalizer["Повернення та обмін"]</div>
        <h1>@Localizer["Як повернути товар або відкрити спір"]</h1>
        <p>@Localizer["Пояснюємо, коли можна повернути товар, як оформити заявку прямо в кабінеті замовлення та скільки часу займає розгляд."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Строк повернення"]</h2>
        <p class="support-section__lead">
            @Localizer["Ви можете оформити повернення товару належної якості протягом <strong>14 календарних днів</strong> з дати доставки замовлення - це період дії «Захисту покупця». Товар неналежної якості (пошкоджений, невідповідний опису, некомплектний) можна повернути в будь-який момент після виявлення проблеми через розділ «Відкрити спір»."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Як оформити повернення"]</h2>
        <p class="support-section__lead">@Localizer["Заявка подається прямо на сторінці деталей замовлення, без дзвінків чи листів:"]</p>
        <ul>
            <li>@Localizer["Відкрийте розділ"] <a asp-controller="Order" asp-action="Index">@Localizer["«Мої замовлення»"]</a> @Localizer["та оберіть потрібне замовлення зі статусом «Доставлено»;"]</li>
            <li>@Localizer["Натисніть кнопку «Оформити повернення» в блоці «Післяпродажний сервіс та безпека» біля конкретної позиції замовлення;"]</li>
            <li>@Localizer["Оберіть причину повернення зі списку та за бажанням додайте коментар з деталями й фото товару;"]</li>
            <li>@Localizer["Надішліть заявку - вона одразу отримує статус «Очікує розгляду» й відображається у вас на сторінці замовлення;"]</li>
            <li>@Localizer["Продавець розглядає заявку та ухвалює рішення - повернути кошти чи відхилити запит з поясненням причини;"]</li>
            <li>@Localizer["Очікуйте на зворотний зв'язок протягом 1–2 робочих днів; якщо продавець не реагує довше - звертайтесь у підтримку, і ми ескалюємо заявку."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Часткове повернення замовлення"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо замовлення містить кілька товарів, заявку на повернення можна оформити окремо по кожній позиції - немає потреби повертати все замовлення цілком, якщо проблема стосується лише одного товару. Кожна така заявка розглядається продавцем незалежно від інших позицій того самого замовлення."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Умови повернення товару належної якості"]</h2>
        <ul>
            <li>@Localizer["Товар не був у використанні, зберіг товарний вигляд, споживчі властивості, пломби та ярлики;"]</li>
            <li>@Localizer["Наявний документ, що підтверджує факт і умови купівлі (номер замовлення в акаунті достатньо - друкований чек не потрібен);"]</li>
            <li>@Localizer["Товар не входить до переліку, що не підлягає поверненню чи обміну (див. пункт 6)."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Повернення товару неналежної якості та спори"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо товар пошкоджений, некомплектний або не відповідає опису в картці товару - скористайтесь кнопкою «Відкрити спір» на сторінці замовлення. Оберіть тип проблеми та опишіть ситуацію максимально детально, додавши фото. Команда підтримки маркетплейсу підключається до вирішення спору та зв'язується з вами протягом 24 годин. У такому разі повернення коштів або заміна товару відбувається за рахунок продавця, без додаткових витрат для покупця."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Товари, що не підлягають поверненню"]</h2>
        <ul>
            <li>@Localizer["товари особистої гігієни та нижня білизна;"]</li>
            <li>@Localizer["товари з порушеною заводською упаковкою, якщо цілісність упаковки впливає на можливість подальшого продажу;"]</li>
            <li>@Localizer["товари, виготовлені на замовлення покупця за індивідуальними характеристиками;"]</li>
            <li>@Localizer["харчові продукти та товари з обмеженим строком придатності;"]</li>
            <li>@Localizer["активовані промокоди та інші цифрові товари, які неможливо «повернути на склад» після використання."]</li>
        </ul>
        <p class="support-section__lead">
            @Localizer["Цей перелік не поширюється на випадки, коли сам товар неналежної якості - у такому разі застосовується пункт 5, а не цей."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Хто оплачує зворотну доставку"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо ви повертаєте товар належної якості за власним бажанням (передумали, не підійшов розмір тощо) - вартість зворотної доставки покриває покупець. Якщо причиною повернення є брак, пошкодження чи невідповідність опису - зворотну доставку оплачує продавець."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Обмін товару"]</h2>
        <p class="support-section__lead">
            @Localizer["На поточному етапі Платформа підтримує повернення товару з поверненням коштів; прямий обмін на інший розмір чи модель не є окремою функцією. Якщо вам потрібен інший варіант товару - оформіть повернення коштів за поточну позицію та окреме нове замовлення на потрібний варіант."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Гарантія виробника"]</h2>
        <p class="support-section__lead">
            @Localizer["Наведені вище строки й умови стосуються права на повернення товару як такого. Якщо на товар поширюється гарантія виробника (зазначається в картці товару чи гарантійному талоні), вона діє незалежно від строку повернення на Платформі й реалізується безпосередньо через сервісні центри виробника чи продавця."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["10. Повернення коштів"]</h2>
        <p class="support-section__lead">
            @Localizer["Кошти повертаються тим самим способом, яким було здійснено оплату. Для оплати карткою онлайн через LiqPay повернення відбувається протягом 3–10 банківських днів після підтвердження повернення продавцем. Для замовлень з оплатою при отриманні кошти повертаються на реквізити, узгоджені з підтримкою під час розгляду заявки."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["11. Захист покупця"]</h2>
        <p class="support-section__lead">
            @Localizer["Кошти за будь-яке замовлення з онлайн-оплатою резервуються платформою і переказуються продавцю лише після того, як ви підтвердите отримання товару, або автоматично - після завершення 14-денного періоду без претензій. Це гарантує, що ви завжди маєте час перевірити товар і оформити повернення до того, як гроші дійдуть до продавця."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["12. Якщо спір не вдалося вирішити"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо продавець відхилив заявку на повернення, а ви вважаєте це рішення необґрунтованим, зверніться через сторінку"] <a asp-controller="Home" asp-action="Support">@Localizer["Підтримки"]</a> @Localizer["з номером замовлення - команда MarketPlace додатково розгляне ситуацію як незалежна сторона."]
        </p>
    </section>
</div>
