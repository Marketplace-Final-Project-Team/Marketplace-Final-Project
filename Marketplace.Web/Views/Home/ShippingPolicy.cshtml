@{
    ViewData["Title"] = Localizer["Політика доставки"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@Localizer["Доставка"]</div>
        <h1>@Localizer["Способи, строки та вартість доставки"]</h1>
        <p>@Localizer["Все, що потрібно знати про доставку замовлень: перевізники, орієнтовні строки, пакування та відстеження посилки."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Доступні способи доставки"]</h2>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Перевізник"]</th><th>@Localizer["Тип доставки"]</th><th>@Localizer["Орієнтовний строк"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Нова пошта"]</td>
                        <td>@Localizer["Відділення або поштомат"]</td>
                        <td>@Localizer["1–3 робочі дні"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Укрпошта"]</td>
                        <td>@Localizer["Кур'єрська доставка на вказану адресу"]</td>
                        <td>@Localizer["3–5 робочих днів"]</td>
                    </tr>
                    <tr>
                        <td>Meest Express</td>
                        <td>@Localizer["Кур'єрська доставка на вказану адресу"]</td>
                        <td>@Localizer["2–4 робочі дні"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="support-section__lead">
            @Localizer["Спосіб доставки обирається на кроці «Доставка» під час оформлення замовлення і зберігається окремо для кожного замовлення. Точні строки залежать від місцезнаходження продавця, обраного відділення та завантаженості перевізника у конкретний період."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Вартість доставки"]</h2>
        <p class="support-section__lead">
            @Localizer["Вартість доставки розраховується перевізником на основі ваги, габаритів посилки та відстані. Вона відображається на кроці «Огляд» перед підтвердженням замовлення - жодних прихованих доплат після оформлення. У межах промоакцій MarketPlace може пропонувати безкоштовну доставку - умови такої акції завжди вказуються окремо в каталозі та кошику."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Обробка та відправлення замовлення"]</h2>
        <ul>
            <li>@Localizer["Після оформлення замовлення продавець отримує сповіщення й зобов'язаний підтвердити наявність товару протягом 24 годин;"]</li>
            <li>@Localizer["Товар передається обраній службі доставки протягом 1–2 робочих днів з моменту підтвердження замовлення;"]</li>
            <li>@Localizer["Після відправлення статус замовлення змінюється на «Відправлено», і стає доступним номер для відстеження."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Замовлення від кількох продавців"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо ваше замовлення містить товари від різних продавців, кожен з них формує й відправляє свою частину окремою посилкою. Це означає, що товари можуть прибувати в різний час і з різними номерами для відстеження - статус кожної позиції видно окремо на сторінці замовлення."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Пакування"]</h2>
        <p class="support-section__lead">
            @Localizer["Продавці зобов'язані пакувати товари так, щоб забезпечити їх збереження під час транспортування, з урахуванням специфіки товару (крихкість, вологочутливість тощо). Замовлення, що містять товари категорії 18+, відправляються в нейтральному пакованні без позначок, що розкривають вміст посилки."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Відстеження замовлення"]</h2>
        <p class="support-section__lead">
            @Localizer["Актуальний статус доставки завжди доступний на сторінці замовлення в розділі «Відстежити доставку». Там відображається обраний перевізник, поточний статус («Очікує підтвердження», «Підтверджено», «Відправлено», «Доставлено») та адреса чи відділення отримання."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Зміна адреси після оформлення"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо потрібно змінити адресу чи відділення отримання вже після оформлення замовлення, зверніться до продавця чи в підтримку якомога швидше - зміна можлива, доки замовлення не передано службі доставки. Після відправлення зміна адреси залежить від правил конкретного перевізника."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Неотримана посилка"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо посилку не забрано з відділення чи не вручено кур'єром протягом строку зберігання, встановленого перевізником, вона повертається відправнику. У такому разі підтримка зв'яжеться з вами щодо повторної відправки (за додаткову оплату доставки) або оформлення повернення коштів за товар."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Якщо посилка затримується або загублена"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо строк доставки суттєво перевищено, а статус замовлення не оновлюється - скористайтесь кнопкою «Відкрити спір» на сторінці замовлення й оберіть причину «Товар не прийшов». Підтримка маркетплейсу зв'яжеться з перевізником і продавцем для з'ясування ситуації, а у разі підтвердженої втрати посилки покупцю повертаються повні кошти за замовлення."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["10. Форс-мажорні затримки"]</h2>
        <p class="support-section__lead">
            @Localizer["У періоди підвищеного навантаження на перевізників, під час погодних обмежень чи інших обставин поза контролем MarketPlace та продавців (зокрема повʼязаних із воєнним станом) орієнтовні строки доставки можуть збільшуватись. Ми рекомендуємо стежити за статусом відстеження та звертатись у підтримку, якщо затримка викликає занепокоєння."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["11. Ваші права при порушенні строків"]</h2>
        <p class="support-section__lead">
            @Localizer["Порушення заявлених строків доставки саме собою не позбавляє вас права на «Захист покупця» й повернення - 14-денний відлік починається з фактичної дати доставки, а не з дати оформлення замовлення. Детальніше про повернення коштів - у"] <a asp-controller="Home" asp-action="ReturnsPolicy">@Localizer["Політиці повернення та обміну"]</a>.
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["12. Міжнародна доставка"]</h2>
        <p class="support-section__lead">
            @Localizer["На поточному етапі MarketPlace обслуговує доставку виключно в межах України. Розширення на міжнародні напрямки планується в майбутніх оновленнях платформи."]
        </p>
    </section>
</div>
