@{
    ViewData["Title"] = Localizer["Політика використання кукі"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@SharedLocalizer["Політика кукі"]</div>
        <h1>@Localizer["Як ми використовуємо кукі-файли"]</h1>
        <p>@Localizer["Прозоро про те, які кукі ставить цей сайт, навіщо вони потрібні та скільки часу зберігаються."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["Обов'язкові кукі"]</h2>
        <p class="support-section__lead">@Localizer["Потрібні для роботи сайту - без них неможливо увійти в акаунт чи оформити замовлення. Їх не можна вимкнути."]</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Кукі"]</th><th>@Localizer["Призначення"]</th><th>@Localizer["Термін дії"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>.AspNetCore.Identity.Application</code></td>
                        <td>@Localizer["Зберігає ваш вхід в акаунт"]</td>
                        <td>@Localizer["До виходу з акаунту"]</td>
                    </tr>
                    <tr>
                        <td><code>.AspNetCore.Antiforgery.*</code></td>
                        <td>@Localizer["Захист форм від підробки запитів (CSRF)"]</td>
                        <td>@Localizer["Сесія"]</td>
                    </tr>
                    <tr>
                        <td><code>mp_cookie_consent</code></td>
                        <td>@Localizer["Запам'ятовує ваш вибір у цьому вікні (прийняти / відхилити)"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["Функціональні кукі"]</h2>
        <p class="support-section__lead">@Localizer["Вмикають додаткові зручності. Ставляться лише якщо ви натиснули «Прийняти» у вікні згоди - якщо відхилили, ці функції просто не використовують кукі."]</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Кукі"]</th><th>@Localizer["Призначення"]</th><th>@Localizer["Термін дії"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>mp_recently_viewed</code></td>
                        <td>@Localizer["Список ID нещодавно переглянутих товарів для блоку «Нещодавно переглянуті» на головній"]</td>
                        <td>@Localizer["15 хвилин"]</td>
                    </tr>
                    <tr>
                        <td><code>mp_order_delivery_*</code></td>
                        <td>@Localizer["Обраний спосіб доставки (Нова пошта / Укрпошта / Meest) для конкретного замовлення"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["Дані в локальному сховищі браузера"]</h2>
        <p class="support-section__lead">
            @Localizer["Це не кукі - вони не передаються на сервер - але для повноти картини: сайт також зберігає у <code>localStorage</code> вашого браузера деякі суто клієнтські налаштування (колекції списку бажань, збережені пошукові запити, локальні чернетки налаштувань магазину). Ці дані ніколи не покидають ваш пристрій."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["Керування вибором"]</h2>
        <p class="support-section__lead">
            @Localizer["Ви можете змінити свій вибір щодо функціональних кукі в будь-який момент."]
        </p>
        <button type="button" class="btn btn-outline-primary" data-reopen-cookie-consent>@Localizer["Змінити налаштування кукі"]</button>
    </section>
</div>
