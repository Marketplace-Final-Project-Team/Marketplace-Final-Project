@{
    ViewData["Title"] = Localizer["Політика використання кукі"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@SharedLocalizer["Політика кукі"]</div>
        <h1>@Localizer["Як ми використовуємо кукі-файли"]</h1>
        <p>@Localizer["Прозоро про те, які кукі та подібні технології ставить цей сайт, навіщо вони потрібні та скільки часу зберігаються."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Що таке кукі"]</h2>
        <p class="support-section__lead">
            @Localizer["Кукі - це невеликі текстові файли, які сайт зберігає у вашому браузері під час відвідування. Вони бувають «сесійними» (видаляються після закриття браузера) і «постійними» (зберігаються визначений термін), а також «першими» (встановлює сам сайт) і «сторонніми» (встановлює інший домен). Нижче ми пояснюємо, які саме кукі використовує MarketPlace, до якої категорії вони належать і як довго живуть."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Обов'язкові кукі"]</h2>
        <p class="support-section__lead">@Localizer["Потрібні для роботи сайту - без них неможливо увійти в акаунт, оформити замовлення чи скористатись віковим підтвердженням. Їх не можна вимкнути, оскільки вони не повʼязані з обробкою маркетингових чи аналітичних даних, а обслуговують базову функціональність і безпеку."]</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Кукі"]</th><th>@Localizer["Призначення"]</th><th>@Localizer["Термін дії"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>.AspNetCore.Identity.Application</code></td>
                        <td>@Localizer["Зберігає ваш вхід в акаунт"]</td>
                        <td>@Localizer["До виходу з акаунту"]</td>
                    </tr>
                    <tr>
                        <td><code>.AspNetCore.Antiforgery.*</code></td>
                        <td>@Localizer["Захист форм від підробки запитів (CSRF)"]</td>
                        <td>@Localizer["Сесія"]</td>
                    </tr>
                    <tr>
                        <td><code>mp_cookie_consent</code></td>
                        <td>@Localizer["Запам'ятовує ваш вибір у вікні згоди на кукі (прийняти / відхилити)"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                    <tr>
                        <td><code>AdultConfirmed</code></td>
                        <td>@Localizer["Підтвердження повноліття для перегляду товарів категорії 18+ - технічно необхідне для дотримання вікових обмежень"]</td>
                        <td>@Localizer["30 днів"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Функціональні кукі"]</h2>
        <p class="support-section__lead">@Localizer["Вмикають додаткові зручності. Ставляться лише якщо ви натиснули «Прийняти» у вікні згоди - якщо відхилили, ці функції просто не використовують кукі."]</p>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Кукі"]</th><th>@Localizer["Призначення"]</th><th>@Localizer["Термін дії"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>mp_recently_viewed</code></td>
                        <td>@Localizer["Список ID нещодавно переглянутих товарів для блоку «Нещодавно переглянуті» на головній"]</td>
                        <td>@Localizer["15 хвилин"]</td>
                    </tr>
                    <tr>
                        <td><code>mp_order_delivery_*</code></td>
                        <td>@Localizer["Обраний спосіб доставки (Нова пошта / Укрпошта / Meest) для конкретного замовлення"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                    <tr>
                        <td><code>mp_order_payment_*</code></td>
                        <td>@Localizer["Обраний спосіб оплати (онлайн / при отриманні) для конкретного замовлення"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                    <tr>
                        <td><code>.AspNetCore.Culture</code></td>
                        <td>@Localizer["Запам'ятовує обрану мову інтерфейсу"]</td>
                        <td>@Localizer["365 днів"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Аналітичні та рекламні кукі"]</h2>
        <p class="support-section__lead">
            @Localizer["Наразі MarketPlace не використовує аналітичні сервіси (на кшталт Google Analytics) чи рекламні мережі, а отже не встановлює жодних аналітичних або рекламних кукі та не показує персоналізовану рекламу на основі вашої поведінки на сайті. Якщо ситуація зміниться, ми оновимо цю Політику та запитаємо окрему згоду перед активацією таких кукі."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Сторонні кукі"]</h2>
        <p class="support-section__lead">
            @Localizer["Сам сайт MarketPlace не вбудовує сторонніх віджетів (соцмереж, чатів, реклами), які встановлюють кукі. Виняток - момент оплати: якщо ви обираєте онлайн-оплату, вас перенаправляє на захищену сторінку платіжної системи LiqPay, яка може встановлювати власні кукі відповідно до своєї політики конфіденційності, незалежної від MarketPlace."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Дані в локальному сховищі браузера"]</h2>
        <p class="support-section__lead">
            @Localizer["Це не кукі - вони не передаються на сервер автоматично з кожним запитом - але для повноти картини: сайт також зберігає у <code>localStorage</code> вашого браузера деякі суто клієнтські дані, наприклад підтвердження перегляду 18+ контенту на головній, збережені пошукові фільтри в каталозі та локальний чернетковий список запитань до продавця на сторінці товару. Ці дані ніколи не покидають ваш пристрій і не повʼязуються з вашим обліковим записом на сервері."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Як керувати кукі у браузері"]</h2>
        <p class="support-section__lead">@Localizer["Окрім налаштувань нижче, ви можете керувати кукі безпосередньо в браузері:"]</p>
        <ul>
            <li><strong>Google Chrome</strong> - @Localizer["Налаштування → Конфіденційність і безпека → Кукі та інші дані сайтів;"]</li>
            <li><strong>Mozilla Firefox</strong> - @Localizer["Налаштування → Приватність і захист → Кукі та дані сайтів;"]</li>
            <li><strong>Safari</strong> - @Localizer["Налаштування → Конфіденційність → Керувати даними сайтів;"]</li>
            <li><strong>Microsoft Edge</strong> - @Localizer["Налаштування → Конфіденційність, пошук і служби → Кукі та дозволи сайтів."]</li>
        </ul>
        <p class="support-section__lead">
            @Localizer["Зверніть увагу: вимкнення обов'язкових кукі на рівні браузера унеможливить вхід в акаунт і оформлення замовлень на Платформі."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Керування вибором"]</h2>
        <p class="support-section__lead">
            @Localizer["Ви можете змінити свій вибір щодо функціональних кукі на цьому сайті в будь-який момент."]
        </p>
        <button type="button" class="btn btn-outline-primary" data-reopen-cookie-consent>@Localizer["Змінити налаштування кукі"]</button>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Зміни до Політики"]</h2>
        <p class="support-section__lead">
            @Localizer["Якщо перелік використовуваних кукі зміниться - зокрема якщо ми додамо аналітичні чи рекламні кукі - ми оновимо цю сторінку із зазначенням дати останнього оновлення."]
        </p>
    </section>
</div>
