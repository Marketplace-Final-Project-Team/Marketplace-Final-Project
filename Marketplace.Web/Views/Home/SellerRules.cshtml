@{
    ViewData["Title"] = SharedLocalizer["Правила для продавців"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@Localizer["Для продавців"]</div>
        <h1>@Localizer["Правила роботи на маркетплейсі"]</h1>
        <p>@Localizer["Вимоги до магазинів, товарів та поведінки продавців, які дозволяють підтримувати якісний і безпечний каталог для всіх покупців."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Створення магазину"]</h2>
        <ul>
            <li>@Localizer["Створити бізнес-акаунт може будь-який зареєстрований і верифікований користувач через розділ «Створити бізнес»;"]</li>
            <li>@Localizer["Під час реєстрації магазину потрібно вказати назву, опис діяльності та контактні дані;"]</li>
            <li>@Localizer["Один користувач може керувати кількома магазинами, кожен з яких проходить окрему модерацію;"]</li>
            <li>@Localizer["Новий магазин перевіряється адміністрацією протягом 1–3 робочих днів перед публікацією."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Вимоги до карток товарів"]</h2>
        <ul>
            <li>@Localizer["Назва товару має точно відображати суть товару, без маніпулятивних чи оманливих формулювань;"]</li>
            <li>@Localizer["Опис повинен містити ключові характеристики: матеріал, розміри, комплектацію, особливості використання;"]</li>
            <li>@Localizer["Фотографії мають бути реальними зображеннями товару, що продається, без водяних знаків сторонніх сайтів;"]</li>
            <li>@Localizer["Ціна повинна включати всі обов'язкові платежі - прихована доплата під час оформлення заборонена;"]</li>
            <li>@Localizer["Кількість на складі повинна оновлюватись вчасно, щоб уникнути продажу товару, якого немає в наявності."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Категорії товарів"]</h2>
        <p class="support-section__lead">
            @Localizer["Кожен товар має бути розміщений у відповідній категорії каталогу. Розміщення товару в категорії, що не відповідає його суті, з метою підвищення видимості вважається порушенням і може призвести до зняття товару з публікації."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Обробка замовлень"]</h2>
        <ul>
            <li>@Localizer["Продавець зобов'язаний підтвердити або скасувати нове замовлення протягом 24 годин;"]</li>
            <li>@Localizer["Підтверджене замовлення повинно бути передане службі доставки протягом строку, вказаного в правилах доставки;"]</li>
            <li>@Localizer["У разі відсутності товару на складі продавець повинен негайно скасувати замовлення із зазначенням причини;"]</li>
            <li>@Localizer["Немотивоване скасування підтверджених замовлень враховується в рейтингу магазину."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Знижки та акції"]</h2>
        <p class="support-section__lead">
            @Localizer["Продавці можуть встановлювати тимчасові знижки на товари через кабінет продавця, вказуючи розмір знижки та період її дії. Заявлена початкова ціна повинна відповідати реальній ціні, за якою товар продавався до початку акції - штучне завищення ціни перед оголошенням «знижки» заборонено."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Робота зі спорами та поверненнями"]</h2>
        <ul>
            <li>@Localizer["Продавець зобов'язаний реагувати на заявки про повернення та спори, подані покупцями, протягом 2 робочих днів;"]</li>
            <li>@Localizer["У разі обґрунтованої претензії щодо якості товару продавець забезпечує повернення коштів або заміну за власний рахунок;"]</li>
            <li>@Localizer["Систематичне ігнорування заявок покупців або необґрунтовані відмови є підставою для розгляду адміністрацією та можливого блокування магазину."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Комісія та виплати"]</h2>
        <p class="support-section__lead">
            @Localizer["MarketPlace утримує комісію з кожного успішно завершеного замовлення відповідно до тарифного плану, зазначеного в кабінеті продавця. Кошти за замовлення надходять на баланс магазину після підтвердження отримання товару покупцем (для онлайн-оплати) або після позначки «Доставлено» кур'єром (для оплати при отриманні). Вивід коштів із балансу магазину доступний у розділі фінансової статистики."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Заборонені товари та дії"]</h2>
        <ul>
            <li>@Localizer["продаж контрафактної продукції, підробок брендових товарів;"]</li>
            <li>@Localizer["продаж товарів, обіг яких обмежено чи заборонено законодавством України;"]</li>
            <li>@Localizer["накрутка відгуків, штучне завищення рейтингу магазину чи товару;"]</li>
            <li>@Localizer["використання персональних даних покупців поза цілями виконання замовлення;"]</li>
            <li>@Localizer["спроби обійти комісію платформи шляхом домовленостей про оплату поза сайтом."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Наслідки порушень"]</h2>
        <p class="support-section__lead">
            @Localizer["Залежно від тяжкості порушення адміністрація може застосувати попередження, тимчасове зняття товару чи магазину з публікації, тимчасове блокування або остаточне видалення бізнес-акаунту без відшкодування коштів за нараховану, але не виведену комісію."]
        </p>
    </section>
</div>
