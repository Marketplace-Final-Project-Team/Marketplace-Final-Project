@{
    ViewData["Title"] = SharedLocalizer["Правила для продавців"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">@Localizer["Для продавців"]</div>
        <h1>@Localizer["Правила роботи на маркетплейсі"]</h1>
        <p>@Localizer["Вимоги до магазинів, товарів та поведінки продавців, які дозволяють підтримувати якісний і безпечний каталог для всіх покупців."]</p>
        <p class="support-hero__meta">@Localizer["Редакція від 16 вересня 2026 року. Ці Правила є невіддільною частиною Умов використання."]</p>
    </header>

    <section class="support-section">
        <h2>@Localizer["1. Створення магазину"]</h2>
        <ul>
            <li>@Localizer["Створити бізнес-акаунт може будь-який зареєстрований і верифікований користувач через розділ «Панель продавця» → «Створити бізнес»;"]</li>
            <li>@Localizer["Під час реєстрації магазину потрібно вказати назву, опис діяльності та контактні дані;"]</li>
            <li>@Localizer["Один користувач може керувати кількома магазинами, кожен з яких проходить окрему модерацію та має власний баланс і команду;"]</li>
            <li>@Localizer["Новий магазин перевіряється адміністрацією протягом 1–3 робочих днів перед публікацією в каталозі."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["2. Команда магазину"]</h2>
        <p class="support-section__lead">@Localizer["Власник магазину може запросити до співпраці інших користувачів і призначити їм одну з ролей:"]</p>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr><th>@Localizer["Роль"]</th><th>@Localizer["Доступ"]</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Localizer["Власник"]</td>
                        <td>@Localizer["Повний доступ, включно з налаштуваннями магазину, керуванням командою та виведенням коштів"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Адміністратор магазину"]</td>
                        <td>@Localizer["Товари, промокоди, статистика, керування командою - без доступу до налаштувань магазину"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Менеджер товарів"]</td>
                        <td>@Localizer["Додавання й редагування товарів, створення промокодів"]</td>
                    </tr>
                    <tr>
                        <td>@Localizer["Аналітик"]</td>
                        <td>@Localizer["Перегляд статистики продажів без права редагування"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="support-section__lead">
            @Localizer["Власник магазину несе відповідальність за дії всіх учасників команди в межах бізнес-акаунту."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["3. Вимоги до карток товарів"]</h2>
        <ul>
            <li>@Localizer["Назва товару має точно відображати суть товару, без маніпулятивних чи оманливих формулювань;"]</li>
            <li>@Localizer["Опис повинен містити ключові характеристики: матеріал, розміри, комплектацію, особливості використання;"]</li>
            <li>@Localizer["Фотографії мають бути реальними зображеннями товару, що продається, без водяних знаків сторонніх сайтів;"]</li>
            <li>@Localizer["Ціна повинна включати всі обов'язкові платежі - прихована доплата під час оформлення заборонена;"]</li>
            <li>@Localizer["Для товарів із варіантами (наприклад, розмірами одягу) необхідно вказувати залишок окремо по кожному варіанту;"]</li>
            <li>@Localizer["Кількість на складі повинна оновлюватись вчасно, щоб уникнути продажу товару, якого немає в наявності."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["4. Категорії товарів"]</h2>
        <p class="support-section__lead">
            @Localizer["Кожен товар має бути розміщений у відповідній категорії каталогу. Розміщення товару в категорії, що не відповідає його суті, з метою підвищення видимості вважається порушенням і може призвести до зняття товару з публікації. Перелік категорій визначається адміністрацією Платформи; пропозиції щодо нових категорій можна надсилати через підтримку."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["5. Товари категорії 18+"]</h2>
        <ul>
            <li>@Localizer["Продаж товарів, призначених виключно для повнолітніх, дозволений лише магазинам, статус 18+ яких підтверджено адміністрацією окремо від загальної модерації магазину;"]</li>
            <li>@Localizer["Такі товари додатково розміщуються в категоріях, позначених адміністрацією як 18+, і автоматично приховуються від покупців, які не підтвердили повноліття;"]</li>
            <li>@Localizer["Продавець зобов'язаний пакувати замовлення з товарами 18+ нейтрально, без зовнішніх позначок вмісту;"]</li>
            <li>@Localizer["Спроба розмістити товар 18+ поза відповідною категорією чи без підтвердженого статусу магазину є грубим порушенням і може призвести до негайного блокування магазину."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["6. Ціноутворення та знижки"]</h2>
        <p class="support-section__lead">
            @Localizer["Продавці можуть встановлювати тимчасові знижки на рівні товару, категорії свого магазину, усього магазину або персонально для окремого покупця, вказуючи розмір знижки та період її дії. Якщо до товару застосовується кілька знижок одночасно, діє найбільша з них - вони не підсумовуються. Заявлена початкова ціна повинна відповідати реальній ціні, за якою товар продавався до початку акції - штучне завищення ціни перед оголошенням «знижки» заборонено."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["7. Промокоди"]</h2>
        <ul>
            <li>@Localizer["Продавець може створювати промокоди зі знижкою у відсотках, строком дії та позначкою «одноразовий» у кабінеті продавця;"]</li>
            <li>@Localizer["Промокод діє лише в межах товарів того магазину, який його створив;"]</li>
            <li>@Localizer["Масове створення промокодів з метою обходу комісії платформи (наприклад, «знижка 99%» у парі з домовленістю про доплату поза сайтом) є порушенням цих Правил і Умов використання."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["8. Обробка замовлень"]</h2>
        <ul>
            <li>@Localizer["Продавець зобов'язаний підтвердити або скасувати нове замовлення протягом 24 годин;"]</li>
            <li>@Localizer["Підтверджене замовлення повинно бути передане службі доставки протягом строку, вказаного в"] <a asp-controller="Home" asp-action="ShippingPolicy">@Localizer["Політиці доставки"]</a>@Localizer[";"]</li>
            <li>@Localizer["У разі відсутності товару на складі продавець повинен негайно скасувати замовлення із зазначенням причини;"]</li>
            <li>@Localizer["Немотивоване скасування підтверджених замовлень враховується в рейтингу магазину."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["9. Управління залишками"]</h2>
        <p class="support-section__lead">
            @Localizer["Продавець самостійно відповідає за актуальність кількості товару на складі в кабінеті продавця. Платформа автоматично позначає товар як такий, що закінчується, коли залишок опускається нижче встановленого порогу, і приховує товар з каталогу, коли кількість досягає нуля. Систематичний продаж товару, якого немає в наявності, є підставою для попередження чи обмежень магазину."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["10. Комісія платформи"]</h2>
        <p class="support-section__lead">
            @Localizer["MarketPlace утримує комісію з кожного успішно завершеного замовлення. Стандартна комісія становить 20% від суми замовлення й відображається в кабінеті продавця для кожного конкретного магазину; адміністрація може встановити індивідуальний тариф для окремих магазинів чи категорій товарів. Комісія розраховується автоматично й утримується з суми, що зараховується на баланс магазину - додаткових рахунків продавцю не виставляється."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["11. Виплати коштів"]</h2>
        <ul>
            <li>@Localizer["Кошти за замовлення зараховуються на баланс магазину після підтвердження отримання товару покупцем (для онлайн-оплати) або після позначки «Доставлено» кур'єром (для оплати при отриманні) - за вирахуванням комісії платформи;"]</li>
            <li>@Localizer["Вивести кошти з балансу можна в розділі фінансів кабінету продавця, вказавши суму, номер картки та імʼя отримувача;"]</li>
            <li>@Localizer["Заявка на виведення коштів розглядається адміністрацією та проходить статуси «Очікує розгляду» → «В обробці» → «Виконано», або «Відхилено» з поясненням причини;"]</li>
            <li>@Localizer["Одночасно може бути активною лише одна заявка на суму, що не перевищує поточний баланс магазину за вирахуванням уже поданих заявок, що очікують розгляду."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["12. Податки та звітність"]</h2>
        <p class="support-section__lead">
            @Localizer["Продавець самостійно відповідає за дотримання податкового законодавства щодо доходів, отриманих від продажу товарів на Платформі, включно з реєстрацією як фізична особа-підприємець чи інша форма ведення діяльності, якщо це вимагається законодавством України. MarketPlace не є податковим агентом продавця, якщо інше прямо не погоджено окремим договором."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["13. Робота зі спорами та поверненнями"]</h2>
        <ul>
            <li>@Localizer["Продавець зобов'язаний реагувати на заявки про повернення та спори, подані покупцями, протягом 2 робочих днів;"]</li>
            <li>@Localizer["Заявки на повернення оформлюються окремо по кожній позиції замовлення - продавець розглядає й ухвалює рішення по кожній із них незалежно;"]</li>
            <li>@Localizer["У разі обґрунтованої претензії щодо якості товару продавець забезпечує повернення коштів за власний рахунок - відповідна сума списується з балансу магазину;"]</li>
            <li>@Localizer["Систематичне ігнорування заявок покупців або необґрунтовані відмови є підставою для розгляду адміністрацією та можливого блокування магазину."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["14. Заборонені товари та дії"]</h2>
        <ul>
            <li>@Localizer["продаж контрафактної продукції, підробок брендових товарів;"]</li>
            <li>@Localizer["продаж товарів, обіг яких обмежено чи заборонено законодавством України (зброя, наркотичні речовини, лікарські засоби рецептурного відпуску тощо);"]</li>
            <li>@Localizer["розміщення товарів категорії 18+ поза відповідною категорією чи без підтвердженого статусу магазину;"]</li>
            <li>@Localizer["накрутка відгуків, штучне завищення рейтингу магазину чи товару;"]</li>
            <li>@Localizer["використання персональних даних покупців поза цілями виконання замовлення;"]</li>
            <li>@Localizer["спроби обійти комісію платформи шляхом домовленостей про оплату поза сайтом."]</li>
        </ul>
    </section>

    <section class="support-section">
        <h2>@Localizer["15. Рейтинг та якість обслуговування"]</h2>
        <p class="support-section__lead">
            @Localizer["Адміністрація відстежує показники якості кожного магазину: частку скасованих замовлень, середній час підтвердження замовлення, частку обґрунтованих скарг і спорів, а також швидкість реакції на заявки покупців. Магазини зі стабільно низькими показниками отримують попередження й можуть бути тимчасово обмежені у видимості в каталозі до покращення показників."]
        </p>
    </section>

    <section class="support-section">
        <h2>@Localizer["16. Наслідки порушень"]</h2>
        <p class="support-section__lead">
            @Localizer["Залежно від тяжкості порушення адміністрація може застосувати попередження, тимчасове зняття товару чи магазину з публікації, тимчасове блокування або остаточне видалення бізнес-акаунту без відшкодування коштів за нараховану, але не виведену комісію. Продавець має право оскаржити рішення адміністрації протягом 14 днів через сторінку Підтримки, надавши додаткові пояснення чи докази."]
        </p>
    </section>
</div>
