@model Marketplace.Web.Models.SupportPageViewModel
@{
    ViewData["Title"] = "Підтримка";
}

@section Styles {
    <link rel="stylesheet" href="~/css/support.css" asp-append-version="true" />
}

<div class="support-page">
    <header class="support-hero">
        <div class="support-kicker">Підтримка</div>
        <h1>Чим можемо допомогти?</h1>
        <p>Відповіді на часті запитання, контакти та центр вирішення спірних питань - в одному місці.</p>
    </header>

    <div class="support-contacts">
        <div class="support-contact-card">
            <span class="support-contact-card__icon" aria-hidden="true">✉</span>
            <div>
                <strong>Email підтримки</strong>
                <span>support@marketplace.local</span>
            </div>
        </div>
        <div class="support-contact-card">
            <span class="support-contact-card__icon" aria-hidden="true">☎</span>
            <div>
                <strong>Телефон</strong>
                <span>0 800 123 456 (щодня, 9:00–20:00)</span>
            </div>
        </div>
        <button type="button" class="support-contact-card support-contact-card--action" data-open-chat-stub>
            <span class="support-contact-card__icon" aria-hidden="true">💬</span>
            <div>
                <strong>Онлайн-чат</strong>
                <span>Напишіть команді підтримки напряму</span>
            </div>
        </button>
    </div>

    <section class="support-section">
        <h2>Часті запитання</h2>
        <div class="support-faq" data-faq>
            <div class="support-faq-item">
                <button type="button" class="support-faq-item__question" aria-expanded="false">
                    Як оформити повернення товару?
                    <span aria-hidden="true">+</span>
                </button>
                <div class="support-faq-item__answer" hidden>
                    <p>Повернення доступне протягом 14 днів після отримання замовлення. Відкрийте деталі замовлення в особистому кабінеті та натисніть «Оформити повернення» - далі просто дотримуйтесь інструкцій.</p>
                </div>
            </div>
            <div class="support-faq-item">
                <button type="button" class="support-faq-item__question" aria-expanded="false">
                    Як довго обробляється замовлення?
                    <span aria-hidden="true">+</span>
                </button>
                <div class="support-faq-item__answer" hidden>
                    <p>Продавець підтверджує замовлення протягом 1 робочого дня, після чого починається доставка кур'єром - орієнтовно 2–4 робочі дні.</p>
                </div>
            </div>
            <div class="support-faq-item">
                <button type="button" class="support-faq-item__question" aria-expanded="false">
                    Які способи оплати підтримуються?
                    <span aria-hidden="true">+</span>
                </button>
                <div class="support-faq-item__answer" hidden>
                    <p>Наразі доступна онлайн-оплата через LiqPay. Ми працюємо над додаванням Apple Pay, Google Pay та оплати частинами.</p>
                </div>
            </div>
            <div class="support-faq-item">
                <button type="button" class="support-faq-item__question" aria-expanded="false">
                    Що робити, якщо товар не відповідає опису?
                    <span aria-hidden="true">+</span>
                </button>
                <div class="support-faq-item__answer" hidden>
                    <p>Кошти покупця заморожуються на транзитному рахунку маркетплейсу до підтвердження отримання. Якщо товар не відповідає опису - відкрийте спір у деталях замовлення, і команда підтримки допоможе вирішити ситуацію.</p>
                </div>
            </div>
            <div class="support-faq-item">
                <button type="button" class="support-faq-item__question" aria-expanded="false">
                    Як стати продавцем на платформі?
                    <span aria-hidden="true">+</span>
                </button>
                <div class="support-faq-item__answer" hidden>
                    <p>Створіть бізнес-акаунт у розділі «Панель продавця» → «Створити бізнес». Після модерації адміністратором ви зможете додавати товари та отримувати замовлення.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="support-chat-stub" data-chat-stub hidden>
        <div class="support-chat-stub__card">
            <button type="button" class="support-chat-stub__close" aria-label="Закрити" data-close-chat-stub>×</button>

            @if (!Model.IsAuthenticated)
            {
                <span class="support-chat-stub__icon" aria-hidden="true">🔒</span>
                <h3>Потрібно увійти в акаунт</h3>
                <p>Щоб написати в чат підтримки, спочатку <a asp-controller="Account" asp-action="Login">увійдіть в акаунт</a>.</p>
            }
            else if (Model.ActiveTicket is null)
            {
                <span class="support-chat-stub__icon" aria-hidden="true">💬</span>
                <h3>Напишіть нам</h3>

                <div data-ticket-form>
                    <label class="form-label mt-2">Тема звернення</label>
                    <select class="form-select" data-ticket-category>
                        <option value="">Оберіть тему</option>
                        <option>Проблема з оплатою</option>
                        <option>Питання щодо доставки</option>
                        <option>Проблема з товаром</option>
                        <option>Питання щодо акаунту</option>
                        <option>Інше</option>
                    </select>

                    <label class="form-label mt-3">Опишіть ситуацію</label>
                    <textarea class="form-control" rows="3" minlength="10" placeholder="Розкажіть детальніше..." data-ticket-message></textarea>

                    <button type="button" class="btn btn-primary mt-3 w-100" data-ticket-submit>Надіслати заявку</button>
                </div>

                <div data-ticket-pending hidden style="text-align:center;padding:1rem;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <h4 class="mt-3">Заявку надіслано!</h4>
                    <p class="text-muted">Очікуйте на відповідь адміністратора.</p>
                </div>
            }
            else if (Model.ActiveTicket.Status == Marketplace.Domain.Enums.SupportTicketStatus.Pending)
            {
                <span class="support-chat-stub__icon" aria-hidden="true">⏳</span>
                <h3>Очікуйте на відповідь</h3>
                <p class="text-muted">Тема: @Model.ActiveTicket.Category</p>
                <p>Ваше звернення вже надіслано. Адміністратор скоро з вами зв'яжеться.</p>
                <div data-ticket-poll="@Model.ActiveTicket.Id" hidden></div>
            }
            else
            {
                <span class="support-chat-stub__icon" aria-hidden="true">💬</span>
                <h3>Чат відкрито</h3>
                <p class="text-muted">Тема: @Model.ActiveTicket.Category</p>
                <a asp-controller="Support" asp-action="TicketChat" asp-route-ticketId="@Model.ActiveTicket.Id" class="btn btn-primary w-100 position-relative">
                    Повернутися в чат
                    @if (Model.ActiveTicket.UnreadForAdmin > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@Model.ActiveTicket.UnreadForAdmin</span>
                    }
                </a>
            }
        </div>
    </div>
</div>

@if (Model.IsAuthenticated)
{
    <form id="antiforgeryHolder" style="display:none">@Html.AntiForgeryToken()</form>
}

@section Scripts {
    <script src="~/js/support.js" asp-append-version="true"></script>
}