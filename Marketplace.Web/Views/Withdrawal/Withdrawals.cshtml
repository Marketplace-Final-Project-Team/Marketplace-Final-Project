@model Marketplace.Web.Models.WithdrawalsAdminViewModel

@{
    ViewData["Title"] = Localizer["Виплати - Адмін-панель"].Value;
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.WithdrawalStatus status) => status switch
    {
        Marketplace.Domain.Enums.WithdrawalStatus.Pending => Localizer["Очікує розгляду"].Value,
        Marketplace.Domain.Enums.WithdrawalStatus.Processing => Localizer["В обробці"].Value,
        Marketplace.Domain.Enums.WithdrawalStatus.Rejected => Localizer["Відхилено"].Value,
        Marketplace.Domain.Enums.WithdrawalStatus.Completed => Localizer["Виплачено"].Value,
        Marketplace.Domain.Enums.WithdrawalStatus.Failed => Localizer["Помилка виплати"].Value,
        _ => status.ToString()
    };

    private static string StatusModifier(Marketplace.Domain.Enums.WithdrawalStatus status) => status switch
    {
        Marketplace.Domain.Enums.WithdrawalStatus.Pending => "pending",
        Marketplace.Domain.Enums.WithdrawalStatus.Processing => "processing",
        Marketplace.Domain.Enums.WithdrawalStatus.Rejected => "rejected",
        Marketplace.Domain.Enums.WithdrawalStatus.Completed => "completed",
        Marketplace.Domain.Enums.WithdrawalStatus.Failed => "failed",
        _ => "pending"
    };

    private static string MaskCard(string cardNumber) => cardNumber.Length >= 4
        ? $"•••• {cardNumber[^4..]}"
        : cardNumber;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="~/Views/Admin/_AdminNav.cshtml" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Виплати"]</h1>
                    <p class="admin-subtitle">@Localizer["Заявки продавців на виведення коштів з балансу магазину на картку."]</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            @{
                var pendingRequests = Model.Withdrawals
                    .Where(w => w.Status == Marketplace.Domain.Enums.WithdrawalStatus.Pending.ToString())
                    .ToList();
                var resolvedRequests = Model.Withdrawals
                    .Where(w => w.Status != Marketplace.Domain.Enums.WithdrawalStatus.Pending.ToString())
                    .OrderByDescending(w => w.CreatedAt)
                    .ToList();
                var pendingSum = pendingRequests.Sum(w => w.Amount);
                var completedSum = resolvedRequests
                    .Where(w => w.Status == Marketplace.Domain.Enums.WithdrawalStatus.Completed.ToString())
                    .Sum(w => w.Amount);
            }

            <div class="admin-kpi-row">
                <div class="admin-kpi">
                    <span>@Localizer["Очікують дій"]</span>
                    <strong>@pendingRequests.Count</strong>
                </div>
                <div class="admin-kpi">
                    <span>@Localizer["Сума в очікуванні"]</span>
                    <strong>@pendingSum.ToString("N0") ₴</strong>
                </div>
                <div class="admin-kpi">
                    <span>@Localizer["Виплачено (у перегляді)"]</span>
                    <strong>@completedSum.ToString("N0") ₴</strong>
                </div>
                <div class="admin-kpi">
                    <span>@Localizer["Усього заявок"]</span>
                    <strong>@Model.Withdrawals.Count</strong>
                </div>
            </div>

            <div class="admin-pill-filter" role="tablist" aria-label="@Localizer["Фільтр за статусом"]">
                <a asp-action="Withdrawals" class="admin-pill-filter__btn @(!Model.StatusFilter.HasValue ? "is-active" : "")" role="tab" aria-selected="@(!Model.StatusFilter.HasValue)">
                    @Localizer["Усі статуси"]
                </a>
                @foreach (var value in Enum.GetValues<Marketplace.Domain.Enums.WithdrawalStatus>())
                {
                    <a asp-action="Withdrawals" asp-route-status="@value" class="admin-pill-filter__btn @(Model.StatusFilter == value ? "is-active" : "")" role="tab" aria-selected="@(Model.StatusFilter == value)">
                        @StatusLabel(value)
                    </a>
                }
            </div>

            <section class="admin-panel admin-panel--flat mb-3">
                <h2>@(Model.StatusFilter.HasValue ? StatusLabel(Model.StatusFilter.Value) : Localizer["Усі заявки"].Value)</h2>
                <p>@Localizer["Розгляньте та підтвердіть або відхиліть запити продавців на виведення коштів."]</p>

                @if (Model.Withdrawals.Count == 0)
                {
                    <p class="admin-empty" style="padding: 1.5rem 0;">@Localizer["Заявок за цим фільтром немає."]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table admin-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Магазин"]</th>
                                    <th>@Localizer["Сума"]</th>
                                    <th>@Localizer["Картка"]</th>
                                    <th>@Localizer["Отримувач"]</th>
                                    <th>@Localizer["Створено"]</th>
                                    <th>@Localizer["Статус"]</th>
                                    <th class="text-end">@Localizer["Дії"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.Withdrawals)
                                {
                                    var rowStatus = Enum.Parse<Marketplace.Domain.Enums.WithdrawalStatus>(request.Status);
                                    <tr>
                                        <td>
                                            <div class="admin-entity-cell">
                                                <span class="admin-entity-placeholder" aria-hidden="true">@request.BusinessName[..1].ToUpperInvariant()</span>
                                                <span class="admin-entity-name">@request.BusinessName</span>
                                            </div>
                                        </td>
                                        <td><span class="admin-amount">@request.Amount.ToString("N2") ₴</span></td>
                                        <td>
                                            <span class="admin-card-chip">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                                    <rect x="2" y="5" width="20" height="14" rx="2" />
                                                    <path d="M2 10h20" />
                                                </svg>
                                                @MaskCard(request.CardNumber)
                                            </span>
                                        </td>
                                        <td class="admin-entity-meta">@request.RecipientName</td>
                                        <td class="admin-entity-meta">@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <span class="admin-status admin-status--@StatusModifier(rowStatus)">@StatusLabel(rowStatus)</span>
                                            @if (!string.IsNullOrWhiteSpace(request.Message))
                                            {
                                                <div class="admin-status-note">@request.Message</div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (rowStatus == Marketplace.Domain.Enums.WithdrawalStatus.Pending)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#withdrawalModal-@request.Id">
                                                    @Localizer["Детальніше"]
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @foreach (var request in pendingRequests)
            {
                <div class="modal fade" id="withdrawalModal-@request.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@Localizer["Заявка на виплату"]</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Закрити"]"></button>
                            </div>
                            <div class="modal-body">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <span class="admin-entity-placeholder" aria-hidden="true">@request.BusinessName[..1].ToUpperInvariant()</span>
                                    <div>
                                        <strong>@request.BusinessName</strong>
                                        <div class="text-muted small">@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                    </div>
                                </div>

                                <p class="mb-1"><strong>@Localizer["Сума:"]</strong> @request.Amount.ToString("N2") ₴</p>
                                <p class="mb-1"><strong>@Localizer["Картка:"]</strong> @MaskCard(request.CardNumber)</p>
                                <p class="mb-1"><strong>@Localizer["Отримувач:"]</strong> @request.RecipientName</p>

                                <hr />
                                <div id="withdrawalRejectForm-@request.Id" class="collapse">
                                    <form asp-action="RejectWithdrawal" method="post">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <label class="form-label small">@Localizer["Причина відхилення"]</label>
                                        <textarea name="reason" class="form-control mb-2" rows="2" required minlength="5" placeholder="@Localizer["Поясніть продавцю, чому заявку відхилено..."]"></textarea>
                                        <button type="submit" class="btn btn-danger btn-sm w-100">@Localizer["Підтвердити відхилення"]</button>
                                    </form>
                                </div>
                                <div id="withdrawalApproveConfirm-@request.Id" class="collapse">
                                    <div class="alert alert-success mb-2">
                                        @Localizer["Ви точно впевнені, що хочете виплатити"] <strong>@request.Amount.ToString("N2") ₴</strong> @Localizer["на картку"] <strong>@MaskCard(request.CardNumber)</strong>?
                                    </div>
                                    <form asp-action="ApproveWithdrawal" method="post">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <button type="submit" class="btn btn-success btn-sm w-100">@Localizer["Так, виплатити"]</button>
                                    </form>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#withdrawalRejectForm-@request.Id">
                                    @Localizer["Відхилити"]
                                </button>

                                <button type="button" class="btn btn-outline-success" data-bs-toggle="collapse" data-bs-target="#withdrawalApproveConfirm-@request.Id">
                                    @Localizer["Виплатити"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>