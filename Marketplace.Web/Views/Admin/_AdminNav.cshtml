@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string ActiveClass(string action) => string.Equals(current, action, StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;

    var fullName = User.Identity?.Name ?? "Admin";
    var shortName = fullName.Contains('@') ? fullName.Split('@', 2)[0] : fullName;
    shortName = shortName.Length > 18 ? $"{shortName[..18]}…" : shortName;
    var initial = string.IsNullOrWhiteSpace(shortName) ? "A" : shortName[..1].ToUpperInvariant();
}

<aside class="admin-sidebar" aria-label="@Localizer["Розділи адмін-панелі"]">
    <div class="admin-sidebar__brand">
        <span class="admin-sidebar__brand-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                <path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </span>
        <div>
            <strong>LUNEXA</strong>
            <span>@SharedLocalizer["Адмін-панель"]</span>
        </div>
    </div>

    <nav class="admin-sidebar__nav">
        <a class="admin-sidebar__link @ActiveClass("Index")" asp-controller="Admin" asp-action="Index">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                </svg>
            </span>
            <span>@Localizer["Дашборд"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Users")" asp-controller="Admin" asp-action="Users">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            <span>@Localizer["Користувачі"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Products")" asp-controller="Admin" asp-action="Products">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                    <path d="M3 8v8l9 5 9-5V8" />
                    <path d="M12 13v8" />
                </svg>
            </span>
            <span>@Localizer["Товари"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Reviews")" asp-controller="Admin" asp-action="Reviews">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z" />
                    <path d="M8 9h8" />
                    <path d="M8 13h5" />
                </svg>
            </span>
            <span>@Localizer["Відгуки"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Categories")" asp-controller="Admin" asp-action="Categories">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M4 5h16v14H4z" />
                    <path d="M4 10h16" />
                    <path d="M9 5v14" />
                </svg>
            </span>
            <span>@SharedLocalizer["Категорії"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Businesses")" asp-controller="Admin" asp-action="Businesses">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M3 9 4 4h16l1 5" />
                    <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                    <path d="M4 9v10h16V9" />
                    <path d="M9 21v-6h6v6" />
                </svg>
            </span>
            <span>@Localizer["Бізнеси"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Statistics")" asp-controller="Admin" asp-action="Statistics">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M3 3v18h18" />
                    <path d="M7 16v-4" />
                    <path d="M12 16V8" />
                    <path d="M17 16v-7" />
                </svg>
            </span>
            <span>@Localizer["Статистика"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Jobs")" asp-controller="Admin" asp-action="Jobs">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3.5 2" />
                </svg>
            </span>
            <span>@Localizer["Задачі"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("Withdrawals")" asp-controller="Withdrawal" asp-action="Withdrawals">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <rect x="2" y="5" width="20" height="14" rx="2" />
                    <path d="M2 10h20" />
                    <path d="M6 15h4" />
                </svg>
            </span>
            <span>@Localizer["Виплати"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("AdminRefundsInbox")" asp-controller="Support" asp-action="AdminRefundsInbox">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </span>
            <span>@Localizer["Чати повернень"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("BusinessLimits")" asp-controller="Admin" asp-action="BusinessLimits">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M12 3v18" />
                    <path d="M5 8h5.5a2.5 2.5 0 0 1 0 5H8a2.5 2.5 0 0 0 0 5h6" />
                </svg>
            </span>
            <span>@Localizer["Ліміти бізнесу"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("MarketplaceBalance")" asp-controller="Admin" asp-action="MarketplaceBalance">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M12 1v22" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </span>
            <span>@Localizer["Баланс LUNEXA"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("UserActivityLog")" asp-controller="Admin" asp-action="UserActivityLog">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M4 4h16v16H4z" />
                    <path d="M8 9h8" />
                    <path d="M8 13h8" />
                    <path d="M8 17h5" />
                </svg>
            </span>
            <span>@Localizer["Журнал користувачів"]</span>
        </a>
        <a class="admin-sidebar__link @ActiveClass("BusinessActivityLog")" asp-controller="Admin" asp-action="BusinessActivityLog">
            <span class="admin-sidebar__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="19" height="19">
                    <path d="M4 4h16v16H4z" />
                    <path d="M8 9h8" />
                    <path d="M8 13h8" />
                    <path d="M8 17h5" />
                </svg>
            </span>
            <span>@Localizer["Журнал бізнесів"]</span>
        </a>
    </nav>

    <div class="admin-sidebar__footer">
        <div class="admin-sidebar__user">
            <span class="admin-sidebar__user-avatar" aria-hidden="true">@initial</span>
            <div>
                <strong title="@fullName">@shortName</strong>
                <span>@Localizer["Адміністратор"]</span>
            </div>
        </div>
        <a class="admin-sidebar__back" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
            </svg>
            @Localizer["На сайт"]
        </a>
    </div>
</aside>
