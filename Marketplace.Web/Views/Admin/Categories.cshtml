@model IReadOnlyList<Marketplace.BLL.DTOs.CategoryDto>

@{
    ViewData["Title"] = $"{SharedLocalizer["Категорії"].Value} - {SharedLocalizer["Адмін-панель"].Value}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@SharedLocalizer["Категорії"]</h1>
                    <p class="admin-subtitle">@Localizer["Категорії товарів у каталозі: усього"] <strong>@Model.Count</strong>.</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <div class="admin-panel" style="padding: 1.1rem 1.25rem; margin-bottom: 1.25rem;">
                <form asp-action="CreateCategory" method="post" class="admin-inline-form">
                    <input type="text" name="name" placeholder="@Localizer["Назва нової категорії"]" maxlength="100" required style="flex: 1 1 16rem; padding: 0.5rem 0.75rem; border: 1px solid var(--admin-line); border-radius: 0.6rem;" />
                    <input type="url" name="imageUrl" placeholder="@Localizer["URL картинки (необов'язково)"]" maxlength="500" style="flex: 1 1 18rem; padding: 0.5rem 0.75rem; border: 1px solid var(--admin-line); border-radius: 0.6rem;" />
                    <button type="submit" class="btn btn-primary btn-sm">+ @Localizer["Додати категорію"]</button>
                </form>
            </div>

            @if (Model.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["Категорій поки немає."]</p>
                </div>
            }
            else
            {
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" placeholder="@Localizer["Пошук за назвою..."]"
                           data-admin-search="#categories-table" aria-label="@Localizer["Пошук категорій"]" />
                </div>
                <p class="admin-empty" data-admin-search-empty hidden>@Localizer["Нічого не знайдено за цим запитом."]</p>

                <div class="admin-panel table-responsive">
                    <table class="table admin-table" id="categories-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@Localizer["Назва"]</th>
                                <th>18+</th>
                                <th class="text-end">@Localizer["Дії"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr data-search="@category.Name">
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                                        {
                                            <img src="@category.ImageUrl" alt="@category.Name" class="admin-category-thumb" />
                                        }
                                        else
                                        {
                                            <span class="admin-category-thumb admin-category-thumb--empty" aria-hidden="true">@category.Name[..1].ToUpperInvariant()</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="UpdateCategory" method="post" class="admin-inline-form">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <input type="text" name="name" value="@category.Name" maxlength="100" required class="admin-inline-form__input" style="width: 12rem;" />
                                            <input type="url" name="imageUrl" value="@category.ImageUrl" placeholder="@Localizer["URL картинки"]" maxlength="500" class="admin-inline-form__input" style="width: 14rem;" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Зберегти"]</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form asp-action="SetCategoryAdultStatus" method="post">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <input type="hidden" name="isAdultOnly" value="@((!category.IsAdultOnly).ToString())" />
                                            <button type="submit" class="btn btn-sm @(category.IsAdultOnly ? "btn-warning" : "btn-outline-secondary")">
                                                @(category.IsAdultOnly ? Localizer["Так, 18+"] : Localizer["Ні"])
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('@Localizer["Видалити категорію «"]@category.Name@Localizer["»?"]');">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Видалити"]</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-search.js" asp-append-version="true"></script>
}
