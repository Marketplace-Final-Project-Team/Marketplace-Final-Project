@model IReadOnlyList<Marketplace.BLL.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Категорії — Адмін-панель";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">Категорії</h1>
                    <p class="admin-subtitle">Категорії товарів у каталозі: усього <strong>@Model.Count</strong>.</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <div class="admin-panel" style="padding: 1.1rem 1.25rem; margin-bottom: 1.25rem;">
                <form asp-action="CreateCategory" method="post" class="admin-inline-form">
                    <input type="text" name="name" placeholder="Назва нової категорії" maxlength="100" required style="flex: 1 1 20rem; padding: 0.5rem 0.75rem; border: 1px solid var(--admin-line); border-radius: 0.6rem;" />
                    <button type="submit" class="btn btn-primary btn-sm">+ Додати категорію</button>
                </form>
            </div>

            @if (Model.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">Категорій поки немає.</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>Назва</th>
                                <th class="text-end">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>
                                        <form asp-action="UpdateCategory" method="post" class="admin-inline-form">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <input type="text" name="name" value="@category.Name" maxlength="100" required class="admin-inline-form__input" style="width: 16rem;" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Зберегти</button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Видалити категорію «@category.Name»?');">
                                            <input type="hidden" name="categoryId" value="@category.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
