@model Marketplace.Web.Models.AdminStatisticsPageViewModel

@{
    ViewData["Title"] = $"{Localizer["Статистика"].Value} - {SharedLocalizer["Адмін-панель"].Value}";
    var overview = Model.Overview;

    var periodJson = System.Text.Json.JsonSerializer.Serialize(overview.ByPeriod.Select(p => new
    {
        label = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.Label),
        turnover = p.Turnover,
        orders = p.OrdersCount
    }));

    var businessesJson = System.Text.Json.JsonSerializer.Serialize(overview.Businesses.Take(10).Select(b => new
    {
        name = string.IsNullOrWhiteSpace(b.StoreName) ? Localizer["Без назви"].Value : b.StoreName,
        turnover = b.Turnover
    }));

    var categoryColors = new[] { "#3157d7", "#42a98b", "#e8a33d", "#c65f9e", "#5b8def", "#8a5b00", "#b42318", "#7a89bb" };
    var categoriesJson = System.Text.Json.JsonSerializer.Serialize(overview.Categories.Select((c, i) => new
    {
        name = SharedLocalizer[c.CategoryName].Value,
        turnover = c.Turnover,
        color = categoryColors[i % categoryColors.Length]
    }));
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page admin-page--wide">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Статистика"]</h1>
                    <p class="admin-subtitle">@Localizer["Товарооборот і дохід маркетплейсу за період - по магазинах і в часі. Враховує лише замовлення, що дійшли принаймні до статусу «Підтверджено»."]</p>
                </div>
            </header>

            <form method="get" asp-action="Statistics" class="admin-toolbar admin-toolbar--center">
                <div>
                    <label for="startDate" class="admin-toolbar__label">@Localizer["З дати"]</label>
                    <input type="date" id="startDate" class="form-control" name="StartDate" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label for="endDate" class="admin-toolbar__label">@Localizer["По дату"]</label>
                    <input type="date" id="endDate" class="form-control" name="EndDate" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label for="businessId" class="admin-toolbar__label">@Localizer["Магазин"]</label>
                    <select id="businessId" name="BusinessId" class="form-select">
                        <option value="">@Localizer["Усі магазини"]</option>
                        @foreach (var business in Model.Businesses)
                        {
                            <option value="@business.Id" selected="@(Model.Filter.BusinessId == business.Id)">@(string.IsNullOrWhiteSpace(business.Name) ? Localizer["Без назви"] : business.Name)</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Застосувати"]</button>
                @if (Model.Filter.StartDate.HasValue || Model.Filter.EndDate.HasValue || Model.Filter.BusinessId.HasValue)
                {
                    <a asp-action="Statistics" class="btn btn-outline-secondary">@Localizer["Скинути"]</a>
                }
            </form>

            <div class="admin-stats" aria-label="@Localizer["Загальна статистика"]">
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 3v18h18" />
                            <path d="M7 16v-4" />
                            <path d="M12 16V8" />
                            <path d="M17 16v-7" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Товарооборот"]</span>
                        <strong class="admin-stat-card__value">@overview.TotalTurnover.ToString("N2") ₴</strong>
                        <span class="admin-stat-card__hint">@Localizer["Сума всіх позицій продажів"]</span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Дохід маркетплейсу"]</span>
                        <strong class="admin-stat-card__value">@overview.TotalMarketplaceRevenue.ToString("N2") ₴</strong>
                        <span class="admin-stat-card__hint">@Localizer["Комісія з продажів за період"]</span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                            <path d="M3 6h18" />
                            <path d="M16 10a4 4 0 0 1-8 0" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Продажів"]</span>
                        <strong class="admin-stat-card__value">@overview.TotalOrders</strong>
                        <span class="admin-stat-card__hint">@overview.TotalUnitsSold @Localizer["шт. товарів"]</span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 9 4 4h16l1 5" />
                            <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                            <path d="M4 9v10h16V9" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Магазинів"]</span>
                        <strong class="admin-stat-card__value">@overview.ActiveBusinessCount / @overview.TotalBusinessCount</strong>
                        <span class="admin-stat-card__hint">@Localizer["Активних із загальної кількості - {0} товарів", overview.TotalProductCount]</span>
                    </div>
                </div>
            </div>

            <div class="admin-two-col">
                <div class="admin-panel admin-chart-card">
                    <h2 class="admin-section-heading admin-section-heading--tight">@Localizer["Товарооборот у часі"]</h2>
                    @if (overview.ByPeriod.Count == 0)
                    {
                        <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                    }
                    else
                    {
                        <div class="admin-chart-card__canvas-wrap">
                            <canvas id="turnoverChart" data-chart='@Html.Raw(periodJson)'></canvas>
                        </div>
                    }
                </div>
                <div class="admin-panel admin-chart-card">
                    <h2 class="admin-section-heading admin-section-heading--tight">@Localizer["Оборот за магазинами"]</h2>
                    @if (overview.Businesses.Count == 0)
                    {
                        <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                    }
                    else
                    {
                        <div class="admin-chart-card__canvas-wrap">
                            <canvas id="businessTurnoverChart" data-chart='@Html.Raw(businessesJson)'></canvas>
                        </div>
                    }
                </div>
                <div class="admin-panel admin-chart-card">
                    <h2 class="admin-section-heading admin-section-heading--tight">@Localizer["Продажі за категоріями"]</h2>
                    @if (overview.Categories.Count == 0)
                    {
                        <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                    }
                    else
                    {
                        <div class="admin-chart-card__canvas-wrap">
                            <canvas id="categoryTurnoverChart" data-chart='@Html.Raw(categoriesJson)'></canvas>
                        </div>
                    }
                </div>
            </div>

            <h2 class="admin-section-heading">@Localizer["За магазинами"]</h2>
            @if (overview.Businesses.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Магазин"]</th>
                                <th>@Localizer["Товарів"]</th>
                                <th>@Localizer["Продажів"]</th>
                                <th>@Localizer["Одиниць"]</th>
                                <th>@Localizer["Оборот"]</th>
                                <th>@Localizer["Дохід маркетплейсу"]</th>
                                <th>@Localizer["Середній чек"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in overview.Businesses)
                            {
                                var name = string.IsNullOrWhiteSpace(b.StoreName) ? Localizer["Без назви"].Value : b.StoreName;
                                var initial = name[..1].ToUpperInvariant();

                                <tr>
                                    <td>
                                        <div class="admin-entity-cell">
                                            @if (!string.IsNullOrWhiteSpace(b.LogoUrl))
                                            {
                                                <img class="admin-entity-thumb" src="@b.LogoUrl" alt="@name" />
                                            }
                                            else
                                            {
                                                <div class="admin-entity-placeholder" aria-hidden="true">@initial</div>
                                            }
                                            <span class="admin-entity-name">@name</span>
                                        </div>
                                    </td>
                                    <td class="admin-entity-meta">@b.ActiveProductCount / @b.ProductCount</td>
                                    <td>@b.OrdersCount</td>
                                    <td>@b.UnitsSold</td>
                                    <td>@b.Turnover.ToString("N2") ₴</td>
                                    <td>@b.MarketplaceRevenue.ToString("N2") ₴</td>
                                    <td class="admin-entity-meta">@b.AverageOrderValue.ToString("N2") ₴</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h2 class="admin-section-heading">@Localizer["За категоріями"]</h2>
            @if (overview.Categories.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Категорія"]</th>
                                <th>@Localizer["Продажів"]</th>
                                <th>@Localizer["Одиниць"]</th>
                                <th>@Localizer["Оборот"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in overview.Categories)
                            {
                                <tr>
                                    <td class="admin-entity-name">@SharedLocalizer[c.CategoryName]</td>
                                    <td>@c.OrdersCount</td>
                                    <td>@c.UnitsSold</td>
                                    <td>@c.Turnover.ToString("N2") ₴</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h2 class="admin-section-heading">@Localizer["У часі"]</h2>
            @if (overview.ByPeriod.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["За обраний період продажів немає."]</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Період"]</th>
                                <th>@Localizer["Продажів"]</th>
                                <th>@Localizer["Оборот"]</th>
                                <th>@Localizer["Дохід маркетплейсу"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in overview.ByPeriod)
                            {
                                <tr>
                                    <td class="admin-entity-name">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(p.Label)</td>
                                    <td>@p.OrdersCount</td>
                                    <td>@p.Turnover.ToString("N2") ₴</td>
                                    <td>@p.MarketplaceRevenue.ToString("N2") ₴</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/chart-helpers.js" asp-append-version="true"></script>
    <script src="~/js/admin-statistics-charts.js" asp-append-version="true"></script>
}
