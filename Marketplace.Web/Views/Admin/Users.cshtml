@model IEnumerable<Marketplace.Web.Models.UserItemAdminViewModel>

@{
    ViewData["Title"] = "Користувачі — Адмін-панель";
    var users = Model.ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@functions {
    private static string StatusLabel(Marketplace.Domain.Enums.UserStatus status) => status switch
    {
        Marketplace.Domain.Enums.UserStatus.Active => "Активний",
        Marketplace.Domain.Enums.UserStatus.Banned => "Заблокований",
        _ => status.ToString()
    };
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">Користувачі</h1>
                    <p class="admin-subtitle">Усього зареєстровано <strong>@users.Count</strong> користувачів.</p>
                </div>
            </header>

            @if (users.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">Користувачів поки немає.</p>
                </div>
            }
            else
            {
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" placeholder="Пошук за email..."
                           data-admin-search="#users-table" aria-label="Пошук користувачів" />
                </div>
                <p class="admin-empty" data-admin-search-empty hidden>Нічого не знайдено за цим запитом.</p>

                <div class="admin-panel table-responsive">
                    <table class="table admin-table" id="users-table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Статус</th>
                                <th class="text-end">Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                var statusClass = user.Status.ToString().ToLowerInvariant();

                                <tr>
                                    <td class="admin-entity-name">@user.Email</td>
                                    <td><span class="admin-status admin-status--@statusClass">@StatusLabel(user.Status)</span></td>
                                    <td>
                                        <div class="admin-row-actions">
                                            @if (user.Status == Marketplace.Domain.Enums.UserStatus.Active)
                                            {
                                                <form asp-action="ChangeUserStatus" method="post">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <input type="hidden" name="status" value="Banned" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Заблокувати</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ChangeUserStatus" method="post">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <input type="hidden" name="status" value="Active" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">Активувати</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-search.js" asp-append-version="true"></script>
}
