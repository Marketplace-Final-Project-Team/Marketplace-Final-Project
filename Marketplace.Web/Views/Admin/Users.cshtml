@model Marketplace.Web.Models.AdminUsersPageViewModel

@{
    ViewData["Title"] = $"{Localizer["Користувачі"].Value} - {SharedLocalizer["Адмін-панель"].Value}";
    var users = Model.Result.Items;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.UserStatus status) => status switch
    {
        Marketplace.Domain.Enums.UserStatus.Active => Localizer["Активний"].Value,
        Marketplace.Domain.Enums.UserStatus.Banned => Localizer["Заблокований"].Value,
        _ => status.ToString()
    };
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Користувачі"]</h1>
                    <p class="admin-subtitle">@Localizer["Знайдено"] <strong>@Model.Result.TotalItems</strong> @Localizer["користувачів."]</p>
                </div>
            </header>

            <form method="get" asp-action="Users" class="admin-toolbar">
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" name="Search" value="@Model.Filter.Search" placeholder="@Localizer["Пошук за email..."]" aria-label="@Localizer["Пошук користувачів"]" />
                </div>
                <select class="form-select" name="Status" aria-label="@Localizer["Фільтр за статусом"]" onchange="this.form.submit()">
                    <option value="">@Localizer["Усі статуси"]</option>
                    <option value="Active" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.UserStatus.Active)">@Localizer["Активний"]</option>
                    <option value="Banned" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.UserStatus.Banned)">@Localizer["Заблокований"]</option>
                </select>
                <select class="form-select" name="SortDescending" aria-label="@Localizer["Сортування"]" onchange="this.form.submit()">
                    <option value="true" selected="@(Model.Filter.SortDescending != false)">@Localizer["Спочатку нові"]</option>
                    <option value="false" selected="@(Model.Filter.SortDescending == false)">@Localizer["Спочатку старі"]</option>
                </select>
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Застосувати"]</button>
            </form>

            @if (users.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["Нічого не знайдено за цим запитом."]</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table" id="users-table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>@Localizer["Статус"]</th>
                                <th class="text-end">@Localizer["Дії"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                var statusClass = user.Status.ToString().ToLowerInvariant();

                                <tr>
                                    <td class="admin-entity-name">@user.Email</td>
                                    <td><span class="admin-status admin-status--@statusClass">@StatusLabel(user.Status)</span></td>
                                    <td>
                                        <div class="admin-row-actions">
                                            @if (user.Status == Marketplace.Domain.Enums.UserStatus.Active)
                                            {
                                                <form asp-action="ChangeUserStatus" method="post">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <input type="hidden" name="status" value="Banned" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Заблокувати"]</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ChangeUserStatus" method="post">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <input type="hidden" name="status" value="Active" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Активувати"]</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="_AdminPagination" model="new Marketplace.Web.Models.AdminPaginationViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages }" />
                </div>
            }
        </div>
    </div>
</div>
