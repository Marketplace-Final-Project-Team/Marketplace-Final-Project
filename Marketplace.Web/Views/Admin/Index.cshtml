@model Marketplace.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Адмін-панель";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">Дашборд</h1>
                    <p class="admin-subtitle">Загальний стан маркетплейсу: користувачі, товари та магазини, що потребують уваги.</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <div class="admin-stats" aria-label="Загальна статистика">
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Користувачі</span>
                        <strong class="admin-stat-card__value">@Model.TotalUsers</strong>
                        <span class="admin-stat-card__hint"><strong>@Model.BannedUsers</strong> заблоковано</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingProducts > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                            <path d="M3 8v8l9 5 9-5V8" />
                            <path d="M12 13v8" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Товари на модерації</span>
                        <strong class="admin-stat-card__value">@Model.PendingProducts</strong>
                        <span class="admin-stat-card__hint">з <strong>@Model.TotalProducts</strong> усього · @Model.BannedProducts заблоковано</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingBusinesses > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 9 4 4h16l1 5" />
                            <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                            <path d="M4 9v10h16V9" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Магазини на перевірці</span>
                        <strong class="admin-stat-card__value">@Model.PendingBusinesses</strong>
                        <span class="admin-stat-card__hint">з <strong>@Model.TotalBusinesses</strong> усього</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingAdultRequests > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 9v4" />
                            <path d="M12 17h.01" />
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Очікують верифікації 18+</span>
                        <strong class="admin-stat-card__value">@Model.PendingAdultRequests</strong>
                        <span class="admin-stat-card__hint">Заявки магазинів на розміщення 18+ контенту</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingWithdrawals > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <rect x="2" y="5" width="20" height="14" rx="2" />
                            <path d="M2 10h20" />
                            <path d="M6 15h4" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Заявки на виплату</span>
                        <strong class="admin-stat-card__value">@Model.PendingWithdrawals</strong>
                        <span class="admin-stat-card__hint"><a asp-controller="Withdrawal" asp-action="Withdrawals">Переглянути →</a></span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Баланс маркетплейсу</span>
                        <strong class="admin-stat-card__value">@Model.MarketplaceBalance.ToString("N0") ₴</strong>
                        <span class="admin-stat-card__hint">Накопичена комісія з продажів</span>
                    </div>
                </div>
            </div>

            @if (Model.AdultRequestsQueue.Count > 0)
            {
                <h2 class="admin-section-heading">Заявки на 18+ контент</h2>
                <section class="admin-panel table-responsive">
                    <table class="table admin-table">
                        <thead>
                            <tr><th>Магазин</th><th>Власник</th><th class="text-end">Дії</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var business in Model.AdultRequestsQueue)
                            {
                                <tr>
                                    <td class="admin-entity-name">@(string.IsNullOrWhiteSpace(business.Name) ? "Без назви" : business.Name)</td>
                                    <td>@business.Owner</td>
                                    <td class="text-end">
                                        <form asp-action="ApproveAdultStatus" method="post" class="d-inline">
                                            <input type="hidden" name="businessId" value="@business.Id" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Підтвердити 18+</button>
                                        </form>
                                        <form asp-action="RejectAdultStatus" method="post" class="admin-inline-form">
                                            <input type="hidden" name="businessId" value="@business.Id" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                                            <input type="text" name="reason" placeholder="Причина відхилення" class="admin-inline-form__input" required />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Відхилити</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }

            <h2 class="admin-section-heading">Швидкі дії</h2>
            <div class="admin-quick-links">
                <a class="admin-quick-link" asp-action="Users">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <div>
                        <strong>Керувати користувачами</strong>
                        <span>Блокування та відновлення акаунтів</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Products">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                            <path d="M3 8v8l9 5 9-5V8" />
                            <path d="M12 13v8" />
                        </svg>
                    </span>
                    <div>
                        <strong>Модерувати товари</strong>
                        <span>Активація, модерація, блокування</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Businesses">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 9 4 4h16l1 5" />
                            <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                            <path d="M4 9v10h16V9" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <div>
                        <strong>Перевіряти магазини</strong>
                        <span>Схвалення та призупинення бізнесів</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Statistics">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 3v18h18" />
                            <path d="M7 16v-4" />
                            <path d="M12 16V8" />
                            <path d="M17 16v-7" />
                        </svg>
                    </span>
                    <div>
                        <strong>Статистика</strong>
                        <span>Оборот і дохід по магазинах та в часі</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
            </div>

            <h2 class="admin-section-heading">Система</h2>
            <div class="admin-quick-links">
                <a class="admin-quick-link" asp-controller="Withdrawal" asp-action="Withdrawals">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <rect x="2" y="5" width="20" height="14" rx="2" />
                            <path d="M2 10h20" />
                            <path d="M6 15h4" />
                        </svg>
                    </span>
                    <div>
                        <strong>Виплати</strong>
                        <span>Заявки продавців на виведення коштів</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Jobs">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3.5 2" />
                        </svg>
                    </span>
                    <div>
                        <strong>Фонові задачі</strong>
                        <span>Розклад, статус, ручний запуск</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="BusinessLimits">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 3v18" />
                            <path d="M5 8h5.5a2.5 2.5 0 0 1 0 5H8a2.5 2.5 0 0 0 0 5h6" />
                        </svg>
                    </span>
                    <div>
                        <strong>Ліміти бізнесу</strong>
                        <span>Товари, знижки, промокоди</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="MarketplaceBalance">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div>
                        <strong>Баланс маркетплейсу</strong>
                        <span>Комісія з продажів, ставка</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="UserActivityLog">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M4 4h16v16H4z" />
                            <path d="M8 9h8" />
                            <path d="M8 13h8" />
                            <path d="M8 17h5" />
                        </svg>
                    </span>
                    <div>
                        <strong>Журнал користувачів</strong>
                        <span>Реєстрації, входи, замовлення</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="BusinessActivityLog">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M4 4h16v16H4z" />
                            <path d="M8 9h8" />
                            <path d="M8 13h8" />
                            <path d="M8 17h5" />
                        </svg>
                    </span>
                    <div>
                        <strong>Журнал бізнесів</strong>
                        <span>Товари, знижки, промокоди, статуси</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</div>
