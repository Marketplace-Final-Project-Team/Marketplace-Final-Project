@model Marketplace.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = SharedLocalizer["Адмін-панель"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Дашборд"]</h1>
                    <p class="admin-subtitle">@Localizer["Загальний стан LUNEXA: користувачі, товари та магазини, що потребують уваги."]</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <div class="admin-stats" aria-label="@Localizer["Загальна статистика"]">
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Користувачі"]</span>
                        <strong class="admin-stat-card__value">@Model.TotalUsers</strong>
                        <span class="admin-stat-card__hint"><strong>@Model.BannedUsers</strong> @Localizer["заблоковано"]</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingProducts > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                            <path d="M3 8v8l9 5 9-5V8" />
                            <path d="M12 13v8" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Товари на модерації"]</span>
                        <strong class="admin-stat-card__value">@Model.PendingProducts</strong>
                        <span class="admin-stat-card__hint">@Localizer["з"] <strong>@Model.TotalProducts</strong> @Localizer["усього ·"] @Model.BannedProducts @Localizer["заблоковано"]</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingBusinesses > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 9 4 4h16l1 5" />
                            <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                            <path d="M4 9v10h16V9" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Магазини на перевірці"]</span>
                        <strong class="admin-stat-card__value">@Model.PendingBusinesses</strong>
                        <span class="admin-stat-card__hint">@Localizer["з"] <strong>@Model.TotalBusinesses</strong> @Localizer["усього"]</span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingAdultRequests > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 9v4" />
                            <path d="M12 17h.01" />
                            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Очікують верифікації 18+"]</span>
                        <strong class="admin-stat-card__value">@Model.PendingAdultRequests</strong>
                        <span class="admin-stat-card__hint"><a asp-action="Jobs">@Localizer["Переглянути →"]</a></span>
                    </div>
                </div>
                <div class="admin-stat-card @(Model.PendingWithdrawals > 0 ? "admin-stat-card--warning" : null)">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <rect x="2" y="5" width="20" height="14" rx="2" />
                            <path d="M2 10h20" />
                            <path d="M6 15h4" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Заявки на виплату"]</span>
                        <strong class="admin-stat-card__value">@Model.PendingWithdrawals</strong>
                        <span class="admin-stat-card__hint"><a asp-controller="Withdrawal" asp-action="Withdrawals">@Localizer["Переглянути →"]</a></span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">@Localizer["Баланс LUNEXA"]</span>
                        <strong class="admin-stat-card__value">@Model.MarketplaceBalance.ToString("N0") ₴</strong>
                        <span class="admin-stat-card__hint">@Localizer["Накопичена комісія з продажів"]</span>
                    </div>
                </div>
            </div>

            <h2 class="admin-section-heading">@Localizer["Швидкі дії"]</h2>
            <div class="admin-quick-links">
                <a class="admin-quick-link" asp-action="Users">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Керувати користувачами"]</strong>
                        <span>@Localizer["Блокування та відновлення акаунтів"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Products">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                            <path d="M3 8v8l9 5 9-5V8" />
                            <path d="M12 13v8" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Модерувати товари"]</strong>
                        <span>@Localizer["Активація, модерація, блокування"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Businesses">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 9 4 4h16l1 5" />
                            <path d="M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0" />
                            <path d="M4 9v10h16V9" />
                            <path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Перевіряти магазини"]</strong>
                        <span>@Localizer["Схвалення та призупинення бізнесів"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Statistics">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M3 3v18h18" />
                            <path d="M7 16v-4" />
                            <path d="M12 16V8" />
                            <path d="M17 16v-7" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Статистика"]</strong>
                        <span>@Localizer["Оборот і дохід по магазинах та в часі"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
            </div>

            <h2 class="admin-section-heading">@Localizer["Система"]</h2>
            <div class="admin-quick-links">
                <a class="admin-quick-link" asp-controller="Withdrawal" asp-action="Withdrawals">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <rect x="2" y="5" width="20" height="14" rx="2" />
                            <path d="M2 10h20" />
                            <path d="M6 15h4" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Виплати"]</strong>
                        <span>@Localizer["Заявки продавців на виведення коштів"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="Jobs">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3.5 2" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Фонові задачі"]</strong>
                        <span>@Localizer["Розклад, статус, ручний запуск"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="BusinessLimits">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 3v18" />
                            <path d="M5 8h5.5a2.5 2.5 0 0 1 0 5H8a2.5 2.5 0 0 0 0 5h6" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Ліміти бізнесу"]</strong>
                        <span>@Localizer["Товари, знижки, промокоди"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="MarketplaceBalance">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Баланс LUNEXA"]</strong>
                        <span>@Localizer["Комісія з продажів, ставка"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="UserActivityLog">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M4 4h16v16H4z" />
                            <path d="M8 9h8" />
                            <path d="M8 13h8" />
                            <path d="M8 17h5" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Журнал користувачів"]</strong>
                        <span>@Localizer["Реєстрації, входи, замовлення"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
                <a class="admin-quick-link" asp-action="BusinessActivityLog">
                    <span class="admin-quick-link__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M4 4h16v16H4z" />
                            <path d="M8 9h8" />
                            <path d="M8 13h8" />
                            <path d="M8 17h5" />
                        </svg>
                    </span>
                    <div>
                        <strong>@Localizer["Журнал бізнесів"]</strong>
                        <span>@Localizer["Товари, знижки, промокоди, статуси"]</span>
                    </div>
                    <span class="admin-quick-link__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</div>