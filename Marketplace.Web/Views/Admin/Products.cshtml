@model Marketplace.Web.Models.AdminProductsPageViewModel

@{
    ViewData["Title"] = $"{Localizer["Товари"].Value} - {SharedLocalizer["Адмін-панель"].Value}";
    var products = Model.Result.Items;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.ProductStatus status) => status switch
    {
        Marketplace.Domain.Enums.ProductStatus.Active => Localizer["Активний"].Value,
        Marketplace.Domain.Enums.ProductStatus.Pending => Localizer["На модерації"].Value,
        Marketplace.Domain.Enums.ProductStatus.Banned => Localizer["Заблокований"].Value,
        _ => status.ToString()
    };

    private string SortLabel(Marketplace.Domain.Enums.ProductSortOption option) => option switch
    {
        Marketplace.Domain.Enums.ProductSortOption.PriceAsc => Localizer["Ціна: зростання"].Value,
        Marketplace.Domain.Enums.ProductSortOption.PriceDesc => Localizer["Ціна: спадання"].Value,
        Marketplace.Domain.Enums.ProductSortOption.CreatedAtAsc => Localizer["Спочатку старі"].Value,
        Marketplace.Domain.Enums.ProductSortOption.CreatedAtDesc => Localizer["Спочатку нові"].Value,
        Marketplace.Domain.Enums.ProductSortOption.PopularityAsc => Localizer["Популярність: за зростанням"].Value,
        Marketplace.Domain.Enums.ProductSortOption.PopularityDesc => Localizer["Популярність: за спаданням"].Value,
        _ => option.ToString()
    };
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Товари"]</h1>
                    <p class="admin-subtitle">@Localizer["Знайдено"] <strong>@Model.Result.TotalItems</strong> @Localizer["товарів."]</p>
                </div>
            </header>

            <form method="get" asp-action="Products" class="admin-toolbar">
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" name="Search" value="@Model.Filter.Search" placeholder="@Localizer["Пошук за назвою"]" aria-label="@Localizer["Пошук товарів"]" />
                </div>
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" name="SearchBusiness" value="@Model.Filter.SearchBusiness" placeholder="@Localizer["Пошук за магазином"]" aria-label="@Localizer["Пошук за магазином"]" />
                </div>
                <select class="form-select" name="CategoryId" aria-label="@Localizer["Фільтр за категорією"]" onchange="this.form.submit()">
                    <option value="">@SharedLocalizer["Усі категорії"]</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.Filter.CategoryId == category.Id)">@SharedLocalizer[category.Name]</option>
                    }
                </select>
                <select class="form-select" name="Status" aria-label="@Localizer["Фільтр за статусом"]" onchange="this.form.submit()">
                    <option value="">@Localizer["Усі статуси"]</option>
                    @foreach (Marketplace.Domain.Enums.ProductStatus status in Enum.GetValues(typeof(Marketplace.Domain.Enums.ProductStatus)))
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status)">@StatusLabel(status)</option>
                    }
                </select>
                <div class="admin-price-range">
                    <input type="number" class="form-control" name="MinPrice" min="0" step="1" placeholder="@Localizer["Ціна від"]" aria-label="@Localizer["Ціна від"]" value="@Model.Filter.MinPrice" />
                    <span aria-hidden="true">-</span>
                    <input type="number" class="form-control" name="MaxPrice" min="0" step="1" placeholder="@Localizer["Ціна до"]" aria-label="@Localizer["Ціна до"]" value="@Model.Filter.MaxPrice" />
                </div>
                <label class="admin-checkbox-filter">
                    <input type="checkbox" name="InStockOnly" value="true" checked="@(Model.Filter.InStockOnly == true)" onchange="this.form.submit()" />
                    @Localizer["Тільки в наявності"]
                </label>
                <select class="form-select" name="SortOption" aria-label="@Localizer["Сортування"]" onchange="this.form.submit()">
                    @foreach (Marketplace.Domain.Enums.ProductSortOption option in Enum.GetValues(typeof(Marketplace.Domain.Enums.ProductSortOption)))
                    {
                        <option value="@option" selected="@(Model.Filter.SortOption == option)">@SortLabel(option)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Застосувати"]</button>
            </form>

            @if (products.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["Нічого не знайдено за цим запитом."]</p>
                </div>
            }
            else
            {
                <div class="admin-view-toggle" role="group" aria-label="@Localizer["Режим перегляду товарів"]">
                    <button type="button" class="admin-view-toggle__btn" data-view-toggle="list" aria-label="@Localizer["Список"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                            <path d="M8 6h13" />
                            <path d="M8 12h13" />
                            <path d="M8 18h13" />
                            <path d="M3 6h.01" />
                            <path d="M3 12h.01" />
                            <path d="M3 18h.01" />
                        </svg>
                        <span>@Localizer["Список"]</span>
                    </button>
                    <button type="button" class="admin-view-toggle__btn" data-view-toggle="grid" aria-label="@Localizer["Плитка"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                            <rect x="3" y="3" width="7" height="7" rx="1.2" />
                            <rect x="14" y="3" width="7" height="7" rx="1.2" />
                            <rect x="14" y="14" width="7" height="7" rx="1.2" />
                            <rect x="3" y="14" width="7" height="7" rx="1.2" />
                        </svg>
                        <span>@Localizer["Плитка"]</span>
                    </button>
                    <button type="button" class="admin-view-toggle__btn" data-view-toggle="carousel" aria-label="@Localizer["Карусель"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                            <rect x="7" y="4" width="10" height="16" rx="1.5" />
                            <path d="M2 8v8" />
                            <path d="M22 8v8" />
                        </svg>
                        <span>@Localizer["Карусель"]</span>
                    </button>
                </div>

                <div data-products-view="list">
                    <div class="admin-panel table-responsive">
                        <table class="table admin-table" id="products-table">
                            <thead>
                                <tr>
                                    <th>@Localizer["Товар"]</th>
                                    <th>@Localizer["Ціна"]</th>
                                    <th>@Localizer["Статус"]</th>
                                    <th class="text-end">@Localizer["Дії"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in products)
                                {
                                    var statusClass = product.Status.ToString().ToLowerInvariant();
                                    var productInitial = string.IsNullOrWhiteSpace(product.Name) ? "?" : product.Name[..1].ToUpperInvariant();

                                    <tr>
                                        <td>
                                            <button type="button" class="admin-entity-cell admin-entity-cell--clickable" data-product-open="@product.Id">
                                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                {
                                                    <img class="admin-entity-thumb" src="@product.ImageUrl" alt="@product.Name" />
                                                }
                                                else
                                                {
                                                    <div class="admin-entity-placeholder" aria-hidden="true">@productInitial</div>
                                                }
                                                <span class="admin-entity-name">@product.Name</span>
                                            </button>
                                        </td>
                                        <td class="fw-semibold">@product.Price.ToString("N2") ₴</td>
                                        <td><span class="admin-status admin-status--@statusClass">@StatusLabel(product.Status)</span></td>
                                        <td>
                                            <div class="admin-row-actions">
                                                <partial name="_ProductActionButtons" model="product" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <partial name="_AdminPagination" model="new Marketplace.Web.Models.AdminPaginationViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages }" />
                    </div>
                </div>

                <div data-products-view="grid" hidden>
                    <div class="admin-product-grid">
                        @foreach (var product in products)
                        {
                            var statusClass = product.Status.ToString().ToLowerInvariant();
                            var productInitial = string.IsNullOrWhiteSpace(product.Name) ? "?" : product.Name[..1].ToUpperInvariant();

                            <div class="admin-product-card">
                                <button type="button" class="admin-product-card__image" data-product-open="@product.Id" aria-label="@product.Name">
                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <span class="admin-product-card__placeholder" aria-hidden="true">@productInitial</span>
                                    }
                                    <span class="admin-status admin-status--@statusClass admin-product-card__status">@StatusLabel(product.Status)</span>
                                </button>
                                <div class="admin-product-card__body">
                                    <button type="button" class="admin-product-card__name" data-product-open="@product.Id">@product.Name</button>
                                    <span class="admin-product-card__price">@product.Price.ToString("N2") ₴</span>
                                </div>
                                <div class="admin-product-card__actions">
                                    <partial name="_ProductActionButtons" model="product" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="admin-panel">
                        <partial name="_AdminPagination" model="new Marketplace.Web.Models.AdminPaginationViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages }" />
                    </div>
                </div>

                <div data-products-view="carousel" hidden>
                    <div id="productsCarousel" class="carousel slide admin-product-carousel" data-bs-ride="false" data-bs-interval="false">
                        <div class="carousel-inner">
                            @{ var isFirstSlide = true; }
                            @foreach (var product in products)
                            {
                                var statusClass = product.Status.ToString().ToLowerInvariant();
                                var productInitial = string.IsNullOrWhiteSpace(product.Name) ? "?" : product.Name[..1].ToUpperInvariant();

                                <div class="carousel-item @(isFirstSlide ? "active" : "")">
                                    <div class="admin-carousel-slide">
                                        <button type="button" class="admin-carousel-slide__image" data-product-open="@product.Id" aria-label="@product.Name">
                                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                            {
                                                <img src="@product.ImageUrl" alt="@product.Name" />
                                            }
                                            else
                                            {
                                                <span class="admin-product-card__placeholder" aria-hidden="true">@productInitial</span>
                                            }
                                        </button>
                                        <div class="admin-carousel-slide__body">
                                            <span class="admin-status admin-status--@statusClass">@StatusLabel(product.Status)</span>
                                            <button type="button" class="admin-carousel-slide__name" data-product-open="@product.Id">@product.Name</button>
                                            <span class="admin-carousel-slide__price">@product.Price.ToString("N2") ₴</span>
                                            <div class="admin-carousel-slide__actions">
                                                <partial name="_ProductActionButtons" model="product" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                isFirstSlide = false;
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productsCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@Localizer["Попередній"]</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productsCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">@Localizer["Наступний"]</span>
                        </button>
                    </div>
                    <div class="admin-panel">
                        <partial name="_AdminPagination" model="new Marketplace.Web.Models.AdminPaginationViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages }" />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="admin-modal" data-admin-modal hidden>
        <div class="admin-modal__card admin-modal__card--wide">
            <button type="button" class="admin-modal__close" aria-label="@Localizer["Закрити"]" data-admin-modal-close>×</button>
            <div data-admin-modal-body></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-product-modal.js" asp-append-version="true"></script>
    <script src="~/js/admin-products-view.js" asp-append-version="true"></script>
}
