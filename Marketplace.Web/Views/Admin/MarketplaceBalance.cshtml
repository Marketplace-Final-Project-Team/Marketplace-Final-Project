@model Marketplace.Web.Models.MarketplaceBalanceViewModel

@{
    ViewData["Title"] = "Баланс маркетплейсу — Адмін-панель";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">Баланс маркетплейсу</h1>
                    <p class="admin-subtitle">Комісія платформи з кожного підтвердженого замовлення — окремо від балансів продавців.</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }

            <div class="admin-stats" aria-label="Баланс маркетплейсу">
                <div class="admin-stat-card">
                    <span class="admin-stat-card__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                            <path d="M12 1v22" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                        </svg>
                    </span>
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Баланс маркетплейсу</span>
                        <strong class="admin-stat-card__value">@Model.Balance.ToString("N2") ₴</strong>
                        <span class="admin-stat-card__hint">Накопичена комісія з підтверджених замовлень</span>
                    </div>
                </div>
            </div>

            <div class="admin-note">
                <strong>Як це працює</strong>
                Комісія задається окремо для кожного бізнесу (розділ «Бізнеси») і фіксується для кожної позиції замовлення в момент підтвердження продавцем (статус «Підтверджено») — продавцю зараховується сума за вирахуванням комісії, різниця йде на баланс маркетплейсу. Якщо підтверджене замовлення згодом скасовують, обидва баланси коригуються назад симетрично, за тією ставкою, що діяла на момент підтвердження.
            </div>
        </div>
    </div>
</div>
