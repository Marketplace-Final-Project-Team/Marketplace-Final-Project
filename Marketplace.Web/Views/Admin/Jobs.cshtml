@model List<Marketplace.Web.Models.AdminJobViewModel>

@{
    ViewData["Title"] = "Задачі — Адмін-панель";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">Фонові задачі</h1>
                    <p class="admin-subtitle">Заплановані процеси маркетплейсу: розклад, стан і результат останнього запуску.</p>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }

            <div class="admin-note">
                <strong>У розробці</strong>
                Розклад і виконання підключає Quartz.NET на бекенді — це робить інший розробник. Нижче показано контракт, під який адаптується цей UI, коли бекенд буде готовий.
            </div>

            <div class="admin-panel table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Задача</th>
                            <th>Розклад</th>
                            <th>Стан</th>
                            <th>Наступний запуск</th>
                            <th>Останній запуск</th>
                            <th class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td>
                                    <span class="admin-job-name">@job.DisplayName</span>
                                    <span class="admin-job-desc">@job.Description</span>
                                </td>
                                <td>@job.Schedule</td>
                                <td>
                                    <span class="admin-status admin-status--@(job.IsPaused ? "rejected" : "active")">
                                        @(job.IsPaused ? "Призупинено" : "Активна")
                                    </span>
                                </td>
                                <td>@(job.NextRunAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>
                                    @if (job.LastRunAt.HasValue)
                                    {
                                        <div>@job.LastRunAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                        <span class="admin-status admin-status--@(job.LastRunSucceeded == true ? "active" : "banned")">
                                            @(job.LastRunSucceeded == true ? "Успішно" : "Помилка")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    <div class="admin-row-actions">
                                        <form asp-action="RunJobNow" method="post">
                                            <input type="hidden" name="jobName" value="@job.Name" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Запустити зараз</button>
                                        </form>
                                        <form asp-action="ToggleJobPaused" method="post">
                                            <input type="hidden" name="jobName" value="@job.Name" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                @(job.IsPaused ? "Відновити" : "Призупинити")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
