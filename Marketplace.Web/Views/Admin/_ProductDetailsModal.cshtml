@model Marketplace.Web.Models.ProductAdminDetailsViewModel

@{
    var statusClass = Model.Status.ToString().ToLowerInvariant();
    var statusLabel = Model.Status switch
    {
        Marketplace.Domain.Enums.ProductStatus.Active => "Активний",
        Marketplace.Domain.Enums.ProductStatus.Pending => "На модерації",
        Marketplace.Domain.Enums.ProductStatus.Banned => "Заблокований",
        _ => Model.Status.ToString()
    };
    var gallery = new[] { Model.MainImageUrl }.Concat(Model.AdditionalImageUrls)
        .Where(u => !string.IsNullOrWhiteSpace(u))
        .Distinct()
        .ToList();
}

<div class="admin-product-modal__header">
    <h3>@Model.Name</h3>
    <span class="admin-status admin-status--@statusClass">@statusLabel</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ModerationReason))
{
    <div class="admin-alert admin-alert--error">
        <span>!</span>
        <p><strong>Причина:</strong> @Model.ModerationReason</p>
    </div>
}

@if (gallery.Count > 0)
{
    <div class="admin-product-modal__gallery">
        @foreach (var url in gallery)
        {
            <a href="@url" target="_blank" rel="noopener" title="Відкрити зображення на весь розмір">
                <img src="@url" alt="@Model.Name" />
            </a>
        }
    </div>
}
else
{
    <p class="admin-empty">Без зображень.</p>
}

<dl class="admin-product-modal__facts">
    <div>
        <dt>Ціна</dt>
        <dd>@Model.Price.ToString("N2") ₴</dd>
    </div>
    <div>
        <dt>Кількість на складі</dt>
        <dd>@Model.Quantity шт.</dd>
    </div>
    <div>
        <dt>Категорія</dt>
        <dd>@Model.CategoryName</dd>
    </div>
    <div>
        <dt>Магазин</dt>
        <dd><a asp-controller="Admin" asp-action="Businesses" asp-route-Search="@Model.BusinessName">@Model.BusinessName</a></dd>
    </div>
    <div>
        <dt>Додано</dt>
        <dd>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
    </div>
</dl>

<div class="admin-product-modal__description">
    <h4>Опис</h4>
    <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Продавець не додав опис." : Model.Description)</p>
</div>

<div class="admin-product-modal__actions">
    @if (Model.Status != Marketplace.Domain.Enums.ProductStatus.Active)
    {
        <form asp-controller="Admin" asp-action="ChangeProductStatus" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="status" value="Active" />
            <button type="submit" class="btn btn-outline-success">Погодити</button>
        </form>
    }
    @if (Model.Status != Marketplace.Domain.Enums.ProductStatus.Pending)
    {
        <form asp-controller="Admin" asp-action="ChangeProductStatus" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="status" value="Pending" />
            <button type="submit" class="btn btn-outline-secondary">Залишити на розгляді</button>
        </form>
    }
    @if (Model.Status != Marketplace.Domain.Enums.ProductStatus.Banned)
    {
        <form asp-controller="Admin" asp-action="ChangeProductStatus" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="status" value="Banned" />
            <button type="submit" class="btn btn-outline-danger">Відхилити</button>
        </form>
    }
</div>
