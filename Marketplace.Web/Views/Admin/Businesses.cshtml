@model Marketplace.Web.Models.AdminBusinessesPageViewModel

@{
    ViewData["Title"] = $"{Localizer["Бізнеси"].Value} - {SharedLocalizer["Адмін-панель"].Value}";
    var businesses = Model.Result.Items;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.BusinessStatus status) => status switch
    {
        Marketplace.Domain.Enums.BusinessStatus.Pending => Localizer["На перевірці"].Value,
        Marketplace.Domain.Enums.BusinessStatus.Active => Localizer["Активний"].Value,
        Marketplace.Domain.Enums.BusinessStatus.Suspended => Localizer["Призупинений"].Value,
        Marketplace.Domain.Enums.BusinessStatus.Rejected => Localizer["Відхилений"].Value,
        _ => status.ToString()
    };
}

<div class="admin-page admin-page--wide">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <header class="admin-header">
                <div>
                    <div class="admin-kicker">Admin</div>
                    <h1 class="admin-title">@Localizer["Бізнеси"]</h1>
                    <p class="admin-subtitle">@Localizer["Знайдено"] <strong>@Model.Result.TotalItems</strong> @Localizer["магазинів."]</p>
                </div>
            </header>

            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <form method="get" asp-action="Businesses" class="admin-toolbar">
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" name="Search" value="@Model.Filter.Search" placeholder="@Localizer["Пошук за назвою"]" aria-label="@Localizer["Пошук магазинів"]" />
                </div>
                <div class="admin-search-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input type="search" class="form-control admin-search" name="SearchEmail" value="@Model.Filter.SearchEmail" placeholder="@Localizer["Пошук за email"]" aria-label="@Localizer["Пошук за email власника"]" />
                </div>
                <select class="form-select" name="Status" aria-label="@Localizer["Фільтр за статусом"]" onchange="this.form.submit()">
                    <option value="">@Localizer["Усі статуси"]</option>
                    <option value="Active" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.BusinessStatus.Active)">@Localizer["Активний"]</option>
                    <option value="Pending" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.BusinessStatus.Pending)">@Localizer["На перевірці"]</option>
                    <option value="Suspended" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.BusinessStatus.Suspended)">@Localizer["Призупинений"]</option>
                    <option value="Rejected" selected="@(Model.Filter.Status == Marketplace.Domain.Enums.BusinessStatus.Rejected)">@Localizer["Відхилений"]</option>
                </select>
                <div class="admin-price-range admin-price-range--wide">
                    <input type="number" class="form-control" name="MinCommission" min="0" max="100" step="0.1" placeholder="@Localizer["Комісія від"]" aria-label="@Localizer["Комісія від"]" value="@Model.Filter.MinCommission" />
                    <span aria-hidden="true">-</span>
                    <input type="number" class="form-control" name="MaxCommission" min="0" max="100" step="0.1" placeholder="@Localizer["Комісія до"]" aria-label="@Localizer["Комісія до"]" value="@Model.Filter.MaxCommission" />
                </div>
                <select class="form-select" name="SortOption" aria-label="@Localizer["Сортування"]" onchange="this.form.submit()">
                    <option value="CreatedAtDesc" selected="@(Model.Filter.SortOption == Marketplace.Domain.Enums.BusinessSortOption.CreatedAtDesc)">@Localizer["Спочатку нові"]</option>
                    <option value="CreatedAtAsc" selected="@(Model.Filter.SortOption == Marketplace.Domain.Enums.BusinessSortOption.CreatedAtAsc)">@Localizer["Спочатку старі"]</option>
                    <option value="CommissionAsc" selected="@(Model.Filter.SortOption == Marketplace.Domain.Enums.BusinessSortOption.CommissionAsc)">@Localizer["Спочатку низька комісія"]</option>
                    <option value="CommissionDesc" selected="@(Model.Filter.SortOption == Marketplace.Domain.Enums.BusinessSortOption.CommissionDesc)">@Localizer["Спочатку висока комісія"]</option>
                </select>
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Застосувати"]</button>
            </form>

            @if (businesses.Count == 0)
            {
                <div class="admin-panel">
                    <p class="admin-empty">@Localizer["Нічого не знайдено за цим запитом."]</p>
                </div>
            }
            else
            {
                <div class="admin-panel table-responsive">
                    <table class="table admin-table" id="businesses-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Магазин"]</th>
                                <th>@Localizer["Власник"]</th>
                                <th>@Localizer["Статус"]</th>
                                <th>@Localizer["Комісія"]</th>
                                <th class="text-end">@Localizer["Дії"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var business in businesses)
                            {
                                var statusClass = business.Status.ToString().ToLowerInvariant();
                                var name = string.IsNullOrWhiteSpace(business.Name) ? Localizer["Без назви"].Value : business.Name;
                                var businessInitial = name[..1].ToUpperInvariant();

                                <tr>
                                    <td>
                                        <a asp-action="BusinessDetails" asp-route-businessId="@business.Id" class="admin-entity-cell admin-entity-cell--clickable">
                                            @if (!string.IsNullOrWhiteSpace(business.LogoUrl))
                                            {
                                                <img class="admin-entity-thumb" src="@business.LogoUrl" alt="@name" />
                                            }
                                            else
                                            {
                                                <div class="admin-entity-placeholder" aria-hidden="true">@businessInitial</div>
                                            }
                                            <span class="admin-entity-name">@name</span>
                                        </a>
                                    </td>
                                    <td class="admin-entity-meta">@business.Owner</td>
                                    <td><span class="admin-status admin-status--@statusClass">@StatusLabel(business.Status)</span></td>
                                    <td>
                                        <form asp-action="ChangeBusinessCommission" method="post" class="admin-inline-form">
                                            <input type="hidden" name="businessId" value="@business.Id" />
                                            <input type="number" name="commissionPercent" min="0" max="100" step="0.1" value="@business.CommissionPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="admin-inline-form__input" aria-label="@Localizer["Комісія, %"]" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">%</button>
                                        </form>
                                    </td>
                                    <td>
                                        <div class="admin-row-actions">
                                            @if (business.Status != Marketplace.Domain.Enums.BusinessStatus.Active)
                                            {
                                                <form asp-action="ChangeBusinessStatus" method="post">
                                                    <input type="hidden" name="businessId" value="@business.Id" />
                                                    <input type="hidden" name="status" value="Active" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Активувати"]</button>
                                                </form>
                                            }
                                            @if (business.Status != Marketplace.Domain.Enums.BusinessStatus.Suspended)
                                            {
                                                <form asp-action="ChangeBusinessStatus" method="post">
                                                    <input type="hidden" name="businessId" value="@business.Id" />
                                                    <input type="hidden" name="status" value="Suspended" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Призупинити"]</button>
                                                </form>
                                            }
                                            @if (business.Status != Marketplace.Domain.Enums.BusinessStatus.Rejected)
                                            {
                                                <form asp-action="ChangeBusinessStatus" method="post">
                                                    <input type="hidden" name="businessId" value="@business.Id" />
                                                    <input type="hidden" name="status" value="Rejected" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Відхилити"]</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <partial name="_AdminPagination" model="new Marketplace.Web.Models.AdminPaginationViewModel { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages }" />
                </div>
            }
        </div>
    </div>
</div>
