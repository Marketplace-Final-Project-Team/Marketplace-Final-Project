@model Marketplace.Web.Models.AdminBusinessDetailsViewModel

@{
    ViewData["Title"] = $"Бізнес — {Model.StoreName}";
}

<div class="container py-4">
    <a asp-action="Businesses" class="d-inline-block mb-3">← До списку бізнесів</a>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" style="width:56px;height:56px;object-fit:cover;border-radius:8px;" alt="@Model.StoreName" />
                    }
                    <div>
                        <h4 class="mb-0">@Model.StoreName</h4>
                        <span class="badge bg-secondary">@Model.Status</span>
                    </div>
                </div>
                <div class="card-body">
                    <p>@Model.Description</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Власник</dt>
                        <dd class="col-sm-8">@Model.OwnerEmail</dd>

                        <dt class="col-sm-4">Дата створення</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Комісія</dt>
                        <dd class="col-sm-8">@Model.CommissionPercent%</dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Товари</div>
                <div class="card-body d-flex gap-4">
                    <div><strong>@Model.TotalProductCount</strong><div class="text-muted small">Усього</div></div>
                    <div><strong>@Model.ActiveProductCount</strong><div class="text-muted small">Активні</div></div>
                    <div><strong>@Model.PendingProductCount</strong><div class="text-muted small">На модерації</div></div>
                    <div><strong>@Model.BannedProductCount</strong><div class="text-muted small">Заблоковані</div></div>
                </div>
            </div>

            @if (Model.HasActiveDiscount)
            {
                <div class="card mb-4">
                    <div class="card-header">Знижка на весь бізнес</div>
                    <div class="card-body">
                        <p class="mb-0">
                            Активна знижка <strong>-@Model.DiscountPercent%</strong>
                            до <strong>@Model.DiscountEndDate?.ToLocalTime().ToString("dd.MM.yyyy")</strong>
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Статус магазину</div>
                <div class="card-body">
                    <form asp-action="ChangeBusinessStatus" method="post" class="d-flex flex-column gap-2">
                        <input type="hidden" name="businessId" value="@Model.Id" />
                        <select name="status" class="form-select">
                            @foreach (var s in Enum.GetValues<Marketplace.Domain.Enums.BusinessStatus>())
                            {
                                <option value="@s" selected="@(s == Model.Status)">@s</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Змінити статус</button>
                    </form>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Комісія</div>
                <div class="card-body">
                    <form asp-action="ChangeBusinessCommission" method="post" class="d-flex gap-2">
                        <input type="hidden" name="businessId" value="@Model.Id" />
                        <input type="number" name="commissionPercent" value="@Model.CommissionPercent" min="0" max="100" step="0.1" class="form-control" />
                        <button type="submit" class="btn btn-primary btn-sm">Зберегти</button>
                    </form>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">Статус 18+</div>
                <div class="card-body">
                    <p>Поточний статус: <strong>@Model.AdultStatus</strong></p>
                    @if (!string.IsNullOrWhiteSpace(Model.AdultRejectionReason))
                    {
                        <p class="text-muted small">Причина відхилення: @Model.AdultRejectionReason</p>
                    }

                    @if (Model.AdultStatus == Marketplace.Domain.Entities.AdultContentStatus.Pending)
                    {
                        <form asp-action="ApproveAdultStatus" method="post" class="mb-2">
                            <input type="hidden" name="businessId" value="@Model.Id" />
                            <button type="submit" class="btn btn-success btn-sm w-100">Підтвердити 18+</button>
                        </form>
                        <form asp-action="RejectAdultStatus" method="post">
                            <input type="hidden" name="businessId" value="@Model.Id" />
                            <input type="text" name="reason" placeholder="Причина відхилення" class="form-control form-control-sm mb-2" required />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Відхилити</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
