@model Marketplace.Web.Models.AdminBusinessDetailsViewModel

@{
    ViewData["Title"] = $"{Model.StoreName} - Адмін-панель";
    var statusClass = Model.Status.ToString().ToLowerInvariant();

    string StatusLabel(Marketplace.Domain.Enums.BusinessStatus status) => status switch
    {
        Marketplace.Domain.Enums.BusinessStatus.Pending => "На перевірці",
        Marketplace.Domain.Enums.BusinessStatus.Active => "Активний",
        Marketplace.Domain.Enums.BusinessStatus.Suspended => "Призупинений",
        Marketplace.Domain.Enums.BusinessStatus.Rejected => "Відхилений",
        _ => status.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="admin-shell">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <a asp-action="Businesses" class="btn btn-sm btn-outline-secondary">← До списку бізнесів</a>

            <header class="admin-header">
                <div class="admin-entity-cell">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <img class="admin-entity-thumb" src="@Model.LogoUrl" alt="@Model.StoreName" />
                    }
                    else
                    {
                        <div class="admin-entity-placeholder" aria-hidden="true">@Model.StoreName[..1].ToUpperInvariant()</div>
                    }
                    <div>
                        <div class="admin-kicker">Admin</div>
                        <h1 class="admin-title">@Model.StoreName</h1>
                        <span class="admin-status admin-status--@statusClass">@StatusLabel(Model.Status)</span>
                    </div>
                </div>
            </header>

            @if (TempData["Success"] is string success)
            {
                <div class="admin-alert"><span>✓</span><p>@success</p></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="admin-alert admin-alert--error"><span>!</span><p>@error</p></div>
            }

            <section class="admin-panel" style="padding: 1.25rem 1.5rem;">
                <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Опис відсутній." : Model.Description)</p>
                <p class="admin-entity-meta">Власник: <strong>@Model.OwnerEmail</strong></p>
                <p class="admin-entity-meta">Дата реєстрації: @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
            </section>

            <div class="admin-stats" aria-label="Показники магазину">
                <div class="admin-stat-card">
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Товари всього</span>
                        <strong class="admin-stat-card__value">@Model.TotalProductCount</strong>
                        <span class="admin-stat-card__hint">Активні: @Model.ActiveProductCount · На модерації: @Model.PendingProductCount · Заблоковані: @Model.BannedProductCount</span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Замовлення всього</span>
                        <strong class="admin-stat-card__value">@Model.TotalOrders</strong>
                        <span class="admin-stat-card__hint">Продано одиниць: @Model.SoldItems</span>
                    </div>
                </div>
                <div class="admin-stat-card">
                    <div class="admin-stat-card__body">
                        <span class="admin-stat-card__label">Виручка магазину</span>
                        <strong class="admin-stat-card__value">@Model.Revenue.ToString("N0") ₴</strong>
                        <span class="admin-stat-card__hint">За весь час</span>
                    </div>
                </div>
            </div>

            <div class="admin-two-col">
                <section class="admin-panel" style="padding: 1.25rem 1.5rem;">
                    <h2 class="admin-title" style="font-size: 1.1rem;">Комісія</h2>
                    <form asp-action="ChangeBusinessCommission" method="post" class="admin-inline-form">
                        <input type="hidden" name="businessId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("BusinessDetails", new { businessId = Model.Id })" />
                        <input type="number" name="commissionPercent" min="0" max="100" step="0.1" value="@Model.CommissionPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="admin-inline-form__input" aria-label="Комісія, %" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Зберегти</button>
                    </form>
                </section>

                <section class="admin-panel" style="padding: 1.25rem 1.5rem;">
                    <h2 class="admin-title" style="font-size: 1.1rem;">Статус магазину</h2>
                    <form asp-action="ChangeBusinessStatus" method="post" class="admin-inline-form">
                        <input type="hidden" name="businessId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("BusinessDetails", new { businessId = Model.Id })" />
                        <select name="status" class="form-select">
                            @foreach (var s in Enum.GetValues<Marketplace.Domain.Enums.BusinessStatus>())
                            {
                                <option value="@s" selected="@(s == Model.Status)">@StatusLabel(s)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Змінити</button>
                    </form>
                </section>
            </div>

            <section class="admin-panel" style="padding: 1.25rem 1.5rem;">
                <h2 class="admin-title" style="font-size: 1.1rem;">Знижки</h2>
                <p class="admin-subtitle">Знижки встановлює сам продавець у своїй панелі - тут лише перегляд.</p>

                @if (Model.BusinessDiscount?.IsActive == true)
                {
                    <p><span class="admin-status admin-status--active">Весь магазин −@Model.BusinessDiscount.DiscountPercent.ToString("0.##")%</span> до @Model.BusinessDiscount.EndDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                }
                else
                {
                    <p class="admin-entity-meta">Знижки на весь магазин зараз немає.</p>
                }

                @if (Model.CategoryDiscounts.Any())
                {
                    <ul style="margin: 0.5rem 0 0; padding-left: 1.1rem;">
                        @foreach (var cd in Model.CategoryDiscounts)
                        {
                            <li>@cd.CategoryName: −@cd.DiscountPercent.ToString("0.##")% до @cd.EndDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</li>
                        }
                    </ul>
                }
            </section>

            @if (Model.AdultStatus != Marketplace.Domain.Entities.AdultContentStatus.None)
            {
                <section class="admin-panel" style="padding: 1.25rem 1.5rem;">
                    <h2 class="admin-title" style="font-size: 1.1rem;">Статус 18+</h2>
                    <p>Поточний статус: <strong>@Model.AdultStatus</strong></p>
                    @if (!string.IsNullOrWhiteSpace(Model.AdultRejectionReason))
                    {
                        <p class="admin-entity-meta">Причина відхилення: @Model.AdultRejectionReason</p>
                    }

                    @if (Model.AdultStatus == Marketplace.Domain.Entities.AdultContentStatus.Pending)
                    {
                        <form asp-action="ApproveAdultStatus" method="post" class="mb-2">
                            <input type="hidden" name="businessId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Підтвердити 18+</button>
                        </form>
                        <form asp-action="RejectAdultStatus" method="post" class="admin-inline-form">
                            <input type="hidden" name="businessId" value="@Model.Id" />
                            <input type="text" name="reason" placeholder="Причина відхилення" class="admin-inline-form__input" required />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Відхилити</button>
                        </form>
                    }
                </section>
            }
        </div>
    </div>
</div>
