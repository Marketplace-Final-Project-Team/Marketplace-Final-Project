@model List<Marketplace.BLL.DTOs.RefundChatMessageDto>
@{
    ViewData["Title"] = Localizer["Чат підтримки з приводу повернення"].Value;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var requestId = (Guid)ViewBag.RequestId;
    var isSellerChannel = (bool)ViewBag.IsSellerChannel;
    var backUrl = ViewBag.BackUrl as string ?? "/Order";
    var backLabel = Localizer[ViewBag.BackLabel as string ?? "← До моїх замовлень"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support-chat.css" asp-append-version="true" />
}

<div class="shop-page support-chat-page">
    <div class="support-chat-shell">
        <header class="chat-header">
            <div class="chat-header__identity">
                <span class="chat-header__avatar" aria-hidden="true">↩</span>
                <div>
                    <span class="chat-header__eyebrow">@Localizer["Повернення товару"]</span>
                    <h1>@Localizer["Чат щодо повернення"]</h1>
                    <span class="chat-header__status"><i aria-hidden="true"></i> @(isSellerChannel ? Localizer["Канал із продавцем"] : Localizer["Канал із покупцем"])</span>
                </div>
            </div>
            <a href="@backUrl" class="chat-action">@backLabel</a>
        </header>

        <section class="chat-context chat-context--product" aria-label="@Localizer["Товар і замовлення"]">
            <span class="chat-context__icon" aria-hidden="true">#</span>
            <div>
                <small>@Localizer["Замовлення"] #@ViewBag.OrderNumber</small>
                <strong>@ViewBag.ItemName</strong>
                <p>@Localizer["Обговорюйте тут статус і деталі повернення цього товару."]</p>
            </div>
        </section>

        <div class="chat-messages" id="chatMessages">
            @foreach (var msg in Model)
            {
                var isOutgoing = (isAdmin && msg.IsFromAdmin) || (!isAdmin && !msg.IsFromAdmin);
                <div class="chat-message @(isOutgoing ? "outgoing" : "incoming")">
                    <div>@msg.Text</div>
                    <time>@msg.SentAt.ToLocalTime().ToString("HH:mm")</time>
                </div>
            }
        </div>

        <footer class="chat-composer">
            <div class="chat-quick-replies" aria-label="@Localizer["Швидкі відповіді"]">
                <button type="button" data-chat-quick-reply data-text="@Localizer["Підкажіть, будь ласка, поточний статус повернення."]">@Localizer["Уточнити статус"]</button>
                <button type="button" data-chat-quick-reply data-text="@Localizer["Я вже відправив товар і можу надати номер накладної."]">@Localizer["Товар відправлено"]</button>
                <button type="button" data-chat-quick-reply data-text="@Localizer["Дякую, питання вирішено."]">@Localizer["Питання вирішено"]</button>
            </div>
            <div class="chat-input-area">
                <input type="text" id="messageInput" class="form-control" placeholder="@Localizer["Напишіть повідомлення..."]" autocomplete="off" />
                <button type="button" id="sendButton" class="chat-send" aria-label="@Localizer["Надіслати повідомлення"]">@Localizer["Надіслати"] <span aria-hidden="true">→</span></button>
            </div>
        </footer>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const requestId = "@requestId";
        const isSellerChannel = @Json.Serialize(isSellerChannel);
        const currentIsAdmin = @Json.Serialize(isAdmin);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/refundChatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (msg) {
            const messagesContainer = document.getElementById("chatMessages");

            const isOutgoing = (currentIsAdmin && msg.isFromAdmin) || (!currentIsAdmin && !msg.isFromAdmin);

            const timeFormatted = new Date(msg.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const messageDiv = document.createElement("div");
            messageDiv.className = `chat-message ${isOutgoing ? "outgoing" : "incoming"}`;
            messageDiv.innerHTML = `
                <div>${escapeHtml(msg.text)}</div>
                <time>${timeFormatted}</time>
            `;

            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinChat", requestId, isSellerChannel).catch(err => console.error(err));
        }).catch(err => console.error(err));

        document.getElementById("sendButton").addEventListener("click", sendMessage);
        document.getElementById("messageInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                sendMessage();
            }
        });

        document.querySelectorAll("[data-chat-quick-reply]").forEach(function (button) {
        button.addEventListener("click", function () {
        const input = document.getElementById("messageInput");
        input.value = button.dataset.text;
        input.focus();
        });
        });

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const text = input.value.trim();
            if (!text) return;

            connection.invoke("SendMessage", requestId, isSellerChannel, text)
                .then(() => {
                    input.value = "";
                })
                .catch(err => console.error(err));
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        const container = document.getElementById("chatMessages");
        container.scrollTop = container.scrollHeight;
    </script>
}
