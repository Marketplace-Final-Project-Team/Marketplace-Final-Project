@model List<Marketplace.BLL.DTOs.SupportTicketMessageDto>
@{
    ViewData["Title"] = "Чат з підтримкою";
    var isAdmin = (bool)ViewBag.IsAdmin;
    var ticketId = (Guid)ViewBag.TicketId;
    var category = (string)ViewBag.Category;
}

@section Styles {
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support-chat.css" asp-append-version="true" />
}

<div class="shop-page support-chat-page">
    <div class="support-chat-shell">
        <header class="chat-header">
            <div class="chat-header__identity">
                <span class="chat-header__avatar" aria-hidden="true">?</span>
                <div>
                    <span class="chat-header__eyebrow">Звернення до підтримки</span>
                    <h1>Чат з підтримкою</h1>
                    <span class="chat-header__status"><i aria-hidden="true"></i> Захищений чат</span>
                </div>
            </div>
            <div class="chat-header__actions">
                @if (isAdmin)
                {
                    <form asp-action="CloseTicket" method="post" class="d-inline">
                        <input type="hidden" name="ticketId" value="@ticketId" />
                        <button type="submit" class="chat-action chat-action--danger" onclick="return confirm('Закрити це звернення?');">Закрити звернення</button>
                    </form>
                    <a asp-controller="Admin" asp-action="Jobs" class="chat-action">← До задач</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Support" class="chat-action">← До підтримки</a>
                }
            </div>
        </header>

        <section class="chat-context" aria-label="Контекст звернення">
            <span class="chat-context__icon" aria-hidden="true">i</span>
            <div>
                <small>Тема звернення</small>
                <strong>@category</strong>
                <p>Історія повідомлень зберігається у цьому зверненні.</p>
            </div>
        </section>

        <div class="chat-messages" id="chatMessages">
            @foreach (var msg in Model)
            {
                var isOutgoing = (isAdmin && msg.IsFromAdmin) || (!isAdmin && !msg.IsFromAdmin);
                <div class="chat-message @(isOutgoing ? "outgoing" : "incoming")">
                    <div>@msg.Text</div>
                    <time>@msg.SentAt.ToLocalTime().ToString("HH:mm")</time>
                </div>
            }
        </div>

        <footer class="chat-composer">
            <div class="chat-quick-replies" aria-label="Швидкі відповіді">
                <button type="button" data-chat-quick-reply data-text="Добрий день! Уточніть, будь ласка, деталі.">Уточнити деталі</button>
                <button type="button" data-chat-quick-reply data-text="Дякую, очікую на відповідь.">Очікую відповідь</button>
                <button type="button" data-chat-quick-reply data-text="Дякую, питання вирішено.">Питання вирішено</button>
            </div>
            <div class="chat-input-area">
                <input type="text" id="messageInput" class="form-control" placeholder="Напишіть повідомлення..." autocomplete="off" />
                <button type="button" id="sendButton" class="chat-send" aria-label="Надіслати повідомлення">Надіслати <span aria-hidden="true">→</span></button>
            </div>
        </footer>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const ticketId = "@ticketId";
        const currentIsAdmin = @Json.Serialize(isAdmin);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/supportTicketChatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (msg) {
            const messagesContainer = document.getElementById("chatMessages");
            const isOutgoing = (currentIsAdmin && msg.isFromAdmin) || (!currentIsAdmin && !msg.isFromAdmin);
            const timeFormatted = new Date(msg.sentAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const messageDiv = document.createElement("div");
            messageDiv.className = `chat-message ${isOutgoing ? "outgoing" : "incoming"}`;
            messageDiv.innerHTML = `
                <div>${escapeHtml(msg.text)}</div>
                <time>${timeFormatted}</time>
            `;

            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinChat", ticketId).catch(err => console.error(err));
        }).catch(err => console.error(err));

        document.getElementById("sendButton").addEventListener("click", sendMessage);
        document.getElementById("messageInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                sendMessage();
            }
        });

        document.querySelectorAll("[data-chat-quick-reply]").forEach(function (button) {
            button.addEventListener("click", function () {
                const input = document.getElementById("messageInput");
                input.value = button.dataset.text;
                input.focus();
            });
        });

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const text = input.value.trim();
            if (!text) return;

            connection.invoke("SendMessage", ticketId, text)
                .then(() => { input.value = ""; })
                .catch(err => console.error(err));
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        const container = document.getElementById("chatMessages");
        container.scrollTop = container.scrollHeight;
    </script>
}
