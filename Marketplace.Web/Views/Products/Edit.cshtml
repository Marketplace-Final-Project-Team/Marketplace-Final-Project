@model Marketplace.Web.Models.Products.ProductEditViewModel

@{
    ViewData["Title"] = Localizer["Редагування товару"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="products-page">
    <a asp-action="Details" asp-route-id="@Model.Id" class="products-back">← @Localizer["Назад до товару"]</a>
    <header class="products-heading">
        <div>
            <div class="products-eyebrow">@Localizer["Редагування"]</div>
            <h1 class="products-title">@Model.Name</h1>
            <p class="products-subtitle">@Localizer["Оновіть дані товару. Після збереження він знову перейде на модерацію."]</p>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="product-form-shell">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="products-panel w-100">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <section class="product-form-section">
                <h2>@Localizer["Основна інформація"]</h2>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">@Localizer["Назва товару"]</label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Description" class="form-label">@Localizer["Опис"]</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </section>

            <section class="product-form-section">
                <h2>@Localizer["Продаж і класифікація"]</h2>
                <div class="product-field-grid">
                    <div>
                        <label asp-for="CategoryId" class="form-label">@Localizer["Категорія"]</label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Price" class="form-label">@Localizer["Ціна, ₴"]</label>
                        <input asp-for="Price" class="form-control" inputmode="decimal" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div data-quantity-field>
                        <label asp-for="Quantity" class="form-label">@Localizer["Кількість, шт."]</label>
                        <input asp-for="Quantity" class="form-control" inputmode="numeric" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Sku" class="form-label">@Localizer["Артикул (SKU)"]</label>
                        <input asp-for="Sku" class="form-control" placeholder="@Localizer["Наприклад, TS-BLK-001"]" />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>
                </div>
            </section>

            <section class="product-form-section">
                <h2>@Localizer["Зображення"]</h2>

                @if (!string.IsNullOrWhiteSpace(Model.ExistingMainImageUrl))
                {
                    <div class="mb-3">
                        <div class="form-label">@Localizer["Поточне головне фото"]</div>
                        <img src="@Model.ExistingMainImageUrl" class="product-current-image" alt="@Model.Name" />
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="MainImage" class="form-label">@Localizer["Замінити головне фото"]</label>
                    <input asp-for="MainImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="MainImage" class="text-danger small"></span>
                </div>
                @if (Model.ExistingAdditionalImages.Count > 0)
                {
                    <div class="mb-3">
                        <div class="form-label">@Localizer["Поточні додаткові фото"]</div>
                        <p class="product-help">@Localizer["Позначте фото, які потрібно видалити, і збережіть зміни."]</p>
                        <div class="product-existing-gallery">
                            @foreach (var image in Model.ExistingAdditionalImages)
                            {
                                var markedForRemoval = Model.RemovedAdditionalImageIds.Contains(image.Id);
                                <label class="product-existing-image @(markedForRemoval ? "is-marked-for-removal" : null)">
                                    <img src="@image.ImageUrl" alt="@Localizer["Додаткове фото товару"] @Model.Name" />
                                    <span>
                                        <input type="checkbox"
                                               name="RemovedAdditionalImageIds"
                                               value="@image.Id"
                                               checked="@markedForRemoval" />
                                        @Localizer["Видалити"]
                                    </span>
                                </label>
                            }
                        </div>
                    </div>
                }
                <div>
                    <label asp-for="AdditionalImages" class="form-label">@Localizer["Додати ще фото"]</label>
                    <input asp-for="AdditionalImages" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple />
                    <p class="product-help">@Localizer["JPG, PNG або WEBP, до 5 МБ кожне."]</p>
                    <span asp-validation-for="AdditionalImages" class="text-danger small"></span>
                </div>
            </section>

            <div class="product-form-actions">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@Localizer["Скасувати"]</a>
                <button type="submit" class="btn btn-primary">@Localizer["Зберегти зміни"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.product-existing-image input[type="checkbox"]').forEach((checkbox) => {
            checkbox.addEventListener('change', () => {
                checkbox.closest('.product-existing-image')?.classList.toggle('is-marked-for-removal', checkbox.checked);
            });
        });
    </script>
}
