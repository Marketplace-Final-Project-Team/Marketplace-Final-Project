@model Marketplace.Web.Models.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    var statusClass = Model.Status.ToLowerInvariant();
    var statusLabel = Model.Status switch
    {
        "Active" => Localizer["Активний"].Value,
        "Pending" => Localizer["На модерації"].Value,
        "Banned" => Localizer["Заблокований"].Value,
        _ => Model.Status
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="products-page">
    <a asp-action="Index" class="products-back">← @Localizer["Назад до товарів"]</a>
    <header class="products-heading">
        <div>
            <div class="products-eyebrow">@Localizer["Картка товару"]</div>
            <h1 class="products-title">@Model.Name</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Редагувати"]</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">@Localizer["Видалити"]</a>
        </div>
    </header>

    @if (Model.Status == "Banned" && !string.IsNullOrWhiteSpace(Model.ModerationReason))
    {
        <div class="alert alert-danger" role="alert">
            <strong>@Localizer["Товар заблоковано автоматичною модерацією."]</strong> @Model.ModerationReason
        </div>
    }

    <div class="products-panel product-details-grid">
        <div class="product-detail-media">
            @if (!string.IsNullOrWhiteSpace(Model.MainImageUrl))
            {
                <img src="@Model.MainImageUrl" alt="@Model.Name" />
            }
            else
            {
                <div class="product-detail-placeholder">
                    <span aria-hidden="true">□</span>
                    @Localizer["Фото ще не додано"]
                </div>
            }
        </div>

        <div class="product-detail-content">
            <span class="product-status product-status--@statusClass">@statusLabel</span>
            <div class="product-detail-price">@Model.Price.ToString("N2") ₴</div>
            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? Localizer["Опис не додано."] : Model.Description)</p>

            <div class="product-meta">
                <div class="product-meta__row">
                    <span class="product-meta__label">@Localizer["Категорія"]</span>
                    <strong>@SharedLocalizer[Model.CategoryName]</strong>
                </div>
                <div class="product-meta__row">
                    <span class="product-meta__label">@Localizer["Кількість"]</span>
                    <strong>@Model.Quantity @Localizer["шт."]</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Sku))
                {
                    <div class="product-meta__row">
                        <span class="product-meta__label">@Localizer["Артикул (SKU)"]</span>
                        <strong>@Model.Sku</strong>
                    </div>
                }
                <div class="product-meta__row">
                    <span class="product-meta__label">ID</span>
                    <span class="small text-break">@Model.Id</span>
                </div>
            </div>

            @if (Model.Variants.Count > 0)
            {
                <div class="product-meta mt-3">
                    <span class="product-meta__label d-block mb-2">@Localizer["Розміри"]</span>
                    @foreach (var variant in Model.Variants)
                    {
                        <div class="product-meta__row">
                            <span class="product-meta__label">@variant.Size @(string.IsNullOrWhiteSpace(variant.Sku) ? "" : $"({variant.Sku})")</span>
                            <strong>@variant.Quantity @Localizer["шт."]</strong>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.AdditionalImageUrls.Any())
    {
        <section class="products-panel mt-3">
            <div class="product-form-section">
                <h2 class="mb-0">@Localizer["Додаткові фото"]</h2>
            </div>
            <div class="product-gallery">
                @foreach (var url in Model.AdditionalImageUrls)
                {
                    <img src="@url" alt="@Localizer["Додаткове фото товару"] @Model.Name" />
                }
            </div>
        </section>
    }
</div>
