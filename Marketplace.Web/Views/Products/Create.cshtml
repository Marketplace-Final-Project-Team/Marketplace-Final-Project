@model Marketplace.Web.Models.Products.ProductCreateViewModel

@{
    ViewData["Title"] = "Новий товар";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="products-page">
    <a asp-action="Index" class="products-back">← Назад до товарів</a>
    <header class="products-heading">
        <div>
            <div class="products-eyebrow">Новий запис</div>
            <h1 class="products-title">Додати товар</h1>
            <p class="products-subtitle">Заповніть основні поля. Після створення товар отримає статус «На модерації».</p>
        </div>
    </header>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="product-form-shell">
            <div class="products-panel">
                <section class="product-form-section">
                    <h2>Основна інформація</h2>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Назва товару</label>
                        <input asp-for="Name" class="form-control" placeholder="Наприклад, Бездротові навушники" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Description" class="form-label">Опис</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Коротко опишіть товар та його переваги"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </section>

                <section class="product-form-section">
                    <h2>Продаж і класифікація</h2>
                    <div class="product-field-grid">
                        <div>
                            <label asp-for="BusinessId" class="form-label">Бізнес</label>
                            <select asp-for="BusinessId" asp-items="Model.Businesses" class="form-select">
                                <option value="">Оберіть бізнес</option>
                            </select>
                            <span asp-validation-for="BusinessId" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="CategoryId" class="form-label">Категорія</label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">Оберіть категорію</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="Price" class="form-label">Ціна, ₴</label>
                            <input asp-for="Price" class="form-control" inputmode="decimal" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="Quantity" class="form-label">Кількість, шт.</label>
                            <input asp-for="Quantity" class="form-control" inputmode="numeric" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>
                </section>

                <section class="product-form-section">
                    <h2>Зображення</h2>
                    <div class="mb-3">
                        <label asp-for="MainImage" class="form-label">Головне фото</label>
                        <input asp-for="MainImage" type="file" class="form-control" accept="image/*" />
                        <div class="product-help">Необов’язково. Одне зображення для картки товару.</div>
                    </div>
                    <div>
                        <label asp-for="AdditionalImages" class="form-label">Додаткові фото</label>
                        <input asp-for="AdditionalImages" type="file" class="form-control" accept="image/*" multiple />
                        <div class="product-help">Можна вибрати декілька файлів.</div>
                    </div>
                </section>

                <div class="product-form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
                    <button type="submit" class="btn btn-primary">Створити товар</button>
                </div>
            </div>

            <aside>
                <div class="product-note">
                    <strong>Тестовий CRUD</strong>
                    Тут достатньо назви, опису, категорії, ціни та кількості. Фото можна додати пізніше.
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
