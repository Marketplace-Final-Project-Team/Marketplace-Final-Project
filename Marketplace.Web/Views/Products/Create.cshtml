@model Marketplace.Web.Models.Products.ProductCreateViewModel
@{
    ViewData["Title"] = "Новий товар";
}

<h1>Новий товар</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="BusinessId" class="form-label">Бізнес</label>
        <select asp-for="BusinessId" asp-items="Model.Businesses" class="form-select">
            <option value="">-- Оберіть бізнес --</option>
        </select>
        <span asp-validation-for="BusinessId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Категорія</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">-- Оберіть категорію --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MainImage" class="form-label">Головне фото</label>
        <input asp-for="MainImage" type="file" class="form-control" accept="image/*" />
    </div>

    <div class="mb-3">
        <label asp-for="AdditionalImages" class="form-label">Додаткові фото</label>
        <input asp-for="AdditionalImages" type="file" class="form-control" accept="image/*" multiple />
    </div>

    <button type="submit" class="btn btn-primary">Створити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
