@model IEnumerable<Marketplace.Web.Models.Products.ProductListItemViewModel>

@{
    ViewData["Title"] = SharedLocalizer["Мої товари"];
    var products = Model.ToList();
    var businessOptions = ViewBag.Businesses as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var activeCount = products.Count(product => product.Status == "Active");
    var pendingCount = products.Count(product => product.Status == "Pending");
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}
<div class="products-page">
    <header class="products-heading">
        <div>
            <div class="products-eyebrow">@Localizer["Панель продавця"]</div>
            <h1 class="products-title">@SharedLocalizer["Мої товари"]</h1>
            <p class="products-subtitle">@Localizer["Керуйте асортиментом: додавайте нові товари, редагуйте наявні та стежте за їхнім статусом."]</p>
        </div>
        @if (businessOptions.Any())
        {
            <a asp-action="Create" class="btn btn-primary">+ @Localizer["Додати товар"]</a>
        }
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (businessOptions.Any())
    {
        <div class="products-toolbar">
            <form asp-action="Index" method="get" class="products-business-form">
                <div>
                    <label for="businessId" class="form-label">@Localizer["Поточний бізнес"]</label>
                    <select id="businessId" name="businessId" asp-items="businessOptions" class="form-select"></select>
                </div>
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Показати"]</button>
            </form>
            <span class="text-secondary small">@Localizer["Зміни зберігаються одразу"]</span>
        </div>

        <div class="products-stats" aria-label="@Localizer["Статистика товарів"]">
            <div class="products-stat">
                <span class="products-stat__value">@products.Count</span>
                <span class="products-stat__label">@Localizer["Усього товарів"]</span>
            </div>
            <div class="products-stat">
                <span class="products-stat__value">@activeCount</span>
                <span class="products-stat__label">@Localizer["Активні"]</span>
            </div>
            <div class="products-stat">
                <span class="products-stat__value">@pendingCount</span>
                <span class="products-stat__label">@Localizer["Очікують модерації"]</span>
            </div>
        </div>
    }

    @if (products.Count == 0)
    {
        <section class="product-empty">
            <div class="product-empty__icon" aria-hidden="true">□</div>
            <h2>@Localizer["Товарів поки немає"]</h2>
            @if (businessOptions.Any())
            {
                <p>@Localizer["Додайте свій перший товар, щоб він з'явився в каталозі."]</p>
                <a asp-action="Create" class="btn btn-primary">@Localizer["Створити перший товар"]</a>
            }
            else
            {
                <p>@Localizer["Спочатку створіть бізнес або отримайте доступ до керування товарами."]</p>
                <a asp-controller="Business" asp-action="Create" class="btn btn-primary">@Localizer["Створити бізнес"]</a>
            }
        </section>
    }
    else
    {
        <div class="products-panel table-responsive">
            <table class="table products-table">
                <thead>
                    <tr>
                        <th>@Localizer["Товар"]</th>
                        <th>@Localizer["Ціна"]</th>
                        <th>@Localizer["Залишок"]</th>
                        <th>@Localizer["Статус"]</th>
                        <th class="text-end">@Localizer["Дії"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in products)
                    {
                        var statusClass = item.Status.ToLowerInvariant();
                        var statusLabel = item.Status switch
                        {
                            "Active" => Localizer["Активний"].Value,
                            "Pending" => Localizer["На модерації"].Value,
                            "Banned" => Localizer["Заблокований"].Value,
                            _ => item.Status
                        };

                        <tr>
                            <td>
                                <div class="product-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                                    {
                                        <img class="product-thumb" src="@item.MainImageUrl" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder" aria-hidden="true">@item.Name[..1].ToUpperInvariant()</div>
                                    }
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="product-name">@item.Name</a>
                                        <div class="product-category">@(string.IsNullOrWhiteSpace(item.CategoryName) ? Localizer["Без категорії"].Value : SharedLocalizer[item.CategoryName].Value)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    @if (item.DiscountPercent > 0)
                                    {
                                        var discountedPrice = item.Price * (1 - (item.DiscountPercent / 100m));
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold text-danger">@discountedPrice.ToString("N2") ₴</span>
                                            <span class="text-muted text-decoration-line-through small">@item.Price.ToString("N2") ₴</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@item.Price.ToString("N2") ₴</span>
                                    }

                                    @if (item.DiscountPercent > 0)
                                    {
                                        <div class="d-flex align-items-center gap-1 mt-1">
                                            <span class="badge bg-warning text-dark small">
                                                -@item.DiscountPercent%
                                            </span>

                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 text-decoration-none fw-bold"
                                                    style="font-size: 14px; line-height: 1;"
                                                    title="@Localizer["Видалити знижку"]"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteDiscountModal"
                                                    data-product-id="@item.Id"
                                                    data-product-name="@item.Name">
                                                &times;
                                            </button>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold">@item.Quantity</span>
                                <span class="text-secondary small">@Localizer["шт."]</span>
                            </td>
                            <td>
                                <span class="product-status product-status--@statusClass">@statusLabel</span>
                                @if (item.Status == "Banned" && !string.IsNullOrWhiteSpace(item.ModerationReason))
                                {
                                    <div class="product-moderation-reason">@item.ModerationReason</div>
                                }
                            </td>
                            <td>
                                <div class="product-actions justify-content-end align-items-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Переглянути"]</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Редагувати"]</a>

                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark"
                                            data-bs-toggle="modal"
                                            data-bs-target="#discountModal"
                                            data-product-id="@item.Id"
                                            title="@Localizer["Встановити знижку"]">
                                        @Localizer["Знижка"]
                                    </button>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@Localizer["Видалити"]</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


<div class="modal fade" id="discountModal" tabindex="-1" aria-labelledby="discountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Discounts" asp-action="Set" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="discountModalLabel">@Localizer["Керування знижкою"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Закрити"]"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modalProductId" name="productId" />

                    <div class="mb-3">
                        <label for="modalPercent" class="form-label">@Localizer["Відсоток знижки (%)"]</label>
                        <input type="number" id="modalPercent" name="percent" min="1" max="99" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalStartDate" class="form-label">@Localizer["Дата початку"]</label>
                        <input type="date" id="modalStartDate" name="startDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalEndDate" class="form-label">@Localizer["Дата закінчення"]</label>
                        <input type="date" id="modalEndDate" name="endDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Скасувати"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Зберегти знижку"]</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="deleteDiscountModal" tabindex="-1" aria-labelledby="deleteDiscountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Discounts" asp-action="Remove" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDiscountModalLabel">@Localizer["Видалення знижки"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Закрити"]"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteModalProductId" name="productId" />
                    <p class="mb-0">
                        @Localizer["Ви точно хочете видалити знижку на товар"]
                        «<strong id="deleteModalProductName"></strong>»?
                    </p>
                    <p class="text-secondary small mb-0 mt-2">@Localizer["Цю дію не можна скасувати."]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Скасувати"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["Видалити знижку"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const discountModal = document.getElementById('discountModal');
        if (discountModal) {
            discountModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const productId = button.getAttribute('data-product-id');
                const inputProductId = discountModal.querySelector('#modalProductId');
                if (inputProductId) {
                    inputProductId.value = productId;
                }
            });
        }

        const deleteDiscountModal = document.getElementById('deleteDiscountModal');
        if (deleteDiscountModal) {
            deleteDiscountModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const productId = button.getAttribute('data-product-id');
                const productName = button.getAttribute('data-product-name');

                const inputProductId = deleteDiscountModal.querySelector('#deleteModalProductId');
                const nameSpan = deleteDiscountModal.querySelector('#deleteModalProductName');

                if (inputProductId) {
                    inputProductId.value = productId;
                }
                if (nameSpan) {
                    nameSpan.textContent = productName;
                }
            });
        }
    </script>
}
