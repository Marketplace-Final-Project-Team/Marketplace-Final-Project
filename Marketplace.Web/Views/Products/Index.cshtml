@model IEnumerable<Marketplace.Web.Models.Products.ProductListItemViewModel>

@{
    ViewData["Title"] = "Мої товари";
    var businessOptions = ViewBag.Businesses as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<h1>Мої товари</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (businessOptions.Any())
{
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end">
            <div>
                <label for="businessId" class="form-label">Бізнес</label>
                <select id="businessId" name="businessId" asp-items="businessOptions" class="form-select"></select>
            </div>
            <button type="submit" class="btn btn-outline-secondary">Показати</button>
        </form>

        <a asp-action="Create" class="btn btn-primary">+ Додати товар</a>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Фото</th><th>Назва</th><th>Категорія</th>
            <th>Ціна</th><th>Кількість</th><th>Статус</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.MainImageUrl))
                {
                    <img src="@item.MainImageUrl" alt="@item.Name" style="width:60px;height:60px;object-fit:cover;" />
                }
            </td>
            <td>@item.Name</td>
            <td>@item.CategoryName</td>
            <td>@item.Price.ToString("0.00")</td>
            <td>@item.Quantity</td>
            <td>
                <span class="badge bg-@(item.Status == "Active" ? "success" : item.Status == "Pending" ? "warning" : "danger")">
                    @item.Status
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </td>
        </tr>
    }
    </tbody>
</table>
