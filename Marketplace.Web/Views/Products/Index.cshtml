@model IEnumerable<Marketplace.Web.Models.Products.ProductListItemViewModel>

@{
    ViewData["Title"] = "Мої товари";
    var products = Model.ToList();
    var businessOptions = ViewBag.Businesses as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var activeCount = products.Count(product => product.Status == "Active");
    var pendingCount = products.Count(product => product.Status == "Pending");
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="products-page">
    <header class="products-heading">
        <div>
            <div class="products-eyebrow">Seller workspace</div>
            <h1 class="products-title">Мої товари</h1>
            <p class="products-subtitle">Тестова панель для керування асортиментом: створення, перегляд, редагування та видалення товарів.</p>
        </div>
        @if (businessOptions.Any())
        {
            <a asp-action="Create" class="btn btn-primary">+ Додати товар</a>
        }
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (businessOptions.Any())
    {
        <div class="products-toolbar">
            <form asp-action="Index" method="get" class="products-business-form">
                <div>
                    <label for="businessId" class="form-label">Поточний бізнес</label>
                    <select id="businessId" name="businessId" asp-items="businessOptions" class="form-select"></select>
                </div>
                <button type="submit" class="btn btn-outline-secondary">Показати</button>
            </form>
            <span class="text-secondary small">Зміни зберігаються одразу</span>
        </div>

        <div class="products-stats" aria-label="Статистика товарів">
            <div class="products-stat">
                <span class="products-stat__value">@products.Count</span>
                <span class="products-stat__label">Усього товарів</span>
            </div>
            <div class="products-stat">
                <span class="products-stat__value">@activeCount</span>
                <span class="products-stat__label">Активні</span>
            </div>
            <div class="products-stat">
                <span class="products-stat__value">@pendingCount</span>
                <span class="products-stat__label">Очікують модерації</span>
            </div>
        </div>
    }

    @if (products.Count == 0)
    {
        <section class="product-empty">
            <div class="product-empty__icon" aria-hidden="true">□</div>
            <h2>Товарів поки немає</h2>
            @if (businessOptions.Any())
            {
                <p>Створіть перший тестовий товар, щоб перевірити роботу CRUD-операцій.</p>
                <a asp-action="Create" class="btn btn-primary">Створити перший товар</a>
            }
            else
            {
                <p>Спочатку створіть бізнес або отримайте доступ до керування товарами.</p>
                <a asp-controller="Business" asp-action="Create" class="btn btn-primary">Створити бізнес</a>
            }
        </section>
    }
    else
    {
        <div class="products-panel table-responsive">
            <table class="table products-table">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th>Ціна</th>
                        <th>Залишок</th>
                        <th>Статус</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in products)
                    {
                        var statusClass = item.Status.ToLowerInvariant();
                        var statusLabel = item.Status switch
                        {
                            "Active" => "Активний",
                            "Pending" => "На модерації",
                            "Banned" => "Заблокований",
                            _ => item.Status
                        };

                        <tr>
                            <td>
                                <div class="product-cell">
                                    @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                                    {
                                        <img class="product-thumb" src="@item.MainImageUrl" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder" aria-hidden="true">@item.Name[..1].ToUpperInvariant()</div>
                                    }
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="product-name">@item.Name</a>
                                        <div class="product-category">@(string.IsNullOrWhiteSpace(item.CategoryName) ? "Без категорії" : item.CategoryName)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-semibold">@item.Price.ToString("N2") ₴</td>
                            <td>
                                <span class="fw-semibold">@item.Quantity</span>
                                <span class="text-secondary small">шт.</span>
                            </td>
                            <td><span class="product-status product-status--@statusClass">@statusLabel</span></td>
                            <td>
                                <div class="product-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Переглянути</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
