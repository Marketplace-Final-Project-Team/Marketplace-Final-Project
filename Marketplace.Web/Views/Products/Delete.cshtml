@model Marketplace.Web.Models.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = Localizer["Видалення товару"];
    var openOrders = ViewBag.OpenOrders is int count ? count : 0;
    var hasOrders = ViewBag.HasOrders is bool flag && flag;
    var businessId = ViewBag.BusinessId as Guid?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div class="products-page">
    <a asp-action="Index" asp-route-businessId="@businessId" class="products-back">← @Localizer["Назад до списку товарів"]</a>

    <section class="product-delete-card">
        <div class="product-delete-card__accent" aria-hidden="true">!</div>
        <div class="product-delete-card__body">
            <h1>@Localizer["Видалити товар?"]</h1>
            <p class="text-secondary">
                @Localizer["Товар"] <strong class="text-dark">«@Model.Name»</strong> @Localizer["буде видалено зі списку."]
                @Localizer["Цю дію не можна скасувати через інтерфейс."]
            </p>

    

            <div class="product-meta">
                <div class="product-meta__row">
                    <span class="product-meta__label">@Localizer["Категорія"]</span>
                    <strong>@SharedLocalizer[Model.CategoryName]</strong>
                </div>
                <div class="product-meta__row">
                    <span class="product-meta__label">@Localizer["Ціна"]</span>
                    <strong>@Model.Price.ToString("N2") ₴</strong>
                </div>
                <div class="product-meta__row">
                    <span class="product-meta__label">@Localizer["Залишок"]</span>
                    <strong>@Model.Quantity @Localizer["шт."]</strong>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="product-delete-card__actions">
                <a asp-action="Index" asp-route-businessId="@businessId" class="btn btn-outline-secondary">@Localizer["Скасувати"]</a>
                <button type="submit" class="btn btn-danger">@Localizer["Так, видалити"]</button>
            </form>
        </div>
    </section>
</div>