@model Marketplace.Web.Models.Products.ProductDetailsViewModel
@{
    ViewData["Title"] = "Видалення товару";
}

<h1>Видалити товар?</h1>

<div class="alert alert-warning">
    Ви впевнені, що хочете видалити товар "<strong>@Model.Name</strong>"?
</div>

<dl class="row">
    <dt class="col-sm-2">Категорія</dt>
    <dd class="col-sm-10">@Model.CategoryName</dd>
    <dt class="col-sm-2">Ціна</dt>
    <dd class="col-sm-10">@Model.Price.ToString("0.00")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Так, видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>