@model Marketplace.Web.Models.ReviewUpdateViewModel

@{
    ViewData["Title"] = "Редагувати відгук";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reviews.css" asp-append-version="true" />
}

<div class="review-form-page">
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.ProductId" class="review-form-back">← Назад до товару</a>

    <div class="review-form-card">
        <h1>Редагувати відгук</h1>
        <p>Оновіть оцінку чи текст відгуку.</p>

        <form asp-controller="Reviews" asp-action="UpdateReview" method="post">
            <input type="hidden" asp-for="ReviewId" />
            <input type="hidden" asp-for="ProductId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="review-form-field">
                <label>Оцінка</label>
                <div class="star-rating">
                    <input type="radio" asp-for="Rating" value="5" id="update-star-5" />
                    <label for="update-star-5" title="5 з 5">★</label>
                    <input type="radio" asp-for="Rating" value="4" id="update-star-4" />
                    <label for="update-star-4" title="4 з 5">★</label>
                    <input type="radio" asp-for="Rating" value="3" id="update-star-3" />
                    <label for="update-star-3" title="3 з 5">★</label>
                    <input type="radio" asp-for="Rating" value="2" id="update-star-2" />
                    <label for="update-star-2" title="2 з 5">★</label>
                    <input type="radio" asp-for="Rating" value="1" id="update-star-1" />
                    <label for="update-star-1" title="1 з 5">★</label>
                </div>
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="review-form-field">
                <label asp-for="Body">Ваш відгук</label>
                <textarea asp-for="Body" maxlength="300" placeholder="Що вам сподобалось чи не сподобалось?"></textarea>
                <span asp-validation-for="Body" class="text-danger small"></span>
            </div>

            <div class="review-form-actions">
                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Скасувати</a>
                <button type="submit" class="btn btn-primary">Оновити відгук</button>
            </div>
        </form>

        <form asp-controller="Reviews" asp-action="DeleteReview" method="post" class="mt-3" onsubmit="return confirm('Видалити цей відгук?');">
            <input type="hidden" asp-for="ReviewId" />
            <input type="hidden" asp-for="ProductId" />
            <button type="submit" class="btn btn-link text-danger p-0">Видалити відгук</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
