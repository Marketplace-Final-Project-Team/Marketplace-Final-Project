@model Marketplace.Web.Models.CatalogProductViewModel

@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <a asp-action="Index" class="shop-back">← Назад до каталогу</a>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <article class="shop-panel catalog-details">
        <div class="catalog-details__media">
            @if (!string.IsNullOrWhiteSpace(Model.MainImageUrl))
            {
                <img src="@Model.MainImageUrl" alt="@Model.Name" />
            }
            else
            {
                <span aria-hidden="true">@Model.Name[..1].ToUpperInvariant()</span>
            }
        </div>

        <div class="catalog-details__body">
            <div class="shop-kicker">@Model.CategoryName</div>
            <h1>@Model.Name</h1>
            <div class="catalog-details__store">Продавець: <strong>@Model.StoreName</strong></div>
            <p class="catalog-details__description">@Model.Description</p>

            <div class="catalog-details__price">@Model.Price.ToString("N2") ₴</div>
            <div class="stock-label">✓ В наявності — @Model.Quantity шт.</div>

            <div class="catalog-details__actions">
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-primary">Додати до кошика</button>
                </form>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Відкрити кошик</a>
            </div>
        </div>
    </article>
</div>
