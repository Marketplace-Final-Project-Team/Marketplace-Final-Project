@model IReadOnlyList<Marketplace.Web.Models.CatalogProductViewModel>

@{
    ViewData["Title"] = "Каталог товарів";
    var search = ViewBag.Search as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <header class="shop-header">
        <div>
            <div class="shop-kicker">MarketPlace</div>
            <h1 class="shop-title">Каталог товарів</h1>
            <p class="shop-subtitle">Тестова вітрина маркетплейсу. Оберіть товар, перегляньте деталі та додайте його до кошика.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">Перейти до кошика</a>
        }
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <form asp-action="Index" method="get" class="catalog-search" role="search">
        <input name="search" value="@search" class="form-control" placeholder="Пошук за назвою, описом або категорією" aria-label="Пошук товарів" />
        <button type="submit" class="btn btn-primary">Знайти</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
        }
    </form>

    <div class="catalog-meta">Знайдено товарів: <strong>@Model.Count</strong></div>

    @if (Model.Count == 0)
    {
        <section class="shop-empty">
            <div class="shop-empty__icon" aria-hidden="true">⌕</div>
            <h2>Товарів не знайдено</h2>
            <p>Спробуйте змінити пошуковий запит або переглянути весь каталог.</p>
            <a asp-action="Index" class="btn btn-primary">Увесь каталог</a>
        </section>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var product in Model)
            {
                <article class="catalog-card">
                    <a asp-action="Details" asp-route-id="@product.Id" class="catalog-card__media" aria-label="Переглянути @product.Name">
                        @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                        {
                            <img src="@product.MainImageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <span aria-hidden="true">@product.Name[..1].ToUpperInvariant()</span>
                        }
                    </a>
                    <div class="catalog-card__body">
                        <div class="catalog-card__category">@product.CategoryName</div>
                        <a asp-action="Details" asp-route-id="@product.Id" class="catalog-card__title">@product.Name</a>
                        <p class="catalog-card__description">@product.Description</p>
                        <div class="catalog-card__footer">
                            <span class="shop-price">@product.Price.ToString("N2") ₴</span>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-sm btn-primary">До кошика</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
