@using Marketplace.BLL.DTOs.Products
@model Marketplace.Web.Models.CatalogPageViewModel

@{
    ViewData["Title"] = "Каталог товарів";
    var filter = Model.Filter;
    bool isAdultConfirmed = Context.Request.Cookies["AdultConfirmed"] == "true";
}

@functions {
    private static Dictionary<string, string> RouteValuesForPage(Marketplace.Web.Models.CatalogFilterViewModel filter, int page)
    {
        var values = new Dictionary<string, string>();

        if (!string.IsNullOrWhiteSpace(filter.Search)) values["Search"] = filter.Search;
        if (filter.CategoryId.HasValue) values["CategoryId"] = filter.CategoryId.Value.ToString();
        if (filter.MinPrice.HasValue) values["MinPrice"] = filter.MinPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (filter.MaxPrice.HasValue) values["MaxPrice"] = filter.MaxPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (filter.InStockOnly) values["InStockOnly"] = "true";
        if (filter.MinRating.HasValue) values["MinRating"] = filter.MinRating.Value.ToString();
        if (filter.Sort != CatalogSortOption.Newest) values["Sort"] = filter.Sort.ToString();
        values["Page"] = page.ToString();

        return values;
    }

    private static string SortLabel(CatalogSortOption sort) => sort switch
    {
        CatalogSortOption.PriceAsc => "Дешевші спочатку",
        CatalogSortOption.PriceDesc => "Дорожчі спочатку",
        CatalogSortOption.Rating => "За рейтингом",
        CatalogSortOption.Popularity => "За популярністю",
        _ => "Спочатку нові"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/saved-searches.css" asp-append-version="true" />
}

<div class="shop-page">
    <header class="shop-header">
        <div>
            <div class="shop-kicker">MarketPlace</div>
            <h1 class="shop-title">Каталог товарів</h1>
            <p class="shop-subtitle">Оберіть товар, перегляньте деталі та додайте його до кошика.</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">Перейти до кошика</a>
        }
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <form asp-action="Index" method="get" class="catalog-filters" role="search" aria-label="Фільтри каталогу">
        <div class="catalog-filters__grid">
            <div class="catalog-filters__field" style="grid-column: 1 / -1;" data-search-wrapper>
                <label for="filter-search">Пошук</label>
                <div class="catalog-filters__search-row">
                    <input id="filter-search" name="Search" value="@filter.Search" class="form-control" placeholder="Назва, опис або категорія" data-search-autocomplete autocomplete="off" />
                </div>
            </div>

            <div class="catalog-filters__field">
                <label for="filter-category">Категорія</label>
                <select id="filter-category" name="CategoryId" class="form-select">
                    <option value="">Усі категорії</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Value" selected="@(category.Value == filter.CategoryId?.ToString())">@category.Text</option>
                    }
                </select>
            </div>

            <div class="catalog-filters__field">
                <label>Ціна, ₴</label>
                <div class="catalog-filters__price">
                    <input type="number" min="0" step="1" name="MinPrice" value="@filter.MinPrice" class="form-control" placeholder="від" aria-label="Мінімальна ціна" />
                    <span>-</span>
                    <input type="number" min="0" step="1" name="MaxPrice" value="@filter.MaxPrice" class="form-control" placeholder="до" aria-label="Максимальна ціна" />
                </div>
            </div>

            <div class="catalog-filters__field">
                <label for="filter-rating">Рейтинг</label>
                <select id="filter-rating" name="MinRating" class="form-select">
                    <option value="">Будь-який</option>
                    @for (var stars = 4; stars >= 1; stars--)
                    {
                        <option value="@stars" selected="@(filter.MinRating == stars)">@stars★ і вище</option>
                    }
                </select>
            </div>

            <div class="catalog-filters__field">
                <label for="filter-sort">Сортування</label>
                <select id="filter-sort" name="Sort" class="form-select">
                    @foreach (var option in Enum.GetValues<CatalogSortOption>())
                    {
                        <option value="@option" selected="@(filter.Sort == option)">@SortLabel(option)</option>
                    }
                </select>
            </div>

            <div class="catalog-filters__check">
                <input type="checkbox" id="filter-in-stock" name="InStockOnly" value="true" class="form-check-input" checked="@filter.InStockOnly" />
                <label for="filter-in-stock" class="mb-0">Тільки в наявності</label>
            </div>
        </div>

        <div class="catalog-filters__actions d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <div>
                @if (!isAdultConfirmed)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="showAgeModal(null)">
                        🔞 Увімкнути контент 18+
                    </button>
                }
                else
                {
                    <span class="badge bg-danger p-2">🔞 Контент 18+ увімкнено</span>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap">
                @if (filter.HasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Скинути фільтри</a>
                    <button type="button" class="btn btn-outline-primary" data-save-search>☆ Зберегти пошук</button>
                }
                <button type="submit" class="btn btn-primary">Застосувати</button>
            </div>
        </div>
    </form>

    <section class="saved-searches" data-saved-searches hidden>
        <div class="saved-searches__heading">
            <span class="saved-searches__kicker">Збережені запити</span>
            <p>Швидко повертайтесь до пошуків, що вас цікавлять - нові товари з часу останнього перегляду позначені міткою «Нове».</p>
        </div>
        <div class="saved-searches__list" data-saved-searches-list></div>
    </section>

    <div class="catalog-meta">Знайдено товарів: <strong>@Model.TotalCount</strong></div>

    @if (Model.Products.Count == 0)
    {
        <section class="shop-empty">
            <div class="shop-empty__icon" aria-hidden="true">⌕</div>
            <h2>Товарів не знайдено</h2>
            <p>Спробуйте змінити фільтри або переглянути весь каталог.</p>
            <a asp-action="Index" class="btn btn-primary">Увесь каталог</a>
        </section>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var product in Model.Products)
            {
                <article class="catalog-card position-relative" data-product-id="@product.Id">
                    <span class="catalog-card__new-badge" data-new-badge hidden>Нове</span>

                    @if (product.IsAgeRestricted)
                    {
                        <span class="position-absolute top-0 end-0 bg-danger text-white text-xs fw-bold px-2 py-1 rounded-pill z-1 m-2 shadow">
                            18+
                        </span>
                    }

                    <button type="button" 
                            class="catalog-card__media border-0 p-0 text-start bg-transparent w-100 position-relative" 
                            aria-label="Переглянути @product.Name"
                            onclick="checkAgeAndNavigate('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                        @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                        {
                            <img src="@product.MainImageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <span aria-hidden="true">@product.Name[..1].ToUpperInvariant()</span>
                        }
                    </button>

                    <div class="catalog-card__body">
                        <div class="catalog-card__category">@product.CategoryName</div>
                        @if (product.ReviewCount > 0)
                        {
                            var filledStars = (int)Math.Round(product.AverageRating);
                            <div class="catalog-card__rating" aria-label="Рейтинг @product.AverageRating з 5, @product.ReviewCount відгуків">
                                @(new string('★', filledStars))@(new string('☆', 5 - filledStars))
                                <span>&nbsp;@product.AverageRating.ToString("0.0") (@product.ReviewCount)</span>
                            </div>
                        }
                        else
                        {
                            <div class="catalog-card__rating" data-empty>Ще немає відгуків</div>
                        }
                        
                        <button type="button" 
                                class="catalog-card__title border-0 p-0 text-start bg-transparent text-primary fw-semibold w-100" 
                                onclick="checkAgeAndNavigate('@product.Id', @product.IsAgeRestricted.ToString().ToLower())">
                            @product.Name
                        </button>

                        <p class="catalog-card__description">@product.Description</p>
                        <div class="catalog-card__footer">
                            <div class="shop-price-container d-flex align-items-center gap-2">
                                @if (product.OriginalPrice.HasValue && product.OriginalPrice.Value > product.Price)
                                {
                                    <span class="shop-price text-danger fw-bold">@product.Price.ToString("N2") ₴</span>
                                    <span class="text-muted text-decoration-line-through small">@product.OriginalPrice.Value.ToString("N2") ₴</span>
                                    @if (product.DiscountPercent.HasValue)
                                    {
                                        <span class="badge bg-danger small">-@product.DiscountPercent%</span>
                                    }
                                }
                                else
                                {
                                    <span class="shop-price">@product.Price.ToString("N2") ₴</span>
                                }
                            </div>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-sm btn-primary">До кошика</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            var windowStart = Math.Max(1, Model.Page - 2);
            var windowEnd = Math.Min(Model.TotalPages, Model.Page + 2);

            <nav class="catalog-pagination" aria-label="Сторінки каталогу">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-all-route-data="RouteValuesForPage(filter, Model.Page - 1)" aria-label="Попередня сторінка">‹</a>
                }
                else
                {
                    <span class="is-disabled">‹</span>
                }

                @if (windowStart > 1)
                {
                    <a asp-action="Index" asp-all-route-data="RouteValuesForPage(filter, 1)">1</a>
                    if (windowStart > 2)
                    {
                        <span class="catalog-pagination__ellipsis">…</span>
                    }
                }

                @for (var pageNumber = windowStart; pageNumber <= windowEnd; pageNumber++)
                {
                    if (pageNumber == Model.Page)
                    {
                        <span class="is-current">@pageNumber</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-all-route-data="RouteValuesForPage(filter, pageNumber)">@pageNumber</a>
                    }
                }

                @if (windowEnd < Model.TotalPages)
                {
                    if (windowEnd < Model.TotalPages - 1)
                    {
                        <span class="catalog-pagination__ellipsis">…</span>
                    }
                    <a asp-action="Index" asp-all-route-data="RouteValuesForPage(filter, Model.TotalPages)">@Model.TotalPages</a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-all-route-data="RouteValuesForPage(filter, Model.Page + 1)" aria-label="Наступна сторінка">›</a>
                }
                else
                {
                    <span class="is-disabled">›</span>
                }
            </nav>
        }
    }
</div>

<!-- МОДАЛЬНЕ ВІКНО 18+ З ФОРМОЮ POST ДЛЯ COOKIE -->
<div id="ageVerificationModal" class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 d-flex align-items-center justify-content-center p-3" style="backdrop-filter: blur(4px); z-index: 9999;">
    <div class="bg-white rounded-4 shadow-lg p-4 text-center" style="max-width: 400px; width: 100%;">
        <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger fs-3 fw-bold mb-3" style="width: 64px; height: 64px;">
            18+
        </div>
        <h3 class="fs-4 fw-bold text-dark mb-2">Підтвердження віку</h3>
        <p class="text-secondary small mb-4">
            Цей товар має вікове обмеження. Вам вже виповнилося 18 років?
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button type="button" onclick="closeAgeModal()" class="btn btn-light w-100 fw-medium">Ні, мені менше 18</button>
            
            <form asp-action="ConfirmAge" asp-controller="Catalogue" method="post" class="w-100">
                <input type="hidden" id="modalProductId" name="productId" value="" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-danger w-100 fw-medium">Так, мені є 18</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/saved-searches.js" asp-append-version="true"></script>
    <script>
        const isAdultConfirmedServer = @(isAdultConfirmed.ToString().ToLower());
        const ageModal = document.getElementById('ageVerificationModal');
        const modalProductIdInput = document.getElementById('modalProductId');

        function checkAgeAndNavigate(productId, isRestricted) {
            if (isRestricted && !isAdultConfirmedServer) {
                showAgeModal(productId);
            } else {
                window.location.href = `/Catalogue/Details/${productId}`;
            }
        }

        function showAgeModal(productId) {
            if (productId) {
                modalProductIdInput.value = productId;
            } else {
                modalProductIdInput.value = '';
            }
            ageModal.classList.remove('d-none');
        }

        function closeAgeModal() {
            ageModal.classList.add('d-none');
        }
    </script>
}