@model Marketplace.Web.Models.Businesses.BusinessGrowthViewModel

@{
    ViewData["Title"] = $"Розвиток бізнесу — {Model.StoreName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← До панелі продавця</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> Панель продавця</div>
            <h1>Розвиток бізнесу — @Model.StoreName</h1>
            <p>Поради, які допомагають продавцям на платформі зростати.</p>
        </div>
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <section class="business-panel">
        <h2>Поради для зростання</h2>
        <p class="business-panel__lead">Загальні рекомендації — не персоналізована аналітика.</p>

        <div class="business-tip-grid">
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">🧭</span>
                <h3>Розширюйте асортимент</h3>
                <p>Магазини з ширшим вибором товарів частіше з'являються в результатах пошуку каталогу.</p>
            </div>
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">⭐</span>
                <h3>Стежте за рейтингом</h3>
                <p>Швидко реагуйте на відгуки та запитання покупців — це напряму впливає на довіру до магазину.</p>
            </div>
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">📦</span>
                <h3>Тримайте залишки актуальними</h3>
                <p>Товари з нульовим залишком не показуються покупцям — регулярно оновлюйте наявність.</p>
            </div>
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">🚚</span>
                <h3>Прискорюйте обробку замовлень</h3>
                <p>Швидка зміна статусу замовлення покращує враження покупця та знижує ризик скасувань.</p>
            </div>
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">🌍</span>
                <h3>Плануйте вихід на нові ринки</h3>
                <p>Міжнародні продажі та інтеграції з іншими майданчиками — у розробці платформи.</p>
            </div>
            <div class="business-tip-card">
                <span class="business-tip-card__icon" aria-hidden="true">🤝</span>
                <h3>Розвивайте команду</h3>
                <p>Додавайте учасників з ролями в розділі «Команда», щоб розподілити керування магазином.</p>
            </div>
        </div>
    </section>
</div>
