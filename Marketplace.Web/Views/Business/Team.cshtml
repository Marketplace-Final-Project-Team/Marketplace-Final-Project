@model Marketplace.Web.Models.Businesses.BusinessTeamViewModel
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Web.Models.Businesses
@using Marketplace.Domain.Enums
@inject IBusinessAccessService BusinessAccessService

@{
    ViewData["Title"] = $"Команда - {Model.StoreName}";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model.BusinessId, userId)
        : null;
}

@functions {
    private static string RoleLabel(BusinessMemberRole role) => role switch
    {
        BusinessMemberRole.Owner => "Власник",
        BusinessMemberRole.Admin => "Адміністратор",
        BusinessMemberRole.BusinessAnalyst => "Бізнес-аналітик",
        BusinessMemberRole.ProductManager => "Менеджер товарів",
        _ => role.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← До панелі продавця</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> @BusinessRoleContext.PanelLabel(currentRole)</div>
            <h1>Команда - @Model.StoreName</h1>
            <p>Хто має доступ до керування цим магазином.</p>
        </div>
        @if (Model.CanManage)
        {
            <a asp-action="AddMember" asp-route-businessId="@Model.BusinessId" class="seller-button seller-button--primary">
                <span aria-hidden="true">＋</span> Запросити учасника
            </a>
        }
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <section class="business-panel" data-collapsible>
        <partial name="_CollapseToggle" />
        <h2>Що дозволяє кожна роль</h2>
        <div class="table-responsive">
            <table class="business-table">
                <thead>
                    <tr><th>Роль</th><th>Статистика й фінанси</th><th>Товари, промокоди та знижки</th><th>Команда</th><th>Налаштування магазину</th></tr>
                </thead>
                <tbody>
                    <tr><td>Власник</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr>
                    <tr><td>Адміністратор</td><td>✓</td><td>✓</td><td>✓</td><td>—</td></tr>
                    <tr><td>Менеджер товарів</td><td>—</td><td>✓</td><td>—</td><td>—</td></tr>
                    <tr><td>Бізнес-аналітик</td><td>✓</td><td>—</td><td>—</td><td>—</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    @if (TempData["Success"] is string success)
    {
        <div class="seller-alert" role="status">
            <span aria-hidden="true">✓</span>
            <p><strong>Успішно</strong>@success</p>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="seller-alert seller-alert--danger" role="status">
            <span aria-hidden="true">!</span>
            <p><strong>Помилка</strong>@error</p>
        </div>
    }

    <div class="seller-orders-panel table-responsive">
        <table class="table seller-orders-table">
            <thead>
                <tr>
                    <th>Учасник</th>
                    <th>Роль</th>
                    <th>Статус</th>
                    @if (Model.CanManage)
                    {
                        <th class="text-end">Дії</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">@Model.OwnerEmail</td>
                    <td><span class="badge bg-secondary text-white px-2 py-1">Власник</span></td>
                    <td><span class="order-status order-status--delivered">Активний</span></td>
                    @if (Model.CanManage)
                    {
                        <td></td>
                    }
                </tr>
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td class="fw-semibold">@member.Email</td>
                        <td>
                            @if (Model.CanManage)
                            {
                                <form asp-action="UpdateMemberRole" method="post" class="d-inline-block">
                                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <div class="role-select-wrapper">
                                        <select name="newRole" class="role-select" onchange="this.form.submit()">
                                            <option value="@BusinessMemberRole.Admin" selected="@(member.Role == BusinessMemberRole.Admin)">Адміністратор</option>
                                            <option value="@BusinessMemberRole.ProductManager" selected="@(member.Role == BusinessMemberRole.ProductManager)">Менеджер товарів</option>
                                            <option value="@BusinessMemberRole.BusinessAnalyst" selected="@(member.Role == BusinessMemberRole.BusinessAnalyst)">Бізнес-аналітик</option>
                                        </select>
                                    </div>
                                </form>
                            }
                            else
                            {
                                @RoleLabel(member.Role)
                            }
                        </td>
                        <td>
                            @if (member.IsAccepted)
                            {
                                <span class="order-status order-status--delivered">Активний</span>
                            }
                            else
                            {
                                <span class="order-status order-status--pending">Очікує підтвердження</span>
                            }
                        </td>
                        @if (Model.CanManage)
                        {
                            <td class="text-end">
                                <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('Видалити цього учасника з команди?');">
                                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Members.Count == 0)
    {
        <p class="seller-orders-empty">Поки що в команді лише власник магазину.</p>
    }
</div>