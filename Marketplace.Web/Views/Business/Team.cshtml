@model Marketplace.Web.Models.Businesses.BusinessTeamViewModel
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Web.Models.Businesses
@using Marketplace.Domain.Enums
@inject IBusinessAccessService BusinessAccessService

@{
    ViewData["Title"] = $"{Localizer["Команда"].Value} - {Model.StoreName}";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model.BusinessId, userId)
        : null;
}

@functions {
    private string RoleLabel(BusinessMemberRole role) => role switch
    {
        BusinessMemberRole.Owner => Localizer["Власник"].Value,
        BusinessMemberRole.Admin => Localizer["Адміністратор"].Value,
        BusinessMemberRole.BusinessAnalyst => Localizer["Бізнес-аналітик"].Value,
        BusinessMemberRole.ProductManager => Localizer["Менеджер товарів"].Value,
        _ => role.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← @SharedLocalizer["Панель продавця"]</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> @BusinessRoleContext.PanelLabel(currentRole)</div>
            <h1>@Localizer["Команда"] - @Model.StoreName</h1>
            <p>@Localizer["Хто має доступ до керування цим магазином."]</p>
        </div>
        @if (Model.CanManage)
        {
            <a asp-action="AddMember" asp-route-businessId="@Model.BusinessId" class="seller-button seller-button--primary">
                <span aria-hidden="true">＋</span> @Localizer["Запросити учасника"]
            </a>
        }
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <section class="business-panel" data-collapsible>
        <partial name="_CollapseToggle" />
        <h2>@Localizer["Що дозволяє кожна роль"]</h2>
        <div class="table-responsive">
            <table class="business-table">
                <thead>
                    <tr><th>@Localizer["Роль"]</th><th>@Localizer["Статистика й фінанси"]</th><th>@Localizer["Товари, промокоди та знижки"]</th><th>@Localizer["Команда"]</th><th>@Localizer["Налаштування магазину"]</th></tr>
                </thead>
                <tbody>
                    <tr><td>@Localizer["Власник"]</td><td>✓</td><td>✓</td><td>✓</td><td>✓</td></tr>
                    <tr><td>@Localizer["Адміністратор"]</td><td>✓</td><td>✓</td><td>✓</td><td>—</td></tr>
                    <tr><td>@Localizer["Менеджер товарів"]</td><td>—</td><td>✓</td><td>—</td><td>—</td></tr>
                    <tr><td>@Localizer["Бізнес-аналітик"]</td><td>✓</td><td>—</td><td>—</td><td>—</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    @if (TempData["Success"] is string success)
    {
        <div class="seller-alert" role="status">
            <span aria-hidden="true">✓</span>
            <p><strong>@Localizer["Успішно"]</strong>@success</p>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="seller-alert seller-alert--danger" role="status">
            <span aria-hidden="true">!</span>
            <p><strong>@Localizer["Помилка"]</strong>@error</p>
        </div>
    }

    <div class="seller-orders-panel table-responsive">
        <table class="table seller-orders-table">
            <thead>
                <tr>
                    <th>@Localizer["Учасник"]</th>
                    <th>@Localizer["Роль"]</th>
                    <th>@Localizer["Статус"]</th>
                    @if (Model.CanManage)
                    {
                        <th class="text-end">@Localizer["Дії"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">@Model.OwnerEmail</td>
                    <td><span class="badge bg-secondary text-white px-2 py-1">@Localizer["Власник"]</span></td>
                    <td><span class="order-status order-status--delivered">@Localizer["Активний"]</span></td>
                    @if (Model.CanManage)
                    {
                        <td></td>
                    }
                </tr>
                @foreach (var member in Model.Members)
                {
                    <tr>
                        <td class="fw-semibold">@member.Email</td>
                        <td>
                            @if (Model.CanManage)
                            {
                                <form asp-action="UpdateMemberRole" method="post" class="d-inline-block">
                                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <div class="role-select-wrapper">
                                        <select name="newRole" class="role-select" onchange="this.form.submit()">
                                            <option value="@BusinessMemberRole.Admin" selected="@(member.Role == BusinessMemberRole.Admin)">@Localizer["Адміністратор"]</option>
                                            <option value="@BusinessMemberRole.ProductManager" selected="@(member.Role == BusinessMemberRole.ProductManager)">@Localizer["Менеджер товарів"]</option>
                                            <option value="@BusinessMemberRole.BusinessAnalyst" selected="@(member.Role == BusinessMemberRole.BusinessAnalyst)">@Localizer["Бізнес-аналітик"]</option>
                                        </select>
                                    </div>
                                </form>
                            }
                            else
                            {
                                @RoleLabel(member.Role)
                            }
                        </td>
                        <td>
                            @if (member.IsAccepted)
                            {
                                <span class="order-status order-status--delivered">@Localizer["Активний"]</span>
                            }
                            else
                            {
                                <span class="order-status order-status--pending">@Localizer["Очікує підтвердження"]</span>
                            }
                        </td>
                        @if (Model.CanManage)
                        {
                            <td class="text-end">
                                <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Видалити цього учасника з команди?"]');">
                                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                                    <input type="hidden" name="memberId" value="@member.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Видалити"]</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Members.Count == 0)
    {
        <p class="seller-orders-empty">@Localizer["Поки що в команді лише власник магазину."]</p>
    }
</div>
