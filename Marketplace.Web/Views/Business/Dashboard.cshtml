@model Marketplace.Web.Models.Businesses.BusinessDashboardPageViewModel
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Web.Models.Businesses
@inject IBusinessAccessService BusinessAccessService
@using System.Text.Encodings.Web
@using System.Text.Json

@{
    ViewData["Title"] = $"{Localizer["Дашборд"].Value} - {Model.StoreName}";

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model.BusinessId, userId)
        : null;

    var jsonOptions = new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.Default
    };

    var chartJson = JsonSerializer.Serialize(Model.Chart.Select(c => new
    {
        date = c.Date.ToString("dd.MM"),
        revenue = c.Revenue,
        orders = c.OrderCount
    }), jsonOptions);

    var productStatusJson = JsonSerializer.Serialize(new
    {
        active = Model.ActiveProductCount,
        pending = Model.PendingProductCount,
        outOfStock = Model.OutOfStockProductCount,
        lowStock = Model.LowStockProductCount
    }, jsonOptions);

    var topProductsJson = JsonSerializer.Serialize(Model.TopProducts.Select(p => new
    {
        name = p.ProductName,
        revenue = p.Revenue
    }), jsonOptions);

    var topCustomersJson = JsonSerializer.Serialize(Model.TopCustomers.Select(c => new
    {
        name = c.UserName,
        revenue = c.Revenue
    }), jsonOptions);

    var trafficJson = JsonSerializer.Serialize(new
    {
        views = Model.TotalViews,
        cartAdds = Model.TotalCartAdds,
        wishlistAdds = Model.TotalWishlistAdds,
        orders = Model.PeriodOrders
    }, jsonOptions);

    var categoryColors = new[] { "#3157d7", "#42a98b", "#e8a33d", "#c65f9e", "#5b8def", "#8a5b00", "#b42318", "#7a89bb" };
    var categoryJson = JsonSerializer.Serialize(Model.CategoryStats.Select((c, i) => new
    {
        name = c.CategoryName,
        revenue = c.Revenue,
        color = categoryColors[i % categoryColors.Length]
    }), jsonOptions);
}

@functions {
    private string DeltaHtml(double? percent)
    {
        if (percent is null)
        {
            return $"<span class=\"business-kpi__delta\">— {Localizer["немає даних за попередній період"].Value}</span>";
        }

        var isUp = percent.Value >= 0;
        var cls = isUp ? "business-kpi__delta--up" : "business-kpi__delta--down";
        var arrow = isUp ? "▲" : "▼";
        var sign = isUp ? "+" : "";
        return $"<span class=\"business-kpi__delta {cls}\">{arrow} {sign}{percent.Value:0.0}% {Localizer["до попереднього періоду"].Value}</span>";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← @Localizer["До головної панелі"]</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> @BusinessRoleContext.PanelLabel(currentRole)</div>
            <h1>@Localizer["Дашборд"] - @Model.StoreName</h1>
            <p>@Localizer["Продажі, товари, покупці й трафік магазину за обраний період."]</p>
        </div>
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <form method="get" asp-action="Dashboard" class="business-filter-form">
        <input type="hidden" name="businessId" value="@Model.BusinessId" />
        <div>
            <label for="startDate">@Localizer["З дати"]</label>
            <input type="date" id="startDate" class="form-control" name="startDate" value="@Model.Filter.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate">@Localizer["По дату"]</label>
            <input type="date" id="endDate" class="form-control" name="endDate" value="@Model.Filter.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-outline-secondary">@Localizer["Застосувати"]</button>
    </form>

    <div class="business-kpis">
        <div class="business-kpi">
            <span>@Localizer["Виручка за період"]</span>
            <strong>@Model.PeriodRevenue.ToString("N0") ₴</strong>
            @Html.Raw(DeltaHtml(Model.RevenueDeltaPercent))
        </div>
        <div class="business-kpi">
            <span>@Localizer["Замовлень за період"]</span>
            <strong>@Model.PeriodOrders</strong>
            @Html.Raw(DeltaHtml(Model.OrdersDeltaPercent))
        </div>
        <div class="business-kpi">
            <span>@Localizer["Середній чек"]</span>
            <strong>@Model.PeriodAverageOrderValue.ToString("N0") ₴</strong>
            @Html.Raw(DeltaHtml(Model.AverageOrderValueDeltaPercent))
        </div>
        <div class="business-kpi"><span>@Localizer["Баланс магазину"]</span><strong>@Model.Balance.ToString("N0") ₴</strong></div>
        <div class="business-kpi"><span>@Localizer["Виручка за весь час"]</span><strong>@Model.AllTimeRevenue.ToString("N0") ₴</strong></div>
        <div class="business-kpi"><span>@Localizer["Товарів усього"]</span><strong>@Model.TotalProductCount</strong></div>
    </div>

    <div class="business-two-col">
        <section class="business-panel business-chart-card" data-collapsible>
            <h2>@Localizer["Виручка та замовлення за період"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Model.Filter.StartDate?.ToString("dd.MM.yyyy") - @Model.Filter.EndDate?.ToString("dd.MM.yyyy")</p>
            @if (Model.Chart.Count == 0)
            {
                <p class="business-empty">@Localizer["Даних за обраний період немає."]</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap">
                    <canvas id="revenueChart" data-chart="@chartJson"></canvas>
                </div>
            }
        </section>

        <section class="business-panel business-chart-card" data-collapsible>
            <h2>@Localizer["Динаміка середнього чека"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["Виручка / кількість замовлень по днях."]</p>
            @if (Model.Chart.Count == 0)
            {
                <p class="business-empty">@Localizer["Даних за обраний період немає."]</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap">
                    <canvas id="aovChart"></canvas>
                </div>
            }
        </section>
    </div>

    <div class="business-two-col">
        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Топ товари"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["За виручкою в обраному періоді."]</p>
            @if (Model.TopProducts.Count == 0)
            {
                <p class="business-empty">@Localizer["Продажів за період немає."]</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap business-chart-card__canvas-wrap--short">
                    <canvas id="topProductsChart" data-chart="@topProductsJson"></canvas>
                </div>
                <div class="table-responsive">
                    <table class="business-table">
                        <thead>
                            <tr><th>@Localizer["Товар"]</th><th>@Localizer["Виручка"]</th><th>@Localizer["Продано"]</th><th>@Localizer["Перегляди"]</th><th>@Localizer["Конверсія"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.TopProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Revenue.ToString("N0") ₴</td>
                                    <td>@product.UnitsSold</td>
                                    <td>@product.Views</td>
                                    <td>@product.ConversionRatePercent.ToString("0.0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Топ покупці"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["За виручкою в обраному періоді."]</p>
            @if (Model.TopCustomers.Count == 0)
            {
                <p class="business-empty">@Localizer["Покупців за період немає."]</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap business-chart-card__canvas-wrap--short">
                    <canvas id="topCustomersChart" data-chart='@Html.Raw(topCustomersJson)'></canvas>
                </div>
                <div class="table-responsive">
                    <table class="business-table">
                        <thead>
                            <tr><th>@Localizer["Покупець"]</th><th>@Localizer["Виручка"]</th><th>@Localizer["Покупок"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model.TopCustomers)
                            {
                                <tr>
                                    <td>@customer.UserName</td>
                                    <td>@customer.Revenue.ToString("N0") ₴</td>
                                    <td>@customer.PurchaseCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="business-two-col">
        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Трафік і конверсія"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["Дії покупців з товарами магазину за обраний період."]</p>
            <div class="business-chart-card__canvas-wrap business-chart-card__canvas-wrap--short">
                <canvas id="trafficChart" data-chart="@trafficJson"></canvas>
            </div>
            <div class="business-kpis">
                <div class="business-kpi"><span>@Localizer["Перегляди товарів"]</span><strong>@Model.TotalViews</strong></div>
                <div class="business-kpi"><span>@Localizer["Додано в кошик"]</span><strong>@Model.TotalCartAdds</strong></div>
                <div class="business-kpi"><span>@Localizer["Додано в побажання"]</span><strong>@Model.TotalWishlistAdds</strong></div>
                <div class="business-kpi"><span>@Localizer["Конверсія в замовлення"]</span><strong>@Model.ConversionRatePercent.ToString("0.0")%</strong></div>
            </div>
        </section>

        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Асортимент"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["Розподіл товарів магазину за станом."]</p>
            <div class="business-chart-card__canvas-wrap business-chart-card__canvas-wrap--short">
                <canvas id="productStatusChart" data-chart="@productStatusJson"></canvas>
            </div>
            <div class="business-kpis">
                <div class="business-kpi"><span>@Localizer["Активні"]</span><strong>@Model.ActiveProductCount</strong></div>
                <div class="business-kpi"><span>@Localizer["На модерації"]</span><strong>@Model.PendingProductCount</strong></div>
                <div class="business-kpi @(Model.OutOfStockProductCount > 0 ? "business-kpi--warning" : null)"><span>@Localizer["Немає в наявності"]</span><strong>@Model.OutOfStockProductCount</strong></div>
                <div class="business-kpi @(Model.LowStockProductCount > 0 ? "business-kpi--warning" : null)"><span>@Localizer["Мало на складі"]</span><strong>@Model.LowStockProductCount</strong></div>
            </div>
        </section>
    </div>

    <div class="business-two-col">
        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Продажі за категоріями"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["За виручкою в обраному періоді."]</p>
            @if (Model.CategoryStats.Count == 0)
            {
                <p class="business-empty">@Localizer["Продажів за цей період немає."]</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap business-chart-card__canvas-wrap--short">
                    <canvas id="categoryChart" data-chart='@Html.Raw(categoryJson)'></canvas>
                </div>
            }
        </section>

        <section class="business-panel" data-collapsible>
            <h2>@Localizer["Категорії за виручкою"]</h2>
            <partial name="_CollapseToggle" />
            <p class="business-panel__lead">@Localizer["Розподіл продажів між категоріями товарів."]</p>
            @if (Model.CategoryStats.Count == 0)
            {
                <p class="business-empty">@Localizer["Продажів за цей період немає."]</p>
            }
            else
            {
                var categoryTotalRevenue = Model.CategoryStats.Sum(c => c.Revenue);
                <div class="table-responsive">
                    <table class="business-table">
                        <thead>
                            <tr><th>@Localizer["Категорія"]</th><th>@Localizer["Виручка"]</th><th>@Localizer["Одиниць"]</th><th>@Localizer["Частка"]</th></tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.CategoryStats.Count; i++)
                            {
                                var category = Model.CategoryStats[i];
                                var share = categoryTotalRevenue == 0 ? 0 : Math.Round(category.Revenue * 100 / categoryTotalRevenue, 1);
                                <tr>
                                    <td>
                                        <span class="business-category-dot" style="background: @categoryColors[i % categoryColors.Length]"></span>
                                        @category.CategoryName
                                    </td>
                                    <td>@category.Revenue.ToString("N0") ₴</td>
                                    <td>@category.UnitsSold</td>
                                    <td>@share%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <section class="business-panel" data-collapsible>
        <h2>@Localizer["Останні дії"]</h2>
        <partial name="_CollapseToggle" />
        @if (Model.RecentActivity.Count == 0)
        {
            <p class="business-empty">@Localizer["Дій поки немає."]</p>
        }
        else
        {
            <ul class="business-activity-list">
                @foreach (var activity in Model.RecentActivity)
                {
                    <li>
                        <time>@activity.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                        <span>@activity.Description</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/chart-helpers.js" asp-append-version="true"></script>
    <script src="~/js/business-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/business-panel-collapse.js" asp-append-version="true"></script>
}
