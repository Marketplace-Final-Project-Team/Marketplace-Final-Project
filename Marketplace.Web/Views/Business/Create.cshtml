@model Marketplace.Web.Models.BusinessCreateViewModel

@{
    ViewData["Title"] = "CreateBusiness";
}

<div class="container" style="max-width: 600px;">
    <h2 class="mb-4 text-center">Створення бізнесу</h2>

    <form asp-controller="Business" asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="StoreName" class="form-label">Назва магазину:</label>
            <input asp-for="StoreName" class="form-control" placeholder="Назва вашого магазину" />
            <span asp-validation-for="StoreName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Опис бізнесу:</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Опишіть свій бізнес"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Logo" class="form-label">Логотип:</label>
            <input asp-for="Logo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="Logo" class="text-danger"></span>
            <div class="form-text">JPG, PNG або WEBP, до 5 МБ</div>
        </div>

        <div class="mb-3">
            <label asp-for="Banner" class="form-label">Банер:</label>
            <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="Banner" class="text-danger"></span>
            <div class="form-text">JPG, PNG або WEBP, до 5 МБ</div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary flex-grow-1">Створити</button>
            <a asp-controller="Business" asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}