@model Guid
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Domain.Enums
@inject IBusinessAccessService BusinessAccessService

@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string ActiveClass(string action) => string.Equals(current, action, StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model, userId)
        : null;
    var canManageSettings = currentRole == BusinessMemberRole.Owner;
}

<nav class="business-nav" aria-label="Розділи панелі магазину">
    <a class="@ActiveClass("Dashboard")" asp-action="Dashboard" asp-route-businessId="@Model">Дашборд</a>
    <a class="@ActiveClass("Orders")" asp-action="Orders" asp-route-businessId="@Model">Замовлення</a>
    <a class="@ActiveClass("Finance")" asp-action="Finance" asp-route-businessId="@Model">Фінанси</a>
    <a class="@ActiveClass("Performance")" asp-action="Performance" asp-route-businessId="@Model">Ефективність</a>
    <a class="@ActiveClass("Growth")" asp-action="Growth" asp-route-businessId="@Model">Розвиток</a>
    <a class="@ActiveClass("PromoCodes")" asp-action="PromoCodes" asp-route-businessId="@Model">Знижки</a>
    <a class="@ActiveClass("Integrations")" asp-action="Integrations" asp-route-businessId="@Model">Додатки</a>
    <a class="@ActiveClass("Team")" asp-action="Team" asp-route-businessId="@Model">Команда</a>
    @if (canManageSettings)
    {
        <a class="@ActiveClass("Settings")" asp-action="Settings" asp-route-businessId="@Model">Налаштування</a>
    }
</nav>
