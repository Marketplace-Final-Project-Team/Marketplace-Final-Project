@model Marketplace.Web.Models.Businesses.BusinessPerformanceViewModel
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Web.Models.Businesses
@inject IBusinessAccessService BusinessAccessService
@{
    ViewData["Title"] = $"Ефективність - {Model.StoreName}";
    var statusClass = Model.Status.ToString().ToLowerInvariant();
    var statusLabel = Model.Status switch
    {
        Marketplace.Domain.Enums.BusinessStatus.Pending => "На перевірці",
        Marketplace.Domain.Enums.BusinessStatus.Active => "Активний",
        Marketplace.Domain.Enums.BusinessStatus.Suspended => "Призупинений",
        Marketplace.Domain.Enums.BusinessStatus.Rejected => "Відхилений",
        _ => Model.Status.ToString()
    };

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model.BusinessId, userId)
        : null;

    string OrderStatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => "Очікує підтвердження",
        Marketplace.Domain.Enums.OrderStatus.Confirmed => "Підтверджено",
        Marketplace.Domain.Enums.OrderStatus.Shipped => "Відправлено",
        Marketplace.Domain.Enums.OrderStatus.Delivered => "Доставлено",
        Marketplace.Domain.Enums.OrderStatus.Canceled => "Скасовано",
        _ => status.ToString()
    };

    var orderStatusJson = System.Text.Json.JsonSerializer.Serialize(
        Enum.GetValues(typeof(Marketplace.Domain.Enums.OrderStatus))
            .Cast<Marketplace.Domain.Enums.OrderStatus>()
            .Select(status => new
            {
                label = OrderStatusLabel(status),
                count = Model.OrdersByStatus.TryGetValue(status, out var count) ? count : 0
            }));

    var ratingJson = System.Text.Json.JsonSerializer.Serialize(Model.RatingDistribution);
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← До панелі продавця</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> @BusinessRoleContext.PanelLabel(currentRole)</div>
            <h1>Ефективність акаунта - @Model.StoreName</h1>
            <p>Стан магазину, якість обслуговування та відгуки покупців.</p>
        </div>
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <section class="business-panel">
        <h2>Стан акаунта</h2>
        <span class="seller-status seller-status--@statusClass"><span aria-hidden="true"></span>@statusLabel</span>
    </section>

    <div class="business-kpis">
        <div class="business-kpi"><span>Рівень скасувань</span><strong>@Model.CancelRatePercent.ToString("0.0")%</strong></div>
        <div class="business-kpi"><span>Скасовано / усього</span><strong>@Model.CanceledOrders / @Model.TotalOrders</strong></div>
        <div class="business-kpi"><span>Середній рейтинг товарів</span><strong>@(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "-")</strong></div>
        <div class="business-kpi"><span>Відгуків усього</span><strong>@Model.ReviewCount</strong></div>
    </div>

    <div class="business-two-col">
        <section class="business-panel">
            <h2>Замовлення за статусами</h2>
            <p class="business-panel__lead">Розподіл усіх замовлень магазину.</p>
            @if (Model.TotalOrders == 0)
            {
                <p class="business-empty">Замовлень поки немає.</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap">
                    <canvas id="orderStatusChart" data-chart='@Html.Raw(orderStatusJson)'></canvas>
                </div>
            }
        </section>

        <section class="business-panel">
            <h2>Розподіл рейтингів</h2>
            <p class="business-panel__lead">Кількість відгуків за оцінкою (1-5).</p>
            @if (Model.ReviewCount == 0)
            {
                <p class="business-empty">Відгуків поки немає.</p>
            }
            else
            {
                <div class="business-chart-card__canvas-wrap">
                    <canvas id="ratingChart" data-chart='@Html.Raw(ratingJson)'></canvas>
                </div>
            }
        </section>
    </div>

    <section class="business-panel">
        <h2>Претензії та повернення</h2>
        <div class="business-note">
            <strong>Обробка вручну</strong>
            Заявки на повернення та спірні питання наразі опрацьовує команда підтримки маркетплейсу вручну - окрема статистика за цим розділом ще не збирається автоматично.
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/chart-helpers.js" asp-append-version="true"></script>
    <script src="~/js/business-performance-charts.js" asp-append-version="true"></script>
}
