@model Marketplace.Web.Models.Businesses.BusinessOrderDetailsViewModel
@using System.Security.Claims
@using Marketplace.BLL.Interfaces
@using Marketplace.Web.Models.Businesses

@{
    ViewData["Title"] = $"Замовлення #{Model.OrderId.ToString()[..8].ToUpperInvariant()}";
}

@functions {
    private static string StatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => "Очікує підтвердження",
        Marketplace.Domain.Enums.OrderStatus.Confirmed => "Підтверджено",
        Marketplace.Domain.Enums.OrderStatus.Shipped => "Відправлено",
        Marketplace.Domain.Enums.OrderStatus.Delivered => "Доставлено",
        Marketplace.Domain.Enums.OrderStatus.Canceled => "Скасовано",
        _ => status.ToString()
    };

    private static string PostSaleStatusLabel(Marketplace.Domain.Enums.PostSaleRequestStatus status) => status switch
    {
        Marketplace.Domain.Enums.PostSaleRequestStatus.Refunded => "Підтверджено, кошти повернуто",
        Marketplace.Domain.Enums.PostSaleRequestStatus.Rejected => "Відхилено",
        Marketplace.Domain.Enums.PostSaleRequestStatus.AwaitingSellerConfirmation => "Очікує вашого підтвердження",
        Marketplace.Domain.Enums.PostSaleRequestStatus.SellerDisputed => "Ваша відмова на розгляді у адміністратора",
        _ => "Очікує розгляду адміністратором"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Orders" asp-route-businessId="@Model.BusinessId" class="seller-order-back">← До списку замовлень</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> @Model.StoreName</div>
            <h1>Замовлення #@Model.OrderId.ToString()[..8].ToUpperInvariant()</h1>
            <p>Створено @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
        <span class="order-status order-status--@Model.Status.ToString().ToLowerInvariant()">@StatusLabel(Model.Status)</span>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="seller-alert" role="status">
            <span aria-hidden="true">✓</span>
            <p><strong>Успішно</strong>@success</p>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.Items.Any(item => !item.BelongsToBusiness))
    {
        <div class="seller-alert" style="background:#fff9e8;border-color:#f4d77d;color:#755000;">
            <span aria-hidden="true" style="background:#c8870b;">i</span>
            <p><strong>Змішане замовлення</strong>Це замовлення містить також товари інших продавців - вони показані нижче, але статус змінюється для всього замовлення одразу.</p>
        </div>
    }

    <div class="seller-order-layout">
        <section class="seller-order-card">
            <h2>Товари в замовленні</h2>
            @foreach (var item in Model.Items)
            {
                <div class="seller-order-line @(item.BelongsToBusiness ? "" : "seller-order-line--foreign")">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img class="seller-order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                    }
                    else
                    {
                        <div class="seller-order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                    }
                    <div>
                        <div>@item.ProductName @if (!item.BelongsToBusiness) { <span class="seller-order-line__badge">інший продавець</span> }</div>
                        <div class="seller-order-line__meta">@item.Quantity шт. × @item.UnitPrice.ToString("N2") ₴</div>
                    </div>
                    <div class="seller-order-line__total">@((item.UnitPrice * item.Quantity).ToString("N2")) ₴</div>
                </div>
            }
        </section>

        <aside class="seller-order-card seller-order-info">
            <h2>Отримувач і доставка</h2>
            <dl>
                <div class="seller-order-info__row">
                    <dt>Покупець</dt>
                    <dd>@Model.BuyerName</dd>
                </div>
                <div class="seller-order-info__row">
                    <dt>Email</dt>
                    <dd>@Model.BuyerEmail</dd>
                </div>
                <div class="seller-order-info__row">
                    <dt>Телефон</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.BuyerPhone) ? "не вказано" : Model.BuyerPhone)</dd>
                </div>
                <div class="seller-order-info__row">
                    <dt>Адреса</dt>
                    <dd>@Model.ShippingCountry, @Model.ShippingCity,<br />@Model.ShippingStreet</dd>
                </div>
                <div class="seller-order-info__row">
                    <dt>Сума замовлення</dt>
                    <dd>@Model.OrderTotalAmount.ToString("N2") ₴</dd>
                </div>
            </dl>

            @{
                var allowedNextStatuses = Marketplace.BLL.Common.OrderStatusTransitions.GetAllowedNext(Model.Status);
            }
            @if (allowedNextStatuses.Length > 0)
            {
                <form asp-action="ChangeOrderStatus" method="post" class="seller-order-status-form">
                    <input type="hidden" name="businessId" value="@Model.BusinessId" />
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <select name="status" class="form-select">
                        <option value="@Model.Status" selected>@StatusLabel(Model.Status)</option>
                        @foreach (var option in allowedNextStatuses)
                        {
                            <option value="@option">@StatusLabel(option)</option>
                        }
                    </select>
                    <button type="submit" class="seller-button seller-button--primary">Змінити статус</button>
                </form>
            }
            else
            {
                <p class="seller-order-status-final">Статус замовлення: <strong>@StatusLabel(Model.Status)</strong> (кінцевий, змінити неможливо)</p>
            }
        </aside>
    </div>

    @if (Model.PostSaleRequests.Any())
    {
        <section class="seller-order-card seller-postsale">
            <h2>Заявки на повернення</h2>
            @foreach (var request in Model.PostSaleRequests)
            {
                <div class="seller-postsale-item seller-postsale-item--@request.Status.ToString().ToLowerInvariant()">
                    <div class="seller-postsale-item__header">
                        <strong>Повернення: @request.ProductName</strong>
                        <span class="seller-postsale-item__status">@PostSaleStatusLabel(request.Status)</span>
                    </div>
                    <p class="seller-postsale-item__meta">@request.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") · @request.Reason</p>
                    @if (!string.IsNullOrWhiteSpace(request.Comment))
                    {
                        <p class="seller-postsale-item__comment">«@request.Comment»</p>
                    }
                    @if (request.PhotoUrls.Any())
                    {
                        <div class="postsale-photos">
                            @foreach (var url in request.PhotoUrls)
                            {
                                <a href="@url" target="_blank" rel="noopener"><img src="@url" alt="Фото до заявки" /></a>
                            }
                        </div>
                    }

                    @if (request.Status == Marketplace.Domain.Enums.PostSaleRequestStatus.Pending)
                    {
                        <p class="seller-postsale-item__comment text-muted">
                            Заявку розглядає адміністратор маркетплейсу. Коли рішення буде ухвалено, тут з'явиться дія для вас.
                        </p>
                    }

                    else if (request.Status == Marketplace.Domain.Enums.PostSaleRequestStatus.AwaitingSellerConfirmation)
                    {
                        <div class="alert alert-danger mt-2 mb-2">
                            <strong>Потрібна ваша дія!</strong> Адміністратор підтвердив повернення.
                            Підтвердіть до <strong>@request.SellerConfirmDeadline?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>,
                            інакше кошти будуть списані автоматично.
                        </div>

                        <form asp-action="ConfirmReturn" method="post" class="d-inline">
                            <input type="hidden" name="businessId" value="@Model.BusinessId" />
                            <input type="hidden" name="orderId" value="@Model.OrderId" />
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <button type="submit" class="seller-button seller-button--primary" onclick="return confirm('Підтвердити повернення? Кошти будуть одразу списані з балансу магазину та повернуті покупцю.');">
                                Підтвердити повернення
                            </button>
                        </form>

                        <button type="button" class="seller-button mt-2" data-bs-toggle="modal" data-bs-target="#disputeModal-@request.Id">
                            Відхилити з обґрунтуванням
                        </button>
                    }

                    else if (request.Status == Marketplace.Domain.Enums.PostSaleRequestStatus.SellerDisputed)
                    {
                        <p class="seller-postsale-item__comment text-muted">
                            Ваше обґрунтування передано адміністратору, очікуйте остаточного рішення.
                        </p>
                        <a asp-controller="Support" asp-action="RefundChat" asp-route-requestId="@request.Id" asp-route-isSellerChannel="true" class="seller-button position-relative">
                            Повернутися в чат
                            @if (request.UnreadFromAdmin > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@request.UnreadFromAdmin</span>
                            }
                        </a>
                    }

                    else if (!string.IsNullOrWhiteSpace(request.SellerResponse))
                    {
                        <p class="seller-postsale-item__comment">Відповідь: «@request.SellerResponse»</p>
                    }
                </div>
            }
        </section>
    }
</div>

@foreach (var request in Model.PostSaleRequests.Where(r => r.Status == Marketplace.Domain.Enums.PostSaleRequestStatus.AwaitingSellerConfirmation))
{
    <div class="modal fade" id="disputeModal-@request.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <button type="button" class="postsale-modal__close" aria-label="Закрити" data-bs-dismiss="modal">×</button>
                <div class="modal-body p-4">
                    <div data-dispute-form="@request.Id">
                        <h3>Відхилення повернення</h3>
                        <p class="text-muted small">Товар: @request.ProductName</p>

                        <label class="form-label mt-2">Поясніть, чому ви не згодні з поверненням</label>
                        <textarea class="form-control" rows="3" minlength="10" placeholder="Наприклад, товар був у справному стані при відправці..." data-dispute-reason required></textarea>

                        <label class="form-label mt-3">Фото на підтвердження (необов'язково)</label>
                        <input type="file" class="form-control" accept="image/*" multiple data-dispute-photos />

                        <button type="button" class="btn btn-primary mt-3 w-100" data-dispute-submit
                                data-business-id="@Model.BusinessId" data-order-id="@Model.OrderId" data-request-id="@request.Id">
                            Надіслати на розгляд адміну
                        </button>
                    </div>
                    <div data-dispute-success="@request.Id" hidden style="text-align:center;padding:1rem;">
                        <div class="spinner-border text-primary" role="status"></div>
                        <h4 class="mt-3">Надіслано!</h4>
                        <p class="text-muted">Переводимо вас у чат з адміністратором...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/dispute-return.js" asp-append-version="true"></script>
}