@model Marketplace.Web.Models.Businesses.BusinessIntegrationsViewModel

@{
    ViewData["Title"] = $"Додатки та інтеграції — {Model.StoreName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/business.css" asp-append-version="true" />
}

<div class="seller-dashboard">
    <a asp-action="Index" class="seller-order-back">← До панелі продавця</a>

    <header class="seller-orders-header">
        <div>
            <div class="seller-dashboard__eyebrow"><span aria-hidden="true"></span> Панель продавця</div>
            <h1>Додатки та інтеграції — @Model.StoreName</h1>
            <p>Розширюйте можливості магазину сторонніми сервісами.</p>
        </div>
    </header>

    <partial name="_BusinessNav" model="Model.BusinessId" />

    <section class="business-panel">
        <h2>Доставка</h2>
        <div class="business-tip-grid">
            <div class="business-integration-card">
                <span class="business-integration-card__icon" aria-hidden="true">📮</span>
                <div><strong>Нова пошта</strong><span>Автоматичне створення накладних</span></div>
                <span class="business-integration-card__badge">Скоро</span>
            </div>
            <div class="business-integration-card">
                <span class="business-integration-card__icon" aria-hidden="true">✈</span>
                <div><strong>Укрпошта</strong><span>Розрахунок вартості доставки</span></div>
                <span class="business-integration-card__badge">Скоро</span>
            </div>
        </div>
    </section>

    <section class="business-panel">
        <h2>Маркетинг та аналітика</h2>
        <div class="business-tip-grid">
            <div class="business-integration-card">
                <span class="business-integration-card__icon" aria-hidden="true">📊</span>
                <div><strong>Google Merchant Center</strong><span>Синхронізація каталогу товарів</span></div>
                <span class="business-integration-card__badge">Скоро</span>
            </div>
            <div class="business-integration-card">
                <span class="business-integration-card__icon" aria-hidden="true">📷</span>
                <div><strong>Instagram Shopping</strong><span>Позначення товарів у публікаціях</span></div>
                <span class="business-integration-card__badge">Скоро</span>
            </div>
        </div>
    </section>

    <section class="business-panel">
        <h2>Інструменти розробника</h2>
        <div class="business-note">
            <strong>Публічний API та вебхуки</strong>
            Плануємо відкрити API для інтеграції зовнішніх систем обліку та автоматизації управління асортиментом.
        </div>
    </section>
</div>
