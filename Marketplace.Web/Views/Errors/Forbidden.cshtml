@{
    ViewData["Title"] = "Доступ заборонено";
}

@section Styles {
    <link rel="stylesheet" href="~/css/errors.css" asp-append-version="true" />
}

<div class="error-page">
    <section class="error-card">
        <div class="error-visual error-visual--403" aria-hidden="true">
            <span class="error-code">403</span>
            <div class="error-lock">
                <i></i>
                <span>!</span>
            </div>
        </div>

        <div class="error-copy">
            <div class="error-kicker">Недостатньо прав</div>
            <h1>Ця сторінка закрита</h1>
            <p>
                Ви увійшли до системи, але не маєте дозволу на цю дію.
                Поверніться на головну або відкрийте доступний розділ.
            </p>
            <div class="error-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">На головну</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">До каталогу</a>
            </div>
        </div>
    </section>
</div>
