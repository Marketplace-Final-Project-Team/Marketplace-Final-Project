@{
    ViewData["Title"] = Localizer["Доступ заборонено"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/errors.css" asp-append-version="true" />
}

<div class="error-page">
    <section class="error-card">
        <div class="error-visual error-visual--403" aria-hidden="true">
            <span class="error-code">403</span>
            <div class="error-lock">
                <i></i>
                <span>!</span>
            </div>
        </div>

        <div class="error-copy">
            <div class="error-kicker">@Localizer["Недостатньо прав"]</div>
            <h1>@Localizer["Ця сторінка закрита"]</h1>
            <p>
                @Localizer["Ви увійшли до системи, але не маєте дозволу на цю дію."]
                @Localizer["Поверніться на головну або відкрийте доступний розділ."]
            </p>
            <div class="error-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Localizer["На головну"]</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">@Localizer["До каталогу"]</a>
            </div>
        </div>
    </section>
</div>
