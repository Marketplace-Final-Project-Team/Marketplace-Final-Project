@{
    ViewData["Title"] = Localizer["Сторінку не знайдено"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/errors.css" asp-append-version="true" />
}

<div class="error-page">
    <section class="error-card">
        <div class="error-visual error-visual--404" aria-hidden="true">
            <span class="error-code">404</span>
            <div class="error-compass"><i></i></div>
        </div>

        <div class="error-copy">
            <div class="error-kicker">@Localizer["Здається, ви заблукали"]</div>
            <h1>@Localizer["Такої сторінки немає"]</h1>
            <p>
                @Localizer["Можливо, адресу введено з помилкою, сторінку переміщено або товар більше не доступний."]
            </p>
            <div class="error-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Localizer["На головну"]</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Відкрити каталог"]</a>
            </div>
        </div>
    </section>
</div>
