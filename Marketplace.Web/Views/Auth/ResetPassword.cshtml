@model Marketplace.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Скидання пароля";
}

<section class="auth-card auth-card--compact" aria-labelledby="reset-password-title">
    <div class="auth-card__icon auth-card__icon--key" aria-hidden="true">✦</div>

    <div class="auth-card__header">
        <p class="auth-kicker">Новий пароль</p>
        <h2 id="reset-password-title">Захистіть свій акаунт</h2>
        <p>Створіть новий надійний пароль, який ви не використовуєте на інших сайтах.</p>
    </div>

    <form asp-action="ResetPassword" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="field">
            <div class="field-label-row">
                <label asp-for="NewPassword">Новий пароль</label>
                <span class="field-hint">8+ символів</span>
            </div>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="NewPassword"
                       autocomplete="new-password"
                       placeholder="Створіть надійний пароль"
                       data-password-input
                       data-password-strength
                       autofocus />
                <button class="password-toggle" type="button" data-password-toggle aria-label="Показати пароль" aria-pressed="false">Показати</button>
            </div>
            <span asp-validation-for="NewPassword" class="field-error"></span>
            <p class="password-rule">Велика й мала літера, цифра та спеціальний символ.</p>
            <div class="password-strength" data-password-strength-meter aria-live="polite">
                <div class="password-strength__track" aria-hidden="true"><span></span></div>
                <div class="password-strength__meta">
                    <span>Надійність пароля</span>
                    <strong data-password-strength-label>Не вказано</strong>
                </div>
            </div>
        </div>

        <div class="field">
            <label asp-for="ConfirmNewPassword">Повторіть пароль</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="ConfirmNewPassword"
                       autocomplete="new-password"
                       placeholder="Введіть пароль ще раз"
                       data-password-input />
                <button class="password-toggle" type="button" data-password-toggle aria-label="Показати пароль" aria-pressed="false">Показати</button>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
        </div>

        <button type="submit" class="button button--primary">Зберегти новий пароль <span aria-hidden="true">→</span></button>
    </form>

    <div class="auth-back-row">
        <a asp-action="SignIn"><span aria-hidden="true">←</span> Повернутися до входу</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
