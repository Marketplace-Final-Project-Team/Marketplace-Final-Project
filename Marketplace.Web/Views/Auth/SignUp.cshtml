@model Marketplace.Web.Models.SignUpViewModel

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container d-flex justify-content-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4 mt-5">
        <h2 class="mb-4 text-center">Створення акаунту</h2>

        <form asp-controller="Auth" asp-action="SignUp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Ім'я користувача:</label>
                <input asp-for="Username" class="form-control" placeholder="Введіть ім'я користувача..." />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Емейл:</label>
                <input asp-for="Email" class="form-control" placeholder="Введіть емейл..." />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Пароль:</label>
                <input asp-for="Password" class="form-control" placeholder="Введіть пароль..." />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Підтвердження пароля:</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Підтвердіть пароль..." />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Зареєструватись</button>

            <p class="text-center mt-3 mb-0">
                Вже маєте акаунт?
                <a asp-controller="Auth" asp-action="SignIn">Увійти</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}