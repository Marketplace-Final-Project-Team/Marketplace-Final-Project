@model Marketplace.Web.Models.SignUpViewModel
@{
    ViewData["Title"] = Localizer["Реєстрація"].Value;
}

<section class="auth-card" aria-labelledby="register-title">
    <div class="auth-card__header">
        <p class="auth-kicker">@Localizer["Новий акаунт"]</p>
        <h2 id="register-title">@Localizer["Приєднуйтесь до Marketplace"]</h2>
        <p>@Localizer["Створіть один акаунт для покупок і майбутнього кабінету продавця."]</p>
    </div>

    <form asp-controller="Auth" asp-action="SignUp" method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

        <div class="field">
            <label asp-for="Username">@Localizer["Ім’я користувача"]</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">◉</span>
                <input asp-for="Username"
                       autocomplete="username"
                       placeholder="@Localizer["Наприклад, oleksii"]"
                       autofocus />
            </div>
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Email">@Localizer["Електронна пошта"]</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">@@</span>
                <input asp-for="Email"
                       autocomplete="email"
                       inputmode="email"
                       placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <div class="field-label-row">
                <label asp-for="Password">@Localizer["Пароль"]</label>
                <span class="field-hint">@Localizer["8+ символів"]</span>
            </div>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="Password"
                       autocomplete="new-password"
                       placeholder="@Localizer["Створіть надійний пароль"]"
                       data-password-input
                       data-password-strength />
                <button class="password-toggle"
                        type="button"
                        data-password-toggle
                        aria-label="@Localizer["Показати пароль"]"
                        aria-pressed="false">
                    @Localizer["Показати"]
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
            <p class="password-rule">@Localizer["Велика й мала літера, цифра та спеціальний символ."]</p>
            <div class="password-strength" data-password-strength-meter aria-live="polite">
                <div class="password-strength__track" aria-hidden="true"><span></span></div>
                <div class="password-strength__meta">
                    <span>@Localizer["Надійність пароля"]</span>
                    <strong data-password-strength-label>@Localizer["Не вказано"]</strong>
                </div>
            </div>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">@Localizer["Повторіть пароль"]</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="ConfirmPassword"
                       autocomplete="new-password"
                       placeholder="@Localizer["Введіть пароль ще раз"]"
                       data-password-input />
                <button class="password-toggle"
                        type="button"
                        data-password-toggle
                        aria-label="@Localizer["Показати пароль"]"
                        aria-pressed="false">
                    @Localizer["Показати"]
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <label class="checkbox checkbox--top">
            <input asp-for="AcceptTerms" />
            <span>
                @Localizer["Я приймаю правила користування та"]
                <a asp-controller="Home" asp-action="Privacy">@Localizer["політику конфіденційності"]</a>
            </span>
        </label>
        <span asp-validation-for="AcceptTerms" class="field-error"></span>

        <button class="button button--primary" type="submit">
            @SharedLocalizer["Створити акаунт"]
            <span aria-hidden="true">→</span>
        </button>
    </form>

    <div class="auth-divider"><span>@Localizer["вже зареєстровані?"]</span></div>

    <p class="auth-switch">
        <a asp-controller="Auth"
           asp-action="SignIn"
           asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Увійти до наявного акаунта"]</a>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Custom client adapter for [MustBeTrue]: must run after jquery.validate.unobtrusive
        // loads but before its own $(document).ready() parse pass picks up the form.
        (function () {
            if (window.jQuery && jQuery.validator && jQuery.validator.unobtrusive) {
                jQuery.validator.addMethod("mustbetrue", function (value, element) {
                    return element.checked;
                });
                jQuery.validator.unobtrusive.adapters.addBool("mustbetrue");
            }
        })();
    </script>
}
