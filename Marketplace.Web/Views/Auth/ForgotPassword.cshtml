@{
    ViewData["Title"] = Localizer["Відновлення пароля"].Value;
}

<section class="auth-card auth-card--compact" aria-labelledby="forgot-password-title">
    <div class="auth-card__icon auth-card__icon--mail" aria-hidden="true">@@</div>

    <div class="auth-card__header">
        <p class="auth-kicker">@Localizer["Відновлення доступу"]</p>
        <h2 id="forgot-password-title">@Localizer["Забули пароль?"]</h2>
        <p>@Localizer["Вкажіть електронну пошту акаунта - ми надішлемо безпечне посилання для створення нового пароля."]</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>

        <div class="field">
            <label for="email">@Localizer["Електронна пошта"]</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">@@</span>
                <input name="email"
                       id="email"
                       type="email"
                       autocomplete="email"
                       inputmode="email"
                       placeholder="name@example.com"
                       autofocus
                       required />
            </div>
            @Html.ValidationMessage("Email", null, new { @class = "field-error" })
        </div>

        <button type="submit" class="button button--primary">
            @Localizer["Надіслати посилання"]
            <span aria-hidden="true">→</span>
        </button>
    </form>

    <div class="auth-back-row">
        <a asp-action="SignIn"><span aria-hidden="true">←</span> @Localizer["Повернутися до входу"]</a>
    </div>

    <div class="auth-security-note">
        <span aria-hidden="true">✓</span>
        <p><strong>@Localizer["Безпечно та конфіденційно"]</strong>@Localizer["Ми не повідомляємо, чи зареєстрована вказана адреса."]</p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
