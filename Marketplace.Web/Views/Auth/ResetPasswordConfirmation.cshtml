@{
    ViewData["Title"] = "Пароль змінено";
}

<section class="auth-card auth-card--status" aria-labelledby="password-changed-title">
    <div class="status-mark status-mark--success" aria-hidden="true">✓</div>
    <p class="auth-kicker auth-kicker--success">Готово</p>
    <h2 id="password-changed-title">Пароль успішно змінено</h2>
    <p class="status-copy">Ваш акаунт знову захищений. Тепер увійдіть, використовуючи новий пароль.</p>

    <div class="auth-success-panel">
        <span aria-hidden="true">✓</span>
        <p><strong>Новий пароль активний</strong>Попередній пароль більше не підходить для входу.</p>
    </div>

    <div class="auth-status-actions">
        <a asp-action="SignIn" class="button button--primary">Перейти до входу <span aria-hidden="true">→</span></a>
        <a asp-controller="Home" asp-action="Index" class="button button--secondary">На головну</a>
    </div>
</section>
