@{
    ViewData["Title"] = Localizer["Пароль змінено"].Value;
}

<section class="auth-card auth-card--status" aria-labelledby="password-changed-title">
    <div class="status-mark status-mark--success" aria-hidden="true">✓</div>
    <p class="auth-kicker auth-kicker--success">@Localizer["Готово"]</p>
    <h2 id="password-changed-title">@Localizer["Пароль успішно змінено"]</h2>
    <p class="status-copy">@Localizer["Ваш акаунт знову захищений. Тепер увійдіть, використовуючи новий пароль."]</p>

    <div class="auth-success-panel">
        <span aria-hidden="true">✓</span>
        <p><strong>@Localizer["Новий пароль активний"]</strong>@Localizer["Попередній пароль більше не підходить для входу."]</p>
    </div>

    <div class="auth-status-actions">
        <a asp-action="SignIn" class="button button--primary">@Localizer["Перейти до входу"] <span aria-hidden="true">→</span></a>
        <a asp-controller="Home" asp-action="Index" class="button button--secondary">@Localizer["На головну"]</a>
    </div>
</section>
