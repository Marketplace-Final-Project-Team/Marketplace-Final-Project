@{
    var succeeded = ViewBag.Succeeded is bool value && value;
    var message = ViewBag.Message as string ?? Localizer["Не вдалося підтвердити електронну пошту."].Value;
    ViewData["Title"] = succeeded ? Localizer["Email підтверджено"].Value : Localizer["Помилка підтвердження"].Value;
}

<section class="auth-card auth-card--status" aria-labelledby="confirmation-title">
    <div class="status-mark @(succeeded ? "status-mark--success" : "status-mark--error")" aria-hidden="true">
        @(succeeded ? "✓" : "!")
    </div>
    <p class="auth-kicker @(succeeded ? "auth-kicker--success" : "auth-kicker--error")">
        @(succeeded ? Localizer["Підтверджено"] : Localizer["Посилання не спрацювало"])
    </p>
    <h2 id="confirmation-title">
        @(succeeded ? Localizer["Електронну пошту підтверджено"] : Localizer["Не вдалося підтвердити email"])
    </h2>
    <p class="status-copy">@message</p>

    @if (succeeded)
    {
        <div class="auth-success-panel">
            <span aria-hidden="true">✓</span>
            <p><strong>@Localizer["Акаунт готовий до роботи"]</strong>@Localizer["Тепер ви можете входити, купувати товари та створювати власний магазин."]</p>
        </div>
        <div class="auth-status-actions">
            <a asp-action="SignIn" class="button button--primary">@Localizer["Увійти до акаунта"] <span aria-hidden="true">→</span></a>
            <a asp-controller="Home" asp-action="Index" class="button button--secondary">@Localizer["На головну"]</a>
        </div>
    }
    else
    {
        <div class="auth-error-panel">
            <span aria-hidden="true">!</span>
            <p><strong>@Localizer["Що могло статися?"]</strong>@Localizer["Посилання пошкоджене, уже використане або термін його дії завершився."]</p>
        </div>
        <div class="auth-status-actions">
            <a asp-action="SignUp" class="button button--primary">@Localizer["Створити акаунт ще раз"] <span aria-hidden="true">→</span></a>
            <a asp-action="SignIn" class="button button--secondary">@Localizer["Повернутися до входу"]</a>
        </div>
    }
</section>
