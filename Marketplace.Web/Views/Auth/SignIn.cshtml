@model Marketplace.Web.Models.SignInViewModel
@{
    ViewData["Title"] = Localizer["Вхід"].Value;
}

<section class="auth-card" aria-labelledby="login-title">
    <div class="auth-card__header">
        <p class="auth-kicker">@Localizer["З поверненням"]</p>
        <h2 id="login-title">@Localizer["Увійдіть до акаунта"]</h2>
        <p>@Localizer["Продовжуйте покупки, перевіряйте замовлення або керуйте магазином."]</p>
    </div>

    <form asp-controller="Auth" asp-action="SignIn" method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="form-alert" role="alert"></div>
        <div class="field">
            <label asp-for="Email">@Localizer["Електронна пошта"]</label>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">@@</span>
                <input asp-for="Email" autocomplete="email" inputmode="email" placeholder="name@example.com" autofocus />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="field">
            <div class="field-label-row">
                <label asp-for="Password">@Localizer["Пароль"]</label>
                <a asp-action="ForgotPassword">@Localizer["Забули пароль?"]</a>
            </div>
            <div class="field-control">
                <span class="field-icon" aria-hidden="true">●</span>
                <input asp-for="Password" autocomplete="current-password" placeholder="@Localizer["Введіть пароль"]" data-password-input />
                <button class="password-toggle" type="button" data-password-toggle aria-label="@Localizer["Показати пароль"]" aria-pressed="false">@Localizer["Показати"]</button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <label class="checkbox">
            <input asp-for="RememberMe" />
            <span>@Localizer["Залишатися в системі"]</span>
        </label>
        <button class="button button--primary" type="submit">@SharedLocalizer["Увійти"] <span aria-hidden="true">→</span></button>
    </form>
    <div class="auth-divider"><span>@Localizer["або"]</span></div>
    <p class="auth-switch">
        @Localizer["Ще не маєте акаунта?"]
        <a asp-action="SignUp" asp-route-returnUrl="@Model.ReturnUrl">@SharedLocalizer["Створити акаунт"]</a>
    </p>
    <p class="auth-note">
        @Localizer["Входячи, ви погоджуєтеся з правилами користування та"]
        <a asp-controller="Home" asp-action="Privacy">@Localizer["політикою конфіденційності"]</a>.
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
