@{
    ViewData["Title"] = Localizer["Лист надіслано"].Value;
}

<section class="auth-card auth-card--status" aria-labelledby="email-sent-title">
    <div class="status-mark status-mark--mail" aria-hidden="true">@@</div>
    <p class="auth-kicker">@Localizer["Лист уже в дорозі"]</p>
    <h2 id="email-sent-title">@Localizer["Перевірте свою пошту"]</h2>
    <p class="status-copy">
        @Localizer["Якщо акаунт із вказаною адресою існує, ми надіслали посилання для скидання пароля."]
    </p>

    <div class="auth-steps" aria-label="@Localizer["Що робити далі"]">
        <div><span>1</span><p><strong>@Localizer["Відкрийте лист"]</strong>@Localizer["Перевірте також папки «Спам» і «Промоакції»."]</p></div>
        <div><span>2</span><p><strong>@Localizer["Перейдіть за посиланням"]</strong>@Localizer["Посилання безпечно відкриє форму нового пароля."]</p></div>
        <div><span>3</span><p><strong>@Localizer["Створіть новий пароль"]</strong>@Localizer["Після цього поверніться та увійдіть до акаунта."]</p></div>
    </div>

    <div class="auth-status-actions">
        <a asp-action="SignIn" class="button button--primary">@Localizer["Повернутися до входу"] <span aria-hidden="true">→</span></a>
        <a asp-action="ForgotPassword" class="button button--secondary">@Localizer["Надіслати ще раз"]</a>
    </div>
</section>
