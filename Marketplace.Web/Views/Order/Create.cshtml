@model Marketplace.Web.Models.OrderCreateViewModel

@{
    ViewData["Title"] = "Оформлення замовлення";
    var units = Model.Items.Sum(item => item.Quantity);
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart-sellers.css" asp-append-version="true" />
}

<div class="shop-page">
    <a asp-controller="Cart" asp-action="Index" class="shop-back">← Назад до кошика</a>
    <header class="shop-header">
        <div>
            <div class="shop-kicker">Оформлення</div>
            <h1 class="shop-title">Оформлення замовлення</h1>
            <p class="shop-subtitle">Оберіть адресу, перевірте доставку й оплату, підтвердіть замовлення.</p>
        </div>
    </header>

    <div class="checkout-stepper" role="list" aria-label="Кроки оформлення замовлення">
        <div class="checkout-stepper__step" data-step-indicator="1">
            <span class="checkout-stepper__dot" aria-hidden="true">1</span>
            <span class="checkout-stepper__label">Адреса</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="2">
            <span class="checkout-stepper__dot" aria-hidden="true">2</span>
            <span class="checkout-stepper__label">Доставка</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="3">
            <span class="checkout-stepper__dot" aria-hidden="true">3</span>
            <span class="checkout-stepper__label">Оплата</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="4">
            <span class="checkout-stepper__dot" aria-hidden="true">4</span>
            <span class="checkout-stepper__label">Огляд</span>
        </div>
    </div>

    <form asp-action="Create" method="post" class="checkout-form" id="checkout-form">
        <div class="checkout-layout">
            <div class="checkout-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger m-3" role="alert"></div>

                <div class="checkout-section">
                    <section class="checkout-step" data-step="1">
                        <h2>Адреса доставки</h2>

                        @if (Model.SavedAddresses.Count > 0)
                        {
                            <div class="checkout-address-options">
                                @foreach (var address in Model.SavedAddresses)
                                {
                                    <label class="checkout-address-option">
                                        <input type="radio" name="SelectedAddressId" value="@address.Id" checked="@(Model.SelectedAddressId == address.Id)" />
                                        <span data-address-label="@address.Id">
                                            <strong>
                                                @address.Country, @address.City
                                                @if (address.IsDefault)
                                                {
                                                    <span class="checkout-address-option__badge">Основна</span>
                                                }
                                            </strong>
                                            <span>@address.Street</span>
                                        </span>
                                    </label>
                                }
                                <label class="checkout-address-option">
                                    <input type="radio" name="SelectedAddressId" value="" checked="@(!Model.SelectedAddressId.HasValue)" />
                                    <span><strong>Нова адреса</strong><span>Вкажіть іншу адресу доставки</span></span>
                                </label>
                            </div>
                        }

                        <div class="checkout-new-address-fields" data-new-address-fields hidden="@(Model.SavedAddresses.Count > 0 && Model.IsUsingSavedAddress)">
                            <div class="checkout-fields">
                                <div>
                                    <label asp-for="Country" class="form-label">Країна</label>
                                    <input asp-for="Country" class="form-control" />
                                    <span asp-validation-for="Country" class="text-danger small"></span>
                                </div>
                                <div>
                                    <label asp-for="City" class="form-label">Місто</label>
                                    <input asp-for="City" class="form-control" placeholder="Київ" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                                <div class="wide">
                                    <label asp-for="Street" class="form-label">Вулиця, будинок, квартира</label>
                                    <input asp-for="Street" class="form-control" placeholder="вул. Хрещатик, 1, кв. 10" />
                                    <span asp-validation-for="Street" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="2" hidden>
                        <h2>Спосіб доставки</h2>

                        <div class="checkout-carrier-options">
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="NovaPoshta" data-carrier-radio checked="@(Model.DeliveryCarrier == "NovaPoshta")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Нова пошта</strong>
                                    <span>Доставка у відділення або поштомат</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="Ukrposhta" data-carrier-radio checked="@(Model.DeliveryCarrier == "Ukrposhta")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Укрпошта</strong>
                                    <span>Доставка на вказану адресу</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="Meest" data-carrier-radio checked="@(Model.DeliveryCarrier == "Meest")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Meest Express</strong>
                                    <span>Доставка на вказану адресу</span>
                                </span>
                            </label>
                        </div>

                        <div class="checkout-nova-poshta" data-carrier-panel="NovaPoshta">
                            <div class="checkout-fields">
                                <div>
                                    <label class="form-label">Місто</label>
                                    <input type="text" class="form-control" placeholder="Почніть вводити назву міста" autocomplete="off" data-np-city-input value="@Model.NovaPoshtaCityName" />
                                    <input type="hidden" name="NovaPoshtaCityRef" data-np-city-ref value="@Model.NovaPoshtaCityRef" />
                                    <input type="hidden" name="NovaPoshtaCityName" data-np-city-name value="@Model.NovaPoshtaCityName" />
                                </div>
                                <div>
                                    <label class="form-label">Відділення / поштомат</label>
                                    <select class="form-select" data-np-branch-select disabled>
                                        <option value="">Спочатку оберіть місто</option>
                                    </select>
                                    <input type="hidden" name="NovaPoshtaBranchRef" data-np-branch-ref value="@Model.NovaPoshtaBranchRef" />
                                    <input type="hidden" name="NovaPoshtaBranchName" data-np-branch-name value="@Model.NovaPoshtaBranchName" />
                                    <span class="text-danger small" data-np-branch-error hidden>Оберіть відділення Нової пошти</span>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-info-card" data-carrier-panel="Ukrposhta" hidden>
                            <strong>Укрпошта</strong>
                            <span>Кур'єрська доставка. Орієнтовний термін - 3–5 робочих днів.</span>
                        </div>

                        <div class="checkout-info-card" data-carrier-panel="Meest" hidden>
                            <strong>Meest Express</strong>
                            <span>Кур'єрська доставка. Орієнтовний термін - 2–4 робочі дні.</span>
                        </div>

                        <div class="checkout-nova-poshta" data-carrier-panel="Ukrposhta,Meest" hidden>
                            <div class="checkout-fields">
                                <div>
                                    <label class="form-label">Місто доставки</label>
                                    <input type="text" name="DeliveryCity" class="form-control" placeholder="Наприклад, Львів" required value="@Model.DeliveryCity" />
                                </div>
                                <div>
                                    <label class="form-label">Адреса доставки</label>
                                    <input type="text" name="DeliveryStreet" class="form-control" placeholder="вул. Хрещатик, 1, кв. 10" required value="@Model.DeliveryStreet" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="3" hidden>
                        <h2>Спосіб оплати</h2>

                        <div class="checkout-carrier-options">
                            <label class="checkout-carrier-option">
                                <input type="radio" name="PaymentMethod" value="Online" data-payment-radio checked="@(Model.PaymentMethod == "Online")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Онлайн-оплата через LiqPay</strong>
                                    <span>Після підтвердження ви перейдете на безпечну сторінку оплати</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="PaymentMethod" value="CashOnDelivery" data-payment-radio checked="@(Model.PaymentMethod == "CashOnDelivery")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Оплата при отриманні</strong>
                                    <span>Готівкою або карткою кур'єру чи у відділенні</span>
                                </span>
                            </label>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="4" hidden>
                        <h2>Перевірте замовлення</h2>

                        <div class="checkout-review-block">
                            <h3>Адреса доставки</h3>
                            <p data-review-address>-</p>
                        </div>

                        <div class="checkout-review-block">
                            <h3>Доставка та оплата</h3>
                            <dl>
                                <div class="checkout-review-row"><dt>Спосіб доставки</dt><dd data-review-carrier>-</dd></div>
                                <div class="checkout-review-row"><dt>Спосіб оплати</dt><dd data-review-payment>-</dd></div>
                            </dl>
                        </div>

                        <div class="checkout-review-block">
                            <h3>Промокод</h3>
                            <div class="checkout-promo">
                                <input type="text" class="form-control" name="PromoCode" placeholder="Введіть промокод" data-promo-input maxlength="30" value="@Model.PromoCode" />
                                <button type="button" class="btn btn-outline-secondary" data-promo-apply>Застосувати</button>
                            </div>
                            <p class="checkout-promo__message" data-promo-message hidden></p>
                            <p class="checkout-promo__hint">Знижка застосовується лише до товарів магазину, який видав промокод.</p>
                        </div>

                        <div class="checkout-review-block">
                            <h3>Товари у замовленні</h3>
                            @if (Model.HasMultipleSellers)
                            {
                                <p class="cart-sellers-note">
                                    <span aria-hidden="true">ⓘ</span>
                                    Товари від @Model.SellerGroups.Count продавців - оформлюються одним замовленням.
                                </p>
                            }
                            @foreach (var group in Model.SellerGroups)
                            {
                                @if (Model.HasMultipleSellers)
                                {
                                    <div class="checkout-review-seller">@group.StoreName</div>
                                }
                                <div class="order-lines">
                                    @foreach (var item in group.Items)
                                    {
                                        <div class="order-line">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img class="order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                                            }
                                            else
                                            {
                                                <div class="order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                                            }
                                            <div>
                                                <div class="order-line__name">@item.ProductName</div>
                                                <div class="order-line__meta">@item.Quantity шт. × @item.Price.ToString("N2") ₴</div>
                                            </div>
                                            <div class="order-line__total">@item.LineTotal.ToString("N2") ₴</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <div class="checkout-step-nav">
                        <button type="button" class="btn btn-outline-secondary" data-step-back hidden>← Назад</button>
                        <button type="button" class="btn btn-primary" data-step-next>Далі →</button>
                        <button type="submit" class="btn btn-primary" data-step-submit hidden>Підтвердити замовлення</button>
                    </div>
                </div>
            </div>

            <aside class="shop-panel summary-card">
                <h2>Ваше замовлення</h2>
                <div class="summary-row"><span>Товарів</span><strong>@units шт.</strong></div>
                <div class="summary-row"><span>Доставка</span><strong>Безкоштовно</strong></div>
                <div class="summary-row" data-promo-summary-row hidden><span>Знижка за промокодом</span><strong data-promo-summary-value>−0,00 ₴</strong></div>
                <div class="summary-total"><span>До сплати</span><span data-order-total="@Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Total.ToString("N2") ₴</span></div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
