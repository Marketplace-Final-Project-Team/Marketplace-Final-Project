@model Marketplace.Web.Models.OrderCreateViewModel

@{
    ViewData["Title"] = Localizer["Оформлення замовлення"];
    var checkoutMessages = new Dictionary<string, string>
    {
        ["Промокод недійсний або термін його дії минув."] = Localizer["Промокод недійсний або термін його дії минув."].Value,
        ["Нова пошта"] = Localizer["Нова пошта"].Value,
        ["Укрпошта"] = Localizer["Укрпошта"].Value,
        ["Оплата при отриманні"] = Localizer["Оплата при отриманні"].Value,
        ["LiqPay (онлайн)"] = Localizer["LiqPay (онлайн)"].Value,
        ["Завантаження відділень…"] = Localizer["Завантаження відділень…"].Value,
        ["Відділень не знайдено"] = Localizer["Відділень не знайдено"].Value,
        ["Оберіть відділення"] = Localizer["Оберіть відділення"].Value,
        ["Не вдалося завантажити відділення"] = Localizer["Не вдалося завантажити відділення"].Value,
        ["Спочатку оберіть місто"] = Localizer["Спочатку оберіть місто"].Value,
        ["Місто не знайдено"] = Localizer["Місто не знайдено"].Value,
        ["Не вдалося завантажити міста"] = Localizer["Не вдалося завантажити міста"].Value,
        ["Введіть промокод."] = Localizer["Введіть промокод."].Value,
        ["Такий промокод не знайдено або він вже не діє."] = Localizer["Такий промокод не знайдено або він вже не діє."].Value,
        ["Промокод {0} застосовано: знижка {1}% на товари магазину «{2}»."] = Localizer["Промокод {0} застосовано: знижка {1}% на товари магазину «{2}»."].Value,
        ["Не вдалося перевірити промокод. Спробуйте ще раз."] = Localizer["Не вдалося перевірити промокод. Спробуйте ще раз."].Value,
    };
    var units = Model.Items.Sum(item => item.Quantity);
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart-sellers.css" asp-append-version="true" />
}

<script id="checkout-messages" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(checkoutMessages))</script>

<div class="shop-page">
    <a asp-controller="Cart" asp-action="Index" class="shop-back">← @Localizer["Назад до кошика"]</a>
    <header class="shop-header">
        <div>
            <div class="shop-kicker">@Localizer["Оформлення"]</div>
            <h1 class="shop-title">@Localizer["Оформлення замовлення"]</h1>
            <p class="shop-subtitle">@Localizer["Вкажіть дані отримувача, перевірте доставку й оплату, підтвердіть замовлення."]</p>
        </div>
    </header>

    <div class="checkout-stepper" role="list" aria-label="@Localizer["Кроки оформлення замовлення"]">
        <div class="checkout-stepper__step" data-step-indicator="1">
            <span class="checkout-stepper__dot" aria-hidden="true">1</span>
            <span class="checkout-stepper__label">@Localizer["Отримувач"]</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="2">
            <span class="checkout-stepper__dot" aria-hidden="true">2</span>
            <span class="checkout-stepper__label">@Localizer["Доставка"]</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="3">
            <span class="checkout-stepper__dot" aria-hidden="true">3</span>
            <span class="checkout-stepper__label">@Localizer["Оплата"]</span>
        </div>
        <div class="checkout-stepper__step" data-step-indicator="4">
            <span class="checkout-stepper__dot" aria-hidden="true">4</span>
            <span class="checkout-stepper__label">@Localizer["Огляд"]</span>
        </div>
    </div>

    <form asp-action="Create" method="post" class="checkout-form" id="checkout-form">
        <div class="checkout-layout">
            <div class="checkout-card">
                <div asp-validation-summary="All" class="alert alert-danger m-3" role="alert"></div>

                <div class="checkout-section">
                    <section class="checkout-step" data-step="1">
                        <h2>@Localizer["Дані отримувача"]</h2>
                        <div class="checkout-fields">
                            <div>
                                <label asp-for="RecipientLastName" class="form-label">@Localizer["Прізвище"] *</label>
                                <input asp-for="RecipientLastName" type="text" class="form-control" placeholder="@Localizer["Введіть своє прізвище"]" autocomplete="family-name" required maxlength="100" aria-describedby="RecipientLastName-error" />
                                <span asp-validation-for="RecipientLastName" id="RecipientLastName-error" class="text-danger small"></span>
                            </div>
                            <div>
                                <label asp-for="RecipientFirstName" class="form-label">@Localizer["Ім’я"] *</label>
                                <input asp-for="RecipientFirstName" type="text" class="form-control" placeholder="@Localizer["Введіть своє ім’я"]" autocomplete="given-name" required maxlength="100" aria-describedby="RecipientFirstName-error" />
                                <span asp-validation-for="RecipientFirstName" id="RecipientFirstName-error" class="text-danger small"></span>
                            </div>
                            <div>
                                <label for="RecipientPhoneNumber" class="form-label">@Localizer["Телефон"] *</label>
                                <div class="checkout-phone">
                                    <span class="checkout-phone__prefix" id="RecipientPhone-prefix">+380</span>
                                    <input id="RecipientPhoneNumber" type="tel" class="form-control" data-phone-number
                                           data-phone-invalid="@Localizer["Введіть український номер: +380 та 9 цифр"]"
                                           value="@(Model.RecipientPhone?.StartsWith("+380") == true ? Model.RecipientPhone[4..] : string.Empty)"
                                           placeholder="@Localizer["Введіть номер телефону"]" autocomplete="tel-national" inputmode="numeric"
                                           required maxlength="9" pattern="[0-9]{9}" aria-describedby="RecipientPhone-prefix RecipientPhone-error" />
                                </div>
                                <input asp-for="RecipientPhone" type="hidden" data-phone-full />
                                <span asp-validation-for="RecipientPhone" id="RecipientPhone-error" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="2" hidden>
                        <h2>@Localizer["Спосіб доставки"]</h2>

                        <div class="checkout-carrier-options">
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="NovaPoshta" data-carrier-radio checked="@(Model.DeliveryCarrier == "NovaPoshta")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>@Localizer["Нова пошта"]</strong>
                                    <span>@Localizer["Доставка у відділення або поштомат"]</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="Ukrposhta" data-carrier-radio checked="@(Model.DeliveryCarrier == "Ukrposhta")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>@Localizer["Укрпошта"]</strong>
                                    <span>@Localizer["Доставка на вказану адресу"]</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="DeliveryCarrier" value="Meest" data-carrier-radio checked="@(Model.DeliveryCarrier == "Meest")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>Meest Express</strong>
                                    <span>@Localizer["Доставка на вказану адресу"]</span>
                                </span>
                            </label>
                        </div>

                        <div class="checkout-nova-poshta" data-carrier-panel="NovaPoshta">
                            <div class="checkout-fields">
                                <div>
                                    <label class="form-label">@Localizer["Місто"]</label>
                                    <input type="text" class="form-control" placeholder="@Localizer["Почніть вводити назву міста"]" autocomplete="off" data-np-city-input value="@Model.NovaPoshtaCityName" />
                                    <input type="hidden" name="NovaPoshtaCityRef" data-np-city-ref value="@Model.NovaPoshtaCityRef" />
                                    <input type="hidden" name="NovaPoshtaCityName" data-np-city-name value="@Model.NovaPoshtaCityName" />
                                </div>
                                <div>
                                    <label class="form-label">@Localizer["Відділення / поштомат"]</label>
                                    <select class="form-select" data-np-branch-select disabled>
                                        <option value="">@Localizer["Спочатку оберіть місто"]</option>
                                    </select>
                                    <input type="hidden" name="NovaPoshtaBranchRef" data-np-branch-ref value="@Model.NovaPoshtaBranchRef" />
                                    <input type="hidden" name="NovaPoshtaBranchName" data-np-branch-name value="@Model.NovaPoshtaBranchName" />
                                    <span class="text-danger small" data-np-branch-error hidden>@Localizer["Оберіть відділення Нової пошти"]</span>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-info-card" data-carrier-panel="Ukrposhta" hidden>
                            <strong>@Localizer["Укрпошта"]</strong>
                            <span>@Localizer["Кур'єрська доставка. Орієнтовний термін - 3–5 робочих днів."]</span>
                        </div>

                        <div class="checkout-info-card" data-carrier-panel="Meest" hidden>
                            <strong>Meest Express</strong>
                            <span>@Localizer["Кур'єрська доставка. Орієнтовний термін - 2–4 робочі дні."]</span>
                        </div>

                        <div class="checkout-nova-poshta" data-carrier-panel="Ukrposhta,Meest" hidden>
                            <div class="checkout-fields">
                                <div>
                                    <label class="form-label">@Localizer["Місто доставки"]</label>
                                    <input type="text" name="DeliveryCity" class="form-control" placeholder="@Localizer["Наприклад, Львів"]" required maxlength="100" value="@Model.DeliveryCity" />
                                </div>
                                <div>
                                    <label class="form-label">@Localizer["Адреса доставки"]</label>
                                    <input type="text" name="DeliveryStreet" class="form-control" placeholder="@Localizer["вул. Хрещатик, 1, кв. 10"]" required maxlength="250" value="@Model.DeliveryStreet" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="3" hidden>
                        <h2>@Localizer["Спосіб оплати"]</h2>

                        <div class="checkout-carrier-options">
                            <label class="checkout-carrier-option">
                                <input type="radio" name="PaymentMethod" value="Online" data-payment-radio checked="@(Model.PaymentMethod == "Online")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>@Localizer["Онлайн-оплата через LiqPay"]</strong>
                                    <span>@Localizer["Після підтвердження ви перейдете на безпечну сторінку оплати"]</span>
                                </span>
                            </label>
                            <label class="checkout-carrier-option">
                                <input type="radio" name="PaymentMethod" value="CashOnDelivery" data-payment-radio checked="@(Model.PaymentMethod == "CashOnDelivery")" />
                                <span class="checkout-carrier-option__body">
                                    <strong>@Localizer["Оплата при отриманні"]</strong>
                                    <span>@Localizer["Готівкою або карткою кур'єру чи у відділенні"]</span>
                                </span>
                            </label>
                        </div>
                    </section>

                    <section class="checkout-step" data-step="4" hidden>
                        <h2>@Localizer["Перевірте замовлення"]</h2>

                        <div class="checkout-review-block">
                            <h3>@Localizer["Дані отримувача"]</h3>
                            <dl>
                                <div class="checkout-review-row"><dt>@Localizer["Отримувач"]</dt><dd data-review-recipient>-</dd></div>
                                <div class="checkout-review-row"><dt>@Localizer["Телефон"]</dt><dd data-review-phone>-</dd></div>
                            </dl>
                        </div>

                        <div class="checkout-review-block">
                            <h3>@Localizer["Доставка та оплата"]</h3>
                            <dl>
                                <div class="checkout-review-row"><dt>@Localizer["Служба доставки"]</dt><dd data-review-carrier>-</dd></div>
                                <div class="checkout-review-row"><dt>@Localizer["Адреса"]</dt><dd data-review-address>-</dd></div>
                                <div class="checkout-review-row"><dt>@Localizer["Спосіб оплати"]</dt><dd data-review-payment>-</dd></div>
                            </dl>
                        </div>

                        <div class="checkout-review-block">
                            <h3>@Localizer["Промокод"]</h3>
                            <div class="checkout-promo">
                                <input type="text" class="form-control" name="PromoCode" placeholder="@Localizer["Введіть промокод"]" data-promo-input maxlength="30" value="@Model.PromoCode" />
                                <button type="button" class="btn btn-outline-secondary" data-promo-apply>@Localizer["Застосувати"]</button>
                            </div>
                            <p class="checkout-promo__message" data-promo-message hidden></p>
                            <p class="checkout-promo__hint">@Localizer["Знижка застосовується лише до товарів магазину, який видав промокод."]</p>
                        </div>

                        <div class="checkout-review-block">
                            <h3>@Localizer["Товари у замовленні"]</h3>
                            @if (Model.HasMultipleSellers)
                            {
                                <p class="cart-sellers-note">
                                    <span aria-hidden="true">ⓘ</span>
                                    @Localizer["Товари від {0} продавців - оформлюються одним замовленням.", Model.SellerGroups.Count]
                                </p>
                            }
                            @foreach (var group in Model.SellerGroups)
                            {
                                @if (Model.HasMultipleSellers)
                                {
                                    <div class="checkout-review-seller">@group.StoreName</div>
                                }
                                <div class="order-lines">
                                    @foreach (var item in group.Items)
                                    {
                                        <div class="order-line">
                                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                            {
                                                <img class="order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                                            }
                                            else
                                            {
                                                <div class="order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                                            }
                                            <div>
                                                <div class="order-line__name">@item.ProductName</div>
                                                @if (!string.IsNullOrWhiteSpace(item.VariantSize))
                                                {
                                                    <div class="order-line__variant">@Localizer["Розмір:"] <strong>@item.VariantSize</strong></div>
                                                }
                                                <div class="order-line__meta">@item.Quantity @Localizer["шт."] × @item.Price.ToString("N2") ₴</div>
                                            </div>
                                            <div class="order-line__total">@item.LineTotal.ToString("N2") ₴</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    <div class="checkout-step-nav">
                        <button type="button" class="btn btn-outline-secondary" data-step-back hidden>← @Localizer["Назад"]</button>
                        <button type="button" class="btn btn-primary" data-step-next>@Localizer["Далі →"]</button>
                        <button type="submit" class="btn btn-primary" data-step-submit hidden>@Localizer["Підтвердити замовлення"]</button>
                    </div>
                </div>
            </div>

            <aside class="shop-panel summary-card">
                <h2>@Localizer["Ваше замовлення"]</h2>
                <div class="summary-row"><span>@Localizer["Товарів"]</span><strong>@units @Localizer["шт."]</strong></div>
                <div class="summary-row"><span>@Localizer["Доставка"]</span><strong>@Localizer["Безкоштовно"]</strong></div>
                <div class="summary-row" data-promo-summary-row hidden><span>@Localizer["Знижка за промокодом"]</span><strong data-promo-summary-value>−0,00 ₴</strong></div>
                <div class="summary-total"><span>@Localizer["До сплати"]</span><span data-order-total="@Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Total.ToString("N2") ₴</span></div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
