@model Marketplace.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = "Деталі замовлення";
}

@functions {
    private static string StatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => "Очікує підтвердження",
        Marketplace.Domain.Enums.OrderStatus.Confirmed => "Підтверджено",
        Marketplace.Domain.Enums.OrderStatus.Shipped => "Відправлено",
        Marketplace.Domain.Enums.OrderStatus.Delivered => "Доставлено",
        Marketplace.Domain.Enums.OrderStatus.Canceled => "Скасовано",
        _ => status.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
}

<div class="shop-page">
    <a asp-action="Index" class="shop-back">← До всіх замовлень</a>
    <header class="shop-header">
        <div>
            <div class="shop-kicker">Замовлення #@Model.Id.ToString()[..8].ToUpperInvariant()</div>
            <h1 class="shop-title">Деталі замовлення</h1>
            <p class="shop-subtitle">Створено @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
        <a asp-action="Delivery" asp-route-id="@Model.Id" class="btn btn-primary">Відстежити доставку</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    <div class="order-details-layout">
        <section class="shop-panel order-info">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <h2 class="mb-0">Склад замовлення</h2>
                <span class="order-status order-status--@Model.Status.ToString().ToLowerInvariant()">@StatusLabel(Model.Status)</span>
            </div>
            <div class="order-lines mt-4">
                @foreach (var item in Model.Items)
                {
                    <div class="order-line">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img class="order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                        }
                        <div>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="order-line__name">@item.ProductName</a>
                            <div class="order-line__meta">@item.Quantity шт. × @item.UnitPrice.ToString("N2") ₴</div>
                        </div>
                        <div class="order-line__total">@item.LineTotal.ToString("N2") ₴</div>
                    </div>
                }
            </div>
        </section>

        <aside class="shop-panel order-info">
            <h2>Інформація</h2>
            <dl>
                <div class="order-info__row">
                    <dt>Статус</dt>
                    <dd>@StatusLabel(Model.Status)</dd>
                </div>
                <div class="order-info__row">
                    <dt>Адреса</dt>
                    <dd>@Model.ShippingCountry, @Model.ShippingCity,<br />@Model.ShippingStreet</dd>
                </div>
                <div class="order-info__row">
                    <dt>Оплата</dt>
                    <dd>При отриманні</dd>
                </div>
                <div class="order-info__row">
                    <dt>Разом</dt>
                    <dd>@Model.TotalAmount.ToString("N2") ₴</dd>
                </div>
            </dl>
        </aside>
    </div>

    @if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered)
    {
        <section class="shop-panel postsale-panel">
            <h2>Післяпродажний сервіс та безпека</h2>
            <div class="postsale-protection">
                <span class="postsale-protection__icon" aria-hidden="true">🛡</span>
                <div>
                    <strong>Захист покупця</strong>
                    <span>Кошти продавцю переказуються лише після підтвердження отримання товару. Повернення можливе протягом 14 днів з дати доставки.</span>
                </div>
            </div>
            <div class="postsale-actions">
                <button type="button" class="btn btn-outline-secondary" data-postsale-open="return">Оформити повернення</button>
                <button type="button" class="btn btn-outline-secondary" data-postsale-open="dispute">Відкрити спір</button>
            </div>
        </section>
    }
</div>

<div class="postsale-modal" data-postsale-modal="return" hidden>
    <div class="postsale-modal__card">
        <button type="button" class="postsale-modal__close" aria-label="Закрити" data-postsale-close>×</button>
        <div data-postsale-form>
            <h3>Оформлення повернення</h3>
            <p>Замовлення #@Model.Id.ToString()[..8].ToUpperInvariant()</p>
            <label class="form-label mt-2">Причина повернення</label>
            <select class="form-select">
                <option>Товар не підійшов за розміром</option>
                <option>Товар не відповідає опису</option>
                <option>Отримано пошкоджений товар</option>
                <option>Передумав(-ла)</option>
                <option>Інше</option>
            </select>
            <label class="form-label mt-3">Коментар (необов'язково)</label>
            <textarea class="form-control" rows="3" placeholder="Розкажіть детальніше..."></textarea>
            <button type="button" class="btn btn-primary mt-3 w-100" data-postsale-submit="return">Надіслати заявку</button>
        </div>
        <div class="postsale-modal__success" data-postsale-success hidden>
            <span aria-hidden="true">✓</span>
            <h3>Заявку прийнято</h3>
            <p>Ми надіслали інструкції з поверненням на вашу пошту. Очікуйте на зворотний зв'язок протягом 1–2 робочих днів.</p>
            <button type="button" class="btn btn-outline-secondary" data-postsale-close>Закрити</button>
        </div>
    </div>
</div>

<div class="postsale-modal" data-postsale-modal="dispute" hidden>
    <div class="postsale-modal__card">
        <button type="button" class="postsale-modal__close" aria-label="Закрити" data-postsale-close>×</button>
        <div data-postsale-form>
            <h3>Центр вирішення спірних питань</h3>
            <p>Замовлення #@Model.Id.ToString()[..8].ToUpperInvariant()</p>
            <label class="form-label mt-2">Тип проблеми</label>
            <select class="form-select">
                <option>Товар не прийшов</option>
                <option>Товар не відповідає опису</option>
                <option>Продавець не виходить на зв'язок</option>
                <option>Інше</option>
            </select>
            <label class="form-label mt-3">Опишіть ситуацію</label>
            <textarea class="form-control" rows="3" placeholder="Що сталося?"></textarea>
            <button type="button" class="btn btn-primary mt-3 w-100" data-postsale-submit="dispute">Відкрити спір</button>
        </div>
        <div class="postsale-modal__success" data-postsale-success hidden>
            <span aria-hidden="true">✓</span>
            <h3>Спір відкрито</h3>
            <p>Підтримка маркетплейсу підключиться до вирішення ситуації та зв'яжеться з вами протягом 24 годин.</p>
            <button type="button" class="btn btn-outline-secondary" data-postsale-close>Закрити</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/postsale.js" asp-append-version="true"></script>
}
