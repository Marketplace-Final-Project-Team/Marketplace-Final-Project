@model Marketplace.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = Localizer["Деталі замовлення"];
    var orderCreatedMessage = TempData["Success"] as string;
    var showOrderSuccess = !string.IsNullOrWhiteSpace(orderCreatedMessage);
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => Localizer["Очікує підтвердження"].Value,
        Marketplace.Domain.Enums.OrderStatus.Confirmed => Localizer["Підтверджено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Shipped => Localizer["Відправлено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Delivered => Localizer["Доставлено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Canceled => Localizer["Скасовано"].Value,
        _ => status.ToString()
    };

    private string PostSaleStatusLabel(Marketplace.Domain.Enums.PostSaleRequestStatus status) => status switch
    {
        Marketplace.Domain.Enums.PostSaleRequestStatus.Approved => Localizer["Повернення підтверджено - кошти повернуто"].Value,
        Marketplace.Domain.Enums.PostSaleRequestStatus.Refunded => Localizer["Повернення підтверджено - кошти повернуто"].Value,
        Marketplace.Domain.Enums.PostSaleRequestStatus.Rejected => Localizer["У поверненні відмовлено"].Value,
        Marketplace.Domain.Enums.PostSaleRequestStatus.AwaitingSellerConfirmation => Localizer["Адміністратор схвалив повернення · очікує підтвердження продавця"].Value,
        Marketplace.Domain.Enums.PostSaleRequestStatus.SellerDisputed => Localizer["Продавець оскаржив повернення · на розгляді адміністратора"].Value,
        _ => Localizer["Заявку на повернення подано · очікує розгляду"].Value
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-success.css" asp-append-version="true" />
}

<div class="shop-page">
    @if (showOrderSuccess)
    {
        <section class="order-success" aria-labelledby="order-success-title">
            <div class="order-success__mark" aria-hidden="true">✓</div>
            <span class="shop-kicker">@Localizer["Оформлення завершено"]</span>
            <h1 id="order-success-title">@Localizer["Дякуємо за замовлення!"]</h1>
            <p class="order-success__lead">@orderCreatedMessage</p>
            <p class="order-success__number">
                @Localizer["Ваш номер замовлення"]
                <strong>#@Model.Id.ToString()[..8].ToUpperInvariant()</strong>
            </p>

            <dl class="order-success__details">
                <div>
                    <dt>@Localizer["Сума до сплати"]</dt>
                    <dd>@Model.TotalAmount.ToString("N2") ₴</dd>
                </div>
                <div>
                    <dt>@Localizer["Оплата"]</dt>
                    <dd>@(Model.PaymentMethodLabel ?? Localizer["LiqPay (онлайн)"].Value)</dd>
                </div>
                <div>
                    <dt>@Localizer["Доставка"]</dt>
                    <dd>@(Model.DeliveryMethodLabel ?? Localizer["Кур'єром на вказану адресу"].Value)</dd>
                </div>
                <div>
                    <dt>@Localizer["Адреса"]</dt>
                    <dd>@Model.ShippingCountry, @Model.ShippingCity, @Model.ShippingStreet</dd>
                </div>
            </dl>

            <div class="order-success__actions">
                <a asp-action="Index" class="btn btn-primary">@Localizer["Перейти до моїх замовлень"]</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">@Localizer["Продовжити покупки"]</a>
                <a asp-controller="Home" asp-action="Support" class="order-success__support">@Localizer["Звернутися до підтримки"]</a>
            </div>
        </section>
    }
    else
    {
    <a asp-action="Index" class="shop-back">← @Localizer["До всіх замовлень"]</a>

    <header class="shop-header">
        <div>
            <div class="shop-kicker">@Localizer["Замовлення #"]@Model.Id.ToString()[..8].ToUpperInvariant()</div>
            <h1 class="shop-title">@Localizer["Деталі замовлення"]</h1>
            <p class="shop-subtitle">@Localizer["Створено"] @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
        <a asp-action="Delivery" asp-route-id="@Model.Id" class="btn btn-primary">@Localizer["Відстежити доставку"]</a>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="order-details-layout">
        <section class="shop-panel order-info">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <h2 class="mb-0">@Localizer["Склад замовлення"]</h2>
                <span class="order-status order-status--@Model.Status.ToString().ToLowerInvariant()">@StatusLabel(Model.Status)</span>
            </div>

            <div class="order-lines mt-4">
                @foreach (var item in Model.Items)
                {
                    <div class="order-line">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img class="order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                        }
                        <div>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="order-line__name">@item.ProductName</a>
                            @if (!string.IsNullOrWhiteSpace(item.VariantSize))
                            {
                                <div class="order-line__variant">@Localizer["Розмір:"] <strong>@item.VariantSize</strong></div>
                            }
                            <div class="order-line__meta">@item.Quantity @Localizer["шт."] × @item.UnitPrice.ToString("N2") ₴</div>
                        </div>
                        <div class="order-line__total">@item.LineTotal.ToString("N2") ₴</div>
                    </div>

                    @if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered)
                    {
                        @if (item.ReturnRequest is null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary order-line__return-btn my-2" data-postsale-open="return" data-order-item-id="@item.Id">@Localizer["Оформити повернення"]</button>
                        }
                        else
                        {
                            <div class="postsale-status postsale-status--@item.ReturnRequest.Status.ToString().ToLowerInvariant() my-2 p-3 border rounded">
                                <strong>@PostSaleStatusLabel(item.ReturnRequest.Status)</strong>
                                @if (item.ReturnRequest.Status != Marketplace.Domain.Enums.PostSaleRequestStatus.Rejected)
                                {
                                    <a asp-controller="Support" asp-action="RefundChatByOrderItem" asp-route-orderItemId="@item.Id" class="btn btn-sm btn-outline-primary mt-2">
                                        @Localizer["Повернутися в чат"]
                                    </a>
                                }
                                <div class="text-muted small">@item.ReturnRequest.SubmittedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") · @Localizer["Причина:"] @item.ReturnRequest.Reason</div>

                                @if (!string.IsNullOrWhiteSpace(item.ReturnRequest.Comment))
                                {
                                    <div class="mt-1">«@item.ReturnRequest.Comment»</div>
                                }

                                @if (item.ReturnRequest.PhotoUrls.Any())
                                {
                                    <div class="postsale-photos mt-2">
                                        @foreach (var url in item.ReturnRequest.PhotoUrls)
                                        {
                                            <a href="@url" target="_blank" rel="noopener" class="me-2">
                                                <img src="@url" alt="@Localizer["Фото до заявки"]" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                            </a>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.ReturnRequest.SellerResponse))
                                {
                                    <div class="mt-2 text-primary small"><strong>@Localizer["Відповідь повернення:"]</strong> @item.ReturnRequest.SellerResponse</div>
                                }
                            </div>
                        }
                    }
                }
            </div>
        </section>

        <aside class="shop-panel order-info">
            <h2>@Localizer["Інформація"]</h2>
            <dl>
                <div class="order-info__row">
                    <dt>@Localizer["Статус"]</dt>
                    <dd>@StatusLabel(Model.Status)</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.RecipientLastName))
                {
                    <div class="order-info__row">
                        <dt>@Localizer["Отримувач"]</dt>
                        <dd>@Model.RecipientLastName @Model.RecipientFirstName</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.RecipientPhone))
                {
                    <div class="order-info__row">
                        <dt>@Localizer["Телефон"]</dt>
                        <dd>@Model.RecipientPhone</dd>
                    </div>
                }
                <div class="order-info__row">
                    <dt>@Localizer["Служба доставки"]</dt>
                    <dd>@((Model.DeliveryCarrierLabel != null ? Localizer[Model.DeliveryCarrierLabel].Value : null) ?? Localizer["Кур'єром на вказану адресу"].Value)</dd>
                </div>
                <div class="order-info__row">
                    <dt>@Localizer["Адреса"]</dt>
                    <dd>@Model.ShippingCity, @Model.ShippingStreet</dd>
                </div>
                <div class="order-info__row">
                    <dt>@Localizer["Оплата"]</dt>
                    <dd>@((Model.PaymentMethodLabel != null ? Localizer[Model.PaymentMethodLabel].Value : null) ?? Localizer["LiqPay (онлайн)"].Value)</dd>
                </div>
                <div class="order-info__row">
                    <dt>@Localizer["Разом"]</dt>
                    <dd><strong>@Model.TotalAmount.ToString("N2") ₴</strong></dd>
                </div>
            </dl>
        </aside>
    </div>

    @if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered)
    {
        <section class="shop-panel postsale-panel">
            <h2 class="postsale-panel__title">@Localizer["Післяпродажний сервіс та безпека"]</h2>
            <div class="postsale-protection">
                <span class="postsale-protection__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
                        <path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.4 7.5 9.5 4.4-1.1 7.5-4.9 7.5-9.5V6L12 3Z" />
                        <path d="m9 12 2.2 2.2L15.5 10" />
                    </svg>
                </span>
                <div class="postsale-protection__body">
                    <strong>@Localizer["Захист покупця"]</strong>
                    <p>@Localizer["Кошти продавцю переказуються лише після підтвердження отримання товару. Повернення можливе протягом 14 днів з дати доставки — окремо на кожен товар."]</p>
                </div>
            </div>
        </section>
    }
    }
</div>

@if (!showOrderSuccess && Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered && Model.Items.Any(i => i.ReturnRequest is null))
{
    <div class="postsale-modal" data-postsale-modal="return" hidden>
        <div class="postsale-modal__card">
            <button type="button" class="postsale-modal__close" aria-label="@Localizer["Закрити"]" data-postsale-close>×</button>
            <form asp-controller="Order" asp-action="RequestReturn" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <input type="hidden" name="orderItemId" data-postsale-item-id-field />

                <h3>@Localizer["Оформлення повернення"]</h3>
                <p class="text-muted small">@Localizer["Замовлення #"]@Model.Id.ToString()[..8].ToUpperInvariant()</p>

                <label class="form-label mt-2">@Localizer["Причина повернення"]</label>
                <select class="form-select" name="reason" required>
                    <option value="">@Localizer["Оберіть причину"]</option>
                    <option>@Localizer["Товар пошкоджений або несправний"]</option>
                    <option>@Localizer["Товар не відповідає опису"]</option>
                    <option>@Localizer["Отримано не той товар"]</option>
                    <option>@Localizer["Не підійшов розмір або колір"]</option>
                    <option>@Localizer["Передумав(-ла)"]</option>
                    <option>@Localizer["Інше"]</option>
                </select>

                <label class="form-label mt-3">@Localizer["Опишіть ситуацію"]</label>
                <textarea class="form-control" name="comment" rows="3" minlength="10" placeholder="@Localizer["Розкажіть детальніше, що не так із товаром (мінімум 10 символів)..."]" required></textarea>

                <label class="form-label mt-3">@Localizer["Фото товару"]</label>
                <input type="file" class="form-control" name="photos" accept="image/*" multiple required />
                <div class="form-text">@Localizer["Додайте від 1 до 5 фото — це підтвердження стану товару для продавця."]</div>

                <button type="submit" class="btn btn-primary mt-4 w-100">@Localizer["Надіслати заявку"]</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/postsale.js" asp-append-version="true"></script>
}
