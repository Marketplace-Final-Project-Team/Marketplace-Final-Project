@model Marketplace.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = "Деталі замовлення";
}

@functions {
    private static string StatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => "Очікує підтвердження",
        Marketplace.Domain.Enums.OrderStatus.Confirmed => "Підтверджено",
        Marketplace.Domain.Enums.OrderStatus.Shipped => "Відправлено",
        Marketplace.Domain.Enums.OrderStatus.Delivered => "Доставлено",
        Marketplace.Domain.Enums.OrderStatus.Canceled => "Скасовано",
        _ => status.ToString()
    };

    private static string PostSaleStatusLabel(Marketplace.Domain.Enums.PostSaleRequestStatus status) => status switch
    {
        Marketplace.Domain.Enums.PostSaleRequestStatus.Approved => "Повернення підтверджено - кошти повернуто",
        Marketplace.Domain.Enums.PostSaleRequestStatus.Rejected => "У поверненні відмовлено",
        _ => "Заявку на повернення подано · очікує розгляду"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/postsale.css" asp-append-version="true" />
}

<div class="shop-page">
    <a asp-action="Index" class="shop-back">← До всіх замовлень</a>

    <header class="shop-header">
        <div>
            <div class="shop-kicker">Замовлення #@Model.Id.ToString()[..8].ToUpperInvariant()</div>
            <h1 class="shop-title">Деталі замовлення</h1>
            <p class="shop-subtitle">Створено @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
        <a asp-action="Delivery" asp-route-id="@Model.Id" class="btn btn-primary">Відстежити доставку</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <div class="order-details-layout">
        <section class="shop-panel order-info">
            <div class="d-flex justify-content-between align-items-center gap-3">
                <h2 class="mb-0">Склад замовлення</h2>
                <span class="order-status order-status--@Model.Status.ToString().ToLowerInvariant()">@StatusLabel(Model.Status)</span>
            </div>

            <div class="order-lines mt-4">
                @foreach (var item in Model.Items)
                {
                    <div class="order-line">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img class="order-line__media" src="@item.ImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="order-line__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                        }
                        <div>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="order-line__name">@item.ProductName</a>
                            <div class="order-line__meta">@item.Quantity шт. × @item.UnitPrice.ToString("N2") ₴</div>
                        </div>
                        <div class="order-line__total">@item.LineTotal.ToString("N2") ₴</div>
                    </div>

                    @if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered)
                    {
                        @if (item.ReturnRequest is null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary order-line__return-btn my-2" data-postsale-open="return" data-order-item-id="@item.Id">Оформити повернення</button>
                        }
                        else
                        {
                            <div class="postsale-status postsale-status--@item.ReturnRequest.Status.ToString().ToLowerInvariant() my-2 p-3 border rounded">
                                <strong>@PostSaleStatusLabel(item.ReturnRequest.Status)</strong>
                                <div class="text-muted small">@item.ReturnRequest.SubmittedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") · Причина: @item.ReturnRequest.Reason</div>

                                @if (!string.IsNullOrWhiteSpace(item.ReturnRequest.Comment))
                                {
                                    <div class="mt-1">«@item.ReturnRequest.Comment»</div>
                                }

                                @if (item.ReturnRequest.PhotoUrls.Any())
                                {
                                    <div class="postsale-photos mt-2">
                                        @foreach (var url in item.ReturnRequest.PhotoUrls)
                                        {
                                            <a href="@url" target="_blank" rel="noopener" class="me-2">
                                                <img src="@url" alt="Фото до заявки" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                            </a>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.ReturnRequest.SellerResponse))
                                {
                                    <div class="mt-2 text-primary small"><strong>Відповідь продавця:</strong> @item.ReturnRequest.SellerResponse</div>
                                }
                            </div>
                        }
                    }
                }
            </div>
        </section>

        <aside class="shop-panel order-info">
            <h2>Інформація</h2>
            <dl>
                <div class="order-info__row">
                    <dt>Статус</dt>
                    <dd>@StatusLabel(Model.Status)</dd>
                </div>
                <div class="order-info__row">
                    <dt>Адреса</dt>
                    <dd>@Model.ShippingCountry, @Model.ShippingCity,<br />@Model.ShippingStreet</dd>
                </div>
                <div class="order-info__row">
                    <dt>Доставка</dt>
                    <dd>@(Model.DeliveryMethodLabel ?? "Кур'єром на вказану адресу")</dd>
                </div>
                <div class="order-info__row">
                    <dt>Оплата</dt>
                    <dd>@(Model.PaymentMethodLabel ?? "LiqPay (онлайн)")</dd>
                </div>
                <div class="order-info__row">
                    <dt>Разом</dt>
                    <dd><strong>@Model.TotalAmount.ToString("N2") ₴</strong></dd>
                </div>
            </dl>
        </aside>
    </div>

    @if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered)
    {
        <section class="shop-panel postsale-panel mt-4">
            <h2>Післяпродажний сервіс та безпека</h2>
            <div class="postsale-protection d-flex align-items-start gap-3 mt-3">
                <span class="postsale-protection__icon fs-3" aria-hidden="true">🛡</span>
                <div>
                    <strong>Захист покупця</strong>
                    <p class="mb-0 text-muted">Кошти продавцю переказуються лише після підтвердження отримання товару. Повернення можливе протягом 14 днів з дати доставки — окремо на кожен товар.</p>
                </div>
            </div>
        </section>
    }
</div>

@if (Model.Status is Marketplace.Domain.Enums.OrderStatus.Delivered && Model.Items.Any(i => i.ReturnRequest is null))
{
    <div class="postsale-modal" data-postsale-modal="return" hidden>
        <div class="postsale-modal__card">
            <button type="button" class="postsale-modal__close" aria-label="Закрити" data-postsale-close>×</button>
            <form asp-controller="Order" asp-action="RequestReturn" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <input type="hidden" name="orderItemId" data-postsale-item-id-field />

                <h3>Оформлення повернення</h3>
                <p class="text-muted small">Замовлення #@Model.Id.ToString()[..8].ToUpperInvariant()</p>

                <label class="form-label mt-2">Причина повернення</label>
                <select class="form-select" name="reason" required>
                    <option value="">Оберіть причину</option>
                    <option>Товар пошкоджений або несправний</option>
                    <option>Товар не відповідає опису</option>
                    <option>Отримано не той товар</option>
                    <option>Не підійшов розмір або колір</option>
                    <option>Передумав(-ла)</option>
                    <option>Інше</option>
                </select>

                <label class="form-label mt-3">Опишіть ситуацію</label>
                <textarea class="form-control" name="comment" rows="3" minlength="10" placeholder="Розкажіть детальніше, що не так із товаром (мінімум 10 символів)..." required></textarea>

                <label class="form-label mt-3">Фото товару</label>
                <input type="file" class="form-control" name="photos" accept="image/*" multiple required />
                <div class="form-text">Додайте від 1 до 5 фото — це підтвердження стану товару для продавця.</div>

                <button type="submit" class="btn btn-primary mt-4 w-100">Надіслати заявку</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/postsale.js" asp-append-version="true"></script>
}