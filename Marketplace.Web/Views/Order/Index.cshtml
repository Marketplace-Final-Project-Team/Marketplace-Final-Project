@model IReadOnlyList<Marketplace.Web.Models.OrderListItemViewModel>

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = SharedLocalizer["Мої замовлення"];
}

@functions {
    private string StatusLabel(Marketplace.Domain.Enums.OrderStatus status) => status switch
    {
        Marketplace.Domain.Enums.OrderStatus.Pending => Localizer["Очікує підтвердження"].Value,
        Marketplace.Domain.Enums.OrderStatus.Confirmed => Localizer["Підтверджено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Shipped => Localizer["Відправлено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Delivered => Localizer["Доставлено"].Value,
        Marketplace.Domain.Enums.OrderStatus.Canceled => Localizer["Скасовано"].Value,
        _ => status.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="shop-page">
    <header class="shop-header">
        <div>
            <div class="shop-kicker">@Localizer["Особистий кабінет"]</div>
            <h1 class="shop-title">@SharedLocalizer["Мої замовлення"]</h1>
            <p class="shop-subtitle">@Localizer["Історія покупок, склад замовлень і поточний статус доставки."]</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">@Localizer["До каталогу"]</a>
    </header>

    @if (Model.Count == 0)
    {
        <section class="shop-empty">
            <div class="shop-empty__icon" aria-hidden="true">□</div>
            <h2>@Localizer["Замовлень поки немає"]</h2>
            <p>@Localizer["Після оформлення покупки вона з’явиться на цій сторінці."]</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">@Localizer["Перейти до каталогу"]</a>
        </section>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <article class="order-card">
                    <div class="order-card__top">
                        <div>
                            <div class="order-card__number">@Localizer["Замовлення #"]@order.Id.ToString()[..8].ToUpperInvariant()</div>
                            <div class="order-card__date">@order.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") · @order.ItemsCount @Localizer["шт."]</div>
                        </div>
                        <span class="order-status order-status--@order.Status.ToString().ToLowerInvariant()">@StatusLabel(order.Status)</span>
                    </div>
                    <div class="order-card__bottom">
                        <div>
                            <div class="order-card__address">@Localizer["Доставка:"] @order.ShippingAddress</div>
                            @if (!string.IsNullOrWhiteSpace(order.DeliveryMethodLabel))
                            {
                                <div class="order-card__address">@order.DeliveryMethodLabel</div>
                            }
                            <div class="order-card__total">@order.TotalAmount.ToString("N2") ₴</div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Деталі"]</a>
                            <a asp-action="Delivery" asp-route-id="@order.Id" class="btn btn-sm btn-primary">@Localizer["Доставка"]</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
