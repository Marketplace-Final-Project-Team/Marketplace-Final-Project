@model Marketplace.Web.Models.CartPageViewModel

@{
    ViewData["Title"] = "Кошик";
}

@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart-sellers.css" asp-append-version="true" />
}

<div class="shop-page">
    <header class="shop-header">
        <div>
            <div class="shop-kicker">Покупки</div>
            <h1 class="shop-title">Кошик</h1>
            <p class="shop-subtitle">Перевірте товари та кількість перед оформленням замовлення.</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">Продовжити покупки</a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.SellerGroups.Count == 0)
    {
        <section class="shop-empty">
            <div class="shop-empty__icon" aria-hidden="true">□</div>
            <h2>Кошик порожній</h2>
            <p>Додайте кілька товарів із каталогу, щоб оформити замовлення.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти до каталогу</a>
        </section>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-list">
                @if (Model.HasMultipleSellers)
                {
                    <p class="cart-sellers-note">
                        <span aria-hidden="true">ⓘ</span>
                        Товари згруповано за @Model.SellerGroups.Count продавцями - оформлюються одним замовленням.
                    </p>
                }

                @foreach (var group in Model.SellerGroups)
                {
                    <section class="cart-seller-group">
                        <div class="cart-seller-group__header">
                            @if (!string.IsNullOrWhiteSpace(group.StoreLogoUrl))
                            {
                                <img class="cart-seller-group__logo" src="@group.StoreLogoUrl" alt="@group.StoreName" />
                            }
                            else
                            {
                                <span class="cart-seller-group__logo cart-seller-group__logo--fallback" aria-hidden="true">@group.StoreName[..1].ToUpperInvariant()</span>
                            }
                            <div>
                                <span class="cart-seller-group__label">Продавець</span>
                                <strong>@group.StoreName</strong>
                            </div>
                            <span class="cart-seller-group__subtotal">@group.Subtotal.ToString("N2") ₴ · @group.ItemCount шт.</span>
                        </div>

                        @foreach (var item in group.Items)
                        {
                            <article class="cart-item">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img class="cart-item__media" src="@item.ImageUrl" alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="cart-item__media" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</div>
                                }

                                <div>
                                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="cart-item__name">@item.ProductName</a>
                                    <div class="cart-item__unit">@item.Price.ToString("N2") ₴ за одиницю · доступно @item.StockQuantity</div>

                                    <div class="quantity-control" aria-label="Кількість товару">
                                        <form asp-action="DecreaseQuantity" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Зменшити кількість">−</button>
                                        </form>
                                        <span class="quantity-control__value">@item.Quantity</span>
                                        <form asp-action="IncreaseQuantity" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Збільшити кількість">+</button>
                                        </form>
                                    </div>
                                </div>

                                <div class="cart-item__price">
                                    <strong>@item.LineTotal.ToString("N2") ₴</strong>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="cart-remove">Видалити</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </section>
                }
            </div>

            <aside class="shop-panel summary-card">
                <h2>Разом</h2>
                <div class="summary-row"><span>Товарів</span><strong>@Model.TotalUnits шт.</strong></div>
                @if (Model.HasMultipleSellers)
                {
                    <div class="summary-row"><span>Продавців</span><strong>@Model.SellerGroups.Count</strong></div>
                }
                <div class="summary-row"><span>Доставка</span><strong>Безкоштовно</strong></div>
                <div class="summary-total"><span>До сплати</span><span>@Model.Total.ToString("N2") ₴</span></div>
                <a asp-controller="Order" asp-action="Create" class="btn btn-primary">Оформити замовлення</a>
            </aside>
        </div>
    }
</div>