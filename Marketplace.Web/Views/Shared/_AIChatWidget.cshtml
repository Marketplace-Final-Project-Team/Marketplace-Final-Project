<div class="ai-chat" data-ai-chat>
    <div class="ai-chat__panel" data-ai-chat-panel>
        <header class="ai-chat__header">
            <div class="ai-chat__identity">
                <span class="ai-chat__avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                        <path d="M12 2 9.5 7 4 8l4 4-1 6 5-3 5 3-1-6 4-4-5.5-1z" />
                    </svg>
                </span>
                <div>
                    <strong>@Localizer["AI-асистент"]</strong>
                    <small>@Localizer["Запитайте про товари, замовлення чи доставку"]</small>
                </div>
            </div>
            <button type="button" class="ai-chat__icon-btn" data-ai-chat-close aria-label="@Localizer["Закрити чат"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
        </header>

        <div class="ai-chat__messages" data-ai-chat-messages aria-live="polite">
            <div class="ai-chat__message ai-chat__message--bot">
                <span class="ai-chat__message-avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                        <path d="M12 2 9.5 7 4 8l4 4-1 6 5-3 5 3-1-6 4-4-5.5-1z" />
                    </svg>
                </span>
                <div class="ai-chat__bubble">@Localizer["Вітаю! Я AI-асистент LUNEXA. Чим можу допомогти?"]</div>
            </div>
        </div>

        <div class="ai-chat__typing" data-ai-chat-typing hidden>
            <span class="ai-chat__message-avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                    <path d="M12 2 9.5 7 4 8l4 4-1 6 5-3 5 3-1-6 4-4-5.5-1z" />
                </svg>
            </span>
            <div class="ai-chat__bubble ai-chat__bubble--typing">
                <span></span><span></span><span></span>
            </div>
        </div>

        <form class="ai-chat__form" data-ai-chat-form>
            <textarea class="ai-chat__input" data-ai-chat-input rows="1" maxlength="1000" placeholder="@Localizer["Напишіть повідомлення..."]" aria-label="@Localizer["Повідомлення для AI-асистента"]"></textarea>
            <button type="submit" class="ai-chat__send" data-ai-chat-send aria-label="@Localizer["Надіслати"]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17">
                    <path d="M22 2 11 13" />
                    <path d="M22 2 15 22l-4-9-9-4 20-7Z" />
                </svg>
            </button>
        </form>
    </div>

    <button type="button" class="ai-chat__toggle" data-ai-chat-toggle aria-label="@Localizer["Відкрити чат з AI-асистентом"]" aria-expanded="false">
        <svg class="ai-chat__toggle-icon ai-chat__toggle-icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
        <svg class="ai-chat__toggle-icon ai-chat__toggle-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M18 6 6 18M6 6l12 12" />
        </svg>
    </button>
</div>
