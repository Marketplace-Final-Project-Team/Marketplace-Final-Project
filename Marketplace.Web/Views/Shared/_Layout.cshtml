<!DOCTYPE html>
@inject Marketplace.BLL.Interfaces.ICategoryService CategoryService
@{
    var fullUserName = User.Identity?.Name ?? string.Empty;
    var compactUserName = fullUserName.Contains('@')
        ? fullUserName.Split('@', 2)[0]
        : fullUserName;
    compactUserName = compactUserName.Length > 16
        ? $"{compactUserName[..16]}…"
        : compactUserName;
    var userInitial = string.IsNullOrWhiteSpace(compactUserName)
        ? "U"
        : compactUserName[..1].ToUpperInvariant();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var headerCategories = await CategoryService.GetAllCategories();
}
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marketplace.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search-autocomplete.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cookie-consent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Marketplace.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header__top">
            <div class="site-header__inner">
                <button class="site-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#siteHeaderCollapse" aria-controls="siteHeaderCollapse" aria-expanded="false" aria-label="Меню">
                    <span></span><span></span><span></span>
                </button>

                <a class="site-header__logo" asp-controller="Home" asp-action="Index">Market<span>Place</span></a>

                <div class="site-header__delivery-wrap">
                    @await Component.InvokeAsync("DeliveryLocation")
                </div>

                <form asp-controller="Catalog" asp-action="Index" method="get" class="site-header__search" role="search" data-search-wrapper>
                    <select name="CategoryId" class="site-header__search-category" aria-label="Категорія пошуку">
                        <option value="">Усі категорії</option>
                        @foreach (var category in headerCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <input type="text" name="Search" class="site-header__search-input" placeholder="Пошук товарів на MarketPlace" aria-label="Пошук товарів" autocomplete="off" data-search-autocomplete />
                    <button type="submit" class="site-header__search-btn" aria-label="Шукати">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                </form>

                <div class="site-header__actions">
                    <div id="google_translate_element" class="site-header__lang" title="Мова сайту"></div>

                    @if (isAuthenticated)
                    {
                        <div class="site-header__account dropdown">
                            <button class="site-header__account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@fullUserName">
                                <small>Вітаємо,</small>
                                <strong><span class="nav-user-chip__avatar" aria-hidden="true">@userInitial</span> @compactUserName</strong>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end site-header__account-menu">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Мій профіль</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">Мої замовлення</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Wishlist">Список бажань</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Addresses">Адреси доставки</a></li>
                                <li><a class="dropdown-item" asp-controller="Business" asp-action="Index">Панель продавця</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Мої товари</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Адмін-панель</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item nav-user-menu__logout">Вийти</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="site-header__account dropdown">
                            <button class="site-header__account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <small>Вітаємо,</small>
                                <strong>Увійти ⌄</strong>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end site-header__account-menu">
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="SignIn">Увійти</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="SignUp">Створити акаунт</a></li>
                            </ul>
                        </div>
                    }

                    <a class="site-header__orders" asp-controller="Order" asp-action="Index">
                        <small>Повернення та</small>
                        <strong>Замовлення</strong>
                    </a>

                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </div>

        <nav class="site-header__bottom" aria-label="Категорії">
            <div class="site-header__inner">
                <ul class="site-header__links">
                    <li>
                        <a asp-controller="Catalog" asp-action="Index" class="site-header__links--all">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                <path d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                            Усі товари
                        </a>
                    </li>
                    <li><a asp-controller="Home" asp-action="Index">Головна</a></li>
                    @foreach (var category in headerCategories.Take(6))
                    {
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-CategoryId="@category.Id">@category.Name</a></li>
                    }
                    @if (isAuthenticated)
                    {
                        <li><a asp-controller="Business" asp-action="Index">Панель продавця</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Мої товари</a></li>
                    }
                </ul>
            </div>
        </nav>

        <div class="collapse site-header__collapse" id="siteHeaderCollapse">
            <div class="site-header__inner site-header__collapse-inner">
                <div class="site-header__collapse-section">
                    @await Component.InvokeAsync("DeliveryLocation")
                </div>
                <div class="site-header__collapse-section">
                    @if (isAuthenticated)
                    {
                        <a class="site-header__collapse-link" asp-controller="Profile" asp-action="Index">Мій профіль</a>
                        <a class="site-header__collapse-link" asp-controller="Order" asp-action="Index">Мої замовлення</a>
                        <a class="site-header__collapse-link" asp-controller="Profile" asp-action="Wishlist">Список бажань</a>
                        <a class="site-header__collapse-link" asp-controller="Business" asp-action="Index">Панель продавця</a>
                        <a class="site-header__collapse-link" asp-controller="Products" asp-action="Index">Мої товари</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="site-header__collapse-link" asp-controller="Admin" asp-action="Index">Адмін-панель</a>
                        }
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit" class="site-header__collapse-link border-0 bg-transparent text-start w-100">Вийти</button>
                        </form>
                    }
                    else
                    {
                        <a class="site-header__collapse-link" asp-controller="Auth" asp-action="SignIn">Увійти</a>
                        <a class="site-header__collapse-link" asp-controller="Auth" asp-action="SignUp">Реєстрація</a>
                    }
                </div>
                <div class="site-header__collapse-section">
                    <a class="site-header__collapse-link" asp-controller="Home" asp-action="Index">Головна</a>
                    <a class="site-header__collapse-link" asp-controller="Catalog" asp-action="Index">Усі товари</a>
                    @foreach (var category in headerCategories)
                    {
                        <a class="site-header__collapse-link" asp-controller="Catalog" asp-action="Index" asp-route-CategoryId="@category.Id">@category.Name</a>
                    }
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer__top">
            <div class="site-footer__inner">
                <div class="site-footer__brand">
                    <a class="site-footer__logo" asp-controller="Home" asp-action="Index">Market<span>Place</span></a>
                    <p class="site-footer__tagline">Маркетплейс, де покупці знаходять потрібне, а продавці розвивають свій бізнес.</p>
                    <div class="site-footer__contacts">
                        <a href="mailto:support@marketplace.local">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                            support@marketplace.local
                        </a>
                        <a href="tel:0800123456">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" /></svg>
                            0 800 123 456
                        </a>
                    </div>

                    <div class="site-footer__social">
                        <span class="site-footer__social-label">Ми в соціальних мережах</span>
                        <div class="site-footer__social-icons">
                            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
                            </a>
                            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
                            </a>
                            <a href="https://t.me" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="m22 2-20 7.5 6 2.5m14-10-3 17-8-6.5m11-10.5-11 10.5m0 0-4-3" /></svg>
                            </a>
                            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none" /></svg>
                            </a>
                            <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="M16 3v10.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M16 3c0 2.5 2 4.5 4.5 4.5" /></svg>
                            </a>
                            <a href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="17" height="17" aria-hidden="true"><path d="M4 4 20 20M20 4 4 20" /></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="site-footer__col">
                    <h3>Покупцям</h3>
                    <a asp-controller="Catalog" asp-action="Index">Каталог товарів</a>
                    <a asp-controller="Cart" asp-action="Index">Кошик</a>
                    <a asp-controller="Profile" asp-action="Wishlist">Список бажань</a>
                    <a asp-controller="Order" asp-action="Index">Мої замовлення</a>
                </div>

                <div class="site-footer__col">
                    <h3>Допомога</h3>
                    <a asp-controller="Home" asp-action="ShippingPolicy">Доставка та оплата</a>
                    <a asp-controller="Home" asp-action="ReturnsPolicy">Повернення та обмін</a>
                    <a asp-controller="Home" asp-action="Support">Підтримка та FAQ</a>
                </div>

                <div class="site-footer__col">
                    <h3>Продавцям</h3>
                    <a asp-controller="Business" asp-action="Index">Панель продавця</a>
                    <a asp-controller="Business" asp-action="Create">Створити магазин</a>
                    <a asp-controller="Home" asp-action="SellerRules">Правила для продавців</a>
                </div>

                <div class="site-footer__col">
                    <h3>Правова інформація</h3>
                    <a asp-controller="Home" asp-action="Terms">Умови використання</a>
                    <a asp-controller="Home" asp-action="Privacy">Конфіденційність</a>
                    <a asp-controller="Home" asp-action="CookiePolicy">Політика кукі</a>
                </div>
            </div>
        </div>

        <div class="site-footer__bottom">
            <div class="site-footer__inner">
                <span class="site-footer__copyright">&copy; 2026 MarketPlace</span>
                <div class="site-footer__payments">
                    <span>Оплата карткою через LiqPay:</span>
                    <span class="site-footer__payment-badge">VISA</span>
                    <span class="site-footer__payment-badge">Mastercard</span>
                </div>
            </div>
        </div>
    </footer>

    <partial name="_CookieConsent" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cookie-consent.js" asp-append-version="true"></script>
    <script src="~/js/search-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/site-header.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
