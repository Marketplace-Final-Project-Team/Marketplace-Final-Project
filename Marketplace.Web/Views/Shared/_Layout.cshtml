<!DOCTYPE html>
@inject Marketplace.BLL.Interfaces.ICategoryService CategoryService
@{
    var fullUserName = User.Identity?.Name ?? string.Empty;
    var compactUserName = fullUserName.Contains('@')
        ? fullUserName.Split('@', 2)[0]
        : fullUserName;
    compactUserName = compactUserName.Length > 16
        ? $"{compactUserName[..16]}…"
        : compactUserName;
    var userInitial = string.IsNullOrWhiteSpace(compactUserName)
        ? "U"
        : compactUserName[..1].ToUpperInvariant();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var headerCategories = await CategoryService.GetAllCategories();
}
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marketplace.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search-autocomplete.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cookie-consent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Marketplace.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="site-header__top">
            <div class="site-header__inner">
                <button class="site-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#siteHeaderCollapse" aria-controls="siteHeaderCollapse" aria-expanded="false" aria-label="Меню">
                    <span></span><span></span><span></span>
                </button>

                <a class="site-header__logo" asp-controller="Home" asp-action="Index">Market<span>Place</span></a>

                <div class="site-header__delivery-wrap">
                    @await Component.InvokeAsync("DeliveryLocation")
                </div>

                <form asp-controller="Catalog" asp-action="Index" method="get" class="site-header__search" role="search" data-search-wrapper>
                    <select name="CategoryId" class="site-header__search-category" aria-label="Категорія пошуку">
                        <option value="">Усі категорії</option>
                        @foreach (var category in headerCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <input type="text" name="Search" class="site-header__search-input" placeholder="Пошук товарів на MarketPlace" aria-label="Пошук товарів" autocomplete="off" data-search-autocomplete />
                    <button type="submit" class="site-header__search-btn" aria-label="Шукати">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                </form>

                <div class="site-header__actions">
                    <div id="google_translate_element" class="site-header__lang" title="Мова сайту"></div>

                    @if (isAuthenticated)
                    {
                        <div class="site-header__account dropdown">
                            <button class="site-header__account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@fullUserName">
                                <small>Вітаємо,</small>
                                <strong><span class="nav-user-chip__avatar" aria-hidden="true">@userInitial</span> @compactUserName</strong>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end site-header__account-menu">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Мій профіль</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">Мої замовлення</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Wishlist">Список бажань</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Addresses">Адреси доставки</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Мої товари</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Адмін-панель</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item nav-user-menu__logout">Вийти</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="site-header__account dropdown">
                            <button class="site-header__account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <small>Вітаємо,</small>
                                <strong>Увійти ⌄</strong>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end site-header__account-menu">
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="SignIn">Увійти</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="SignUp">Створити акаунт</a></li>
                            </ul>
                        </div>
                    }

                    <a class="site-header__orders" asp-controller="Order" asp-action="Index">
                        <small>Повернення та</small>
                        <strong>Замовлення</strong>
                    </a>

                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </div>

        <nav class="site-header__bottom" aria-label="Категорії">
            <div class="site-header__inner">
                <ul class="site-header__links">
                    <li>
                        <a asp-controller="Catalog" asp-action="Index" class="site-header__links--all">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                <path d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                            Усі товари
                        </a>
                    </li>
                    <li><a asp-controller="Home" asp-action="Index">Головна</a></li>
                    @foreach (var category in headerCategories.Take(6))
                    {
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-CategoryId="@category.Id">@category.Name</a></li>
                    }
                    @if (isAuthenticated)
                    {
                        <li><a asp-controller="Business" asp-action="Index">Панель продавця</a></li>
                        <li><a asp-controller="Products" asp-action="Index">Мої товари</a></li>
                    }
                </ul>
            </div>
        </nav>

        <div class="collapse site-header__collapse" id="siteHeaderCollapse">
            <div class="site-header__inner site-header__collapse-inner">
                <div class="site-header__collapse-section">
                    @await Component.InvokeAsync("DeliveryLocation")
                </div>
                <div class="site-header__collapse-section">
                    @if (isAuthenticated)
                    {
                        <a class="site-header__collapse-link" asp-controller="Profile" asp-action="Index">Мій профіль</a>
                        <a class="site-header__collapse-link" asp-controller="Order" asp-action="Index">Мої замовлення</a>
                        <a class="site-header__collapse-link" asp-controller="Profile" asp-action="Wishlist">Список бажань</a>
                        <a class="site-header__collapse-link" asp-controller="Business" asp-action="Index">Панель продавця</a>
                        <a class="site-header__collapse-link" asp-controller="Products" asp-action="Index">Мої товари</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="site-header__collapse-link" asp-controller="Admin" asp-action="Index">Адмін-панель</a>
                        }
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            <button type="submit" class="site-header__collapse-link border-0 bg-transparent text-start w-100">Вийти</button>
                        </form>
                    }
                    else
                    {
                        <a class="site-header__collapse-link" asp-controller="Auth" asp-action="SignIn">Увійти</a>
                        <a class="site-header__collapse-link" asp-controller="Auth" asp-action="SignUp">Реєстрація</a>
                    }
                </div>
                <div class="site-header__collapse-section">
                    <a class="site-header__collapse-link" asp-controller="Home" asp-action="Index">Головна</a>
                    <a class="site-header__collapse-link" asp-controller="Catalog" asp-action="Index">Усі товари</a>
                    @foreach (var category in headerCategories)
                    {
                        <a class="site-header__collapse-link" asp-controller="Catalog" asp-action="Index" asp-route-CategoryId="@category.Id">@category.Name</a>
                    }
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 MarketPlace - навчальний маркетплейс</span>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Home" asp-action="Privacy" class="text-muted">Конфіденційність</a>
                <a asp-controller="Home" asp-action="Terms" class="text-muted">Умови використання</a>
                <a asp-controller="Home" asp-action="CookiePolicy" class="text-muted">Політика кукі</a>
                <a asp-controller="Home" asp-action="ReturnsPolicy" class="text-muted">Повернення та обмін</a>
                <a asp-controller="Home" asp-action="ShippingPolicy" class="text-muted">Доставка</a>
                <a asp-controller="Home" asp-action="SellerRules" class="text-muted">Для продавців</a>
                <a asp-controller="Home" asp-action="Support" class="text-muted">Підтримка</a>
            </div>
        </div>
    </footer>

    <partial name="_CookieConsent" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cookie-consent.js" asp-append-version="true"></script>
    <script src="~/js/search-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/site-header.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
