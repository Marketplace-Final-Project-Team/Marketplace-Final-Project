<div class="cookie-consent" data-cookie-consent hidden>
    <div class="cookie-consent__card">
        <span class="cookie-consent__icon" aria-hidden="true">🍪</span>
        <h2>@Localizer["Ми використовуємо кукі"]</h2>
        <p>
            @Localizer["Обов'язкові кукі потрібні для входу в акаунт і роботи сайту - їх не можна вимкнути. Додатково ми можемо запам'ятовувати нещодавно переглянуті товари та обраний спосіб доставки - лише якщо ви погодитесь. Детальніше - у"]
            <a asp-controller="Home" asp-action="CookiePolicy">@Localizer["Політиці використання кукі"]</a>.
        </p>
        <div class="cookie-consent__actions">
            <button type="button" class="btn btn-outline-secondary" data-cookie-reject>@Localizer["Відхилити"]</button>
            <button type="button" class="btn btn-primary" data-cookie-accept>@Localizer["Прийняти"]</button>
        </div>
    </div>
</div>
