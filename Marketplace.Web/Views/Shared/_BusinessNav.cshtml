@model Guid
@using System.Security.Claims
@using Marketplace.BLL.Common
@using Marketplace.BLL.Interfaces
@using Marketplace.Domain.Enums
@inject IBusinessAccessService BusinessAccessService

@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isProductsSection = string.Equals(currentController, "Products", StringComparison.OrdinalIgnoreCase);

    string ActiveClass(string action) => string.Equals(current, action, StringComparison.OrdinalIgnoreCase)
        ? "is-active"
        : string.Empty;

    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentRole = !string.IsNullOrEmpty(userId)
        ? await BusinessAccessService.GetUserRoleAsync(Model, userId)
        : null;
}

@if (currentRole.HasValue)
{
    var role = currentRole.Value;

    <nav class="business-nav" aria-label="@Localizer["Розділи панелі магазину"]">

        @if (BusinessPermissions.Statistics.Contains(role))
        {
            <a class="@ActiveClass("Dashboard")" asp-controller="Business" asp-action="Dashboard" asp-route-businessId="@Model">@Localizer["Дашборд"]</a>
        }

        @if (BusinessPermissions.ProductCrud.Contains(role))
        {
            <a class="@(isProductsSection ? "is-active" : "")" asp-controller="Products" asp-action="Index" asp-route-businessId="@Model">@Localizer["Товари"]</a>
        }

        <a class="@ActiveClass("Orders")" asp-controller="Business" asp-action="Orders" asp-route-businessId="@Model">@SharedLocalizer["Замовлення"]</a>
        <a class="@ActiveClass("Returns")" asp-controller="Business" asp-action="Returns" asp-route-businessId="@Model">@Localizer["Повернення"]</a>

        @if (BusinessPermissions.Statistics.Contains(role))
        {
            <a class="@ActiveClass("Finance")" asp-controller="Business" asp-action="Finance" asp-route-businessId="@Model">@Localizer["Фінанси"]</a>
            <a class="@ActiveClass("Performance")" asp-controller="Business" asp-action="Performance" asp-route-businessId="@Model">@Localizer["Ефективність"]</a>
            <a class="@ActiveClass("Growth")" asp-controller="Business" asp-action="Growth" asp-route-businessId="@Model">@Localizer["Розвиток"]</a>
        }

        @if (BusinessPermissions.PromoCodes.Contains(role))
        {
            <a class="@ActiveClass("PromoCodes")" asp-controller="Business" asp-action="PromoCodes" asp-route-businessId="@Model">@Localizer["Знижки"]</a>
        }

        @if (BusinessPermissions.ManageTeam.Contains(role))
        {
            <a class="@ActiveClass("Team")" asp-controller="Business" asp-action="Team" asp-route-businessId="@Model">@Localizer["Команда"]</a>
        }

        @if (BusinessPermissions.EditBusinessProfile.Contains(role))
        {
            <a class="@ActiveClass("Settings")" asp-controller="Business" asp-action="Settings" asp-route-businessId="@Model">@Localizer["Налаштування"]</a>
        }
    </nav>
}
