@model Marketplace.Web.Models.WishlistPageViewModel

@{
    ViewData["Title"] = "Список бажань";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wishlist-notifications.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← До кабінету</a>

    <div class="profile-summary">
        <h1>Список бажань</h1>
        <p>Товари, які ви зберегли на потім (@Model.TotalItems).</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="profile-empty">
            <div class="profile-empty__icon" aria-hidden="true">♡</div>
            <h2>Список бажань порожній</h2>
            <p>Додавайте товари з каталогу, натискаючи "У список бажань" на сторінці товару.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Перейти до каталогу</a>
        </div>
    }
    else
    {
        <p class="text-muted small mb-3">
            Хочете розкласти товари по категоріях — подарунки, сезонні покупки тощо? Спробуйте
            <a asp-controller="WishlistCollection" asp-action="Index">колекції бажань</a>.
        </p>

        <div class="wishlist-grid" data-wishlist-grid>
            @foreach (var item in Model.Items)
            {
                <article class="wishlist-card" data-wishlist-card data-product-id="@item.ProductId" data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-in-stock="@item.InStock.ToString().ToLowerInvariant()">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="wishlist-card__media" aria-label="Переглянути @item.ProductName">
                        <span class="wishlist-card__alert" data-wishlist-alert hidden></span>
                        @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                        {
                            <img src="@item.MainImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <span aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</span>
                        }
                        @if (!item.InStock)
                        {
                            <small class="wishlist-card__stock">Немає в наявності</small>
                        }
                    </a>
                    <div class="wishlist-card__body">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="wishlist-card__title">@item.ProductName</a>
                        <div class="wishlist-card__footer">
                            <span class="fw-semibold" data-wishlist-price>@item.Price.ToString("N2") ₴</span>
                            <form asp-action="RemoveFromWishlist" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="wishlist-remove">Видалити</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/wishlist-notifications.js" asp-append-version="true"></script>
}
