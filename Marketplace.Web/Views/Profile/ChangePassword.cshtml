@model ChangePasswordViewModel

@{
    ViewData["Title"] = Localizer["Зміна пароля"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← @Localizer["До кабінету"]</a>

    <div class="address-form-card">
        <h1>@Localizer["Зміна пароля"]</h1>
        <p class="profile-form-hint mb-4">@Localizer["Оновіть пароль, який використовуєте для входу в акаунт."]</p>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="address-form-field">
                <label asp-for="CurrentPassword" class="form-label">@Localizer["Поточний пароль"]</label>
                <div class="profile-password-field">
                    <input asp-for="CurrentPassword" class="form-control" data-password-input autocomplete="current-password" />
                    <button type="button" class="profile-password-toggle" data-password-toggle aria-pressed="false">@Localizer["Показати"]</button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="address-form-field">
                <label asp-for="NewPassword" class="form-label">@Localizer["Новий пароль"]</label>
                <div class="profile-password-field">
                    <input asp-for="NewPassword" class="form-control" data-password-input autocomplete="new-password" />
                    <button type="button" class="profile-password-toggle" data-password-toggle aria-pressed="false">@Localizer["Показати"]</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="address-form-field">
                <label asp-for="ConfirmNewPassword" class="form-label">@Localizer["Підтвердження нового пароля"]</label>
                <div class="profile-password-field">
                    <input asp-for="ConfirmNewPassword" class="form-control" data-password-input autocomplete="new-password" />
                    <button type="button" class="profile-password-toggle" data-password-toggle aria-pressed="false">@Localizer["Показати"]</button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <div class="address-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Скасувати"]</a>
                <button type="submit" class="btn btn-primary">@Localizer["Змінити пароль"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile-password-toggle.js" asp-append-version="true"></script>
}
