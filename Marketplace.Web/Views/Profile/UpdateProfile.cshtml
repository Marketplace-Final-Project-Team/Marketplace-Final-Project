@model ProfileUpdateViewModel

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = Localizer["Редагування профілю"];
    var initial = string.IsNullOrWhiteSpace(Model.Username) ? "U" : Model.Username[..1].ToUpperInvariant();
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← @Localizer["До кабінету"]</a>

    <div class="address-form-card">
        <h1>@Localizer["Редагування профілю"]</h1>

        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="profile-avatar-upload">
                <div class="profile-avatar-upload__preview">
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl))
                    {
                        <img src="@Model.CurrentAvatarUrl" alt="@Localizer["Поточний аватар"]" />
                    }
                    else
                    {
                        <span class="profile-avatar profile-avatar--fallback">@initial</span>
                    }
                </div>
                <div>
                    <label class="btn btn-outline-primary" for="avatar-input">@Localizer["Змінити фото"]</label>
                    <input asp-for="Avatar" id="avatar-input" class="visually-hidden" accept="image/png,image/jpeg,image/webp" data-avatar-input />
                    <p class="profile-form-hint">@Localizer["JPG, PNG або WEBP. Замінить поточний аватар."]</p>
                    <span asp-validation-for="Avatar" class="text-danger small"></span>
                </div>
            </div>

            <div class="address-form-field">
                <label asp-for="Username" class="form-label">@Localizer["Ім'я користувача"]</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="address-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Скасувати"]</a>
                <button type="submit" class="btn btn-primary">@Localizer["Зберегти"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.querySelector('[data-avatar-input]');
            var previewWrap = document.querySelector('.profile-avatar-upload__preview');
            if (!input || !previewWrap) {
                return;
            }

            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) {
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (e) {
                    previewWrap.innerHTML = '<img src="' + e.target.result + '" alt="@Localizer["Новий аватар"]" />';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
