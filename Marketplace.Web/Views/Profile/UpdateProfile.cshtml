@model ProfileUpdateViewModel

@{
    ViewData["Title"] = "Редагування профілю";
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-body">

            <h2 class="mb-4">Редагування профілю</h2>

            <form asp-action="UpdateProfile" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Username" class="form-label"></label>

                    <input asp-for="Username"
                           class="form-control" />

                    <span asp-validation-for="Username"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Avatar"
                           class="form-label"></label>

                    <input asp-for="Avatar"
                           class="form-control" />

                    <span asp-validation-for="Avatar"
                          class="text-danger"></span>

                </div>

                <button class="btn btn-primary">
                    Зберегти
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Скасувати
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}