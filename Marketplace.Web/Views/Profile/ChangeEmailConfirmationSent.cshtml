@{
    ViewData["Title"] = Localizer["Підтвердження зміни email"];
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body text-center">

            <h2 class="mb-3">@Localizer["Підтвердіть зміну електронної пошти"]</h2>

            <p class="text-muted">
                @Localizer["Ми надіслали лист із посиланням для підтвердження на вашу нову електронну адресу."]
            </p>

            <p>
                @Localizer["Відкрийте лист і натисніть на посилання, щоб завершити зміну email."]
            </p>

            <a asp-action="Index" class="btn btn-primary mt-3">
                @Localizer["Повернутися до профілю"]
            </a>

        </div>
    </div>
</div>