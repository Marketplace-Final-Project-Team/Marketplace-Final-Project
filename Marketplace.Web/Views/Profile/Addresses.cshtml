@model List<Marketplace.Web.Models.AddressViewModel>

@{
    ViewData["Title"] = "Мої адреси";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← До кабінету</a>

    <div class="profile-summary" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
        <div>
            <h1>Мої адреси</h1>
            <p>Збережені адреси доставки для швидшого оформлення замовлення.</p>
        </div>
        <a asp-action="CreateAddress" class="btn btn-primary">+ Додати адресу</a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="profile-empty">
            <div class="profile-empty__icon" aria-hidden="true">⌂</div>
            <h2>Адрес поки немає</h2>
            <p>Додайте адресу, щоб не вводити її щоразу під час оформлення замовлення.</p>
            <a asp-action="CreateAddress" class="btn btn-primary">Додати першу адресу</a>
        </div>
    }
    else
    {
        <div class="address-list">
            @foreach (var address in Model)
            {
                <div class="address-card">
                    <div class="address-card__lines">
                        @if (address.IsDefault)
                        {
                            <span class="address-card__badge">Основна</span>
                        }
                        <strong>@address.Country, @address.City</strong>
                        <p>@address.Street</p>
                    </div>
                    <div class="address-card__actions">
                        @if (!address.IsDefault)
                        {
                            <form asp-action="SetDefaultAddress" method="post">
                                <input type="hidden" name="id" value="@address.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Зробити основною</button>
                            </form>
                        }
                        <a asp-action="EditAddress" asp-route-id="@address.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                        <form asp-action="DeleteAddress" method="post" onsubmit="return confirm('Видалити цю адресу?');">
                            <input type="hidden" name="id" value="@address.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
