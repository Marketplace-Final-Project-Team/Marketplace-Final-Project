@model ProfileViewModel

@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = SharedLocalizer["Мій профіль"];
    var profileInitial = string.IsNullOrWhiteSpace(Model.Username)
        ? "U"
        : Model.Username[..1].ToUpperInvariant();
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="profile-page">
    <div class="profile-summary">
        <div class="profile-summary__row">
            <a asp-action="UpdateProfile" class="profile-avatar-wrap" aria-label="@Localizer["Змінити аватар"]">
                @if (!string.IsNullOrEmpty(Model.Avatar))
                {
                    <img src="@Model.Avatar" class="profile-avatar" alt="@Localizer["Аватар користувача"] @Model.Username" />
                }
                else
                {
                    <span class="profile-avatar profile-avatar--fallback" role="img" aria-label="@Localizer["Аватар користувача"] @Model.Username">@profileInitial</span>
                }
                <span class="profile-avatar-edit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                    </svg>
                </span>
            </a>
            <div class="flex-grow-1">
                <h1>@Model.Username</h1>
                <p class="mb-2">@Model.Email</p>

                <div class="profile-id-field">
                    <span class="profile-id-field__label">ID</span>
                    <input type="text" class="profile-id-field__input" id="profileUserId" value="@Model.UserId" readonly aria-label="@Localizer["ID користувача"]" />
                    <button type="button" class="profile-id-field__btn" id="copyUserIdBtn"
                            data-copied-text="@Localizer["Скопійовано"]"
                            aria-label="@Localizer["Копіювати ID"]" title="@Localizer["Копіювати ID"]">
                        <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" />
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                        </svg>
                        <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true" hidden>
                            <path d="M20 6 9 17l-5-5" />
                        </svg>
                    </button>
                </div>

                @if (Model.PersonalDiscounts.Count > 0)
                {
                    var discountsJson = System.Text.Json.JsonSerializer.Serialize(
                        Model.PersonalDiscounts.Select(d => new
                        {
                            store = d.StoreName,
                            percent = d.Percent,
                            until = DateTime.SpecifyKind(d.EndDate, DateTimeKind.Utc).ToString("O")
                        }));

                    <div class="profile-discount-widget" data-discounts='@Html.Raw(discountsJson)'>
                        <div class="profile-discount-widget__badge">
                            <span class="profile-discount-widget__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="11" height="11">
                                    <path d="m12 2 2.4 4.86 5.37.78-3.89 3.79.92 5.35L12 14.27l-4.8 2.51.92-5.35-3.89-3.79 5.37-.78L12 2Z" />
                                </svg>
                            </span>
                            <span class="profile-discount-widget__text" data-discount-display>
                                <strong>-@Model.PersonalDiscounts[0].Percent.ToString("0.##")%</strong> @Localizer["в"] «@Model.PersonalDiscounts[0].StoreName»
                            </span>
                        </div>

                        <div class="profile-discount-widget__tooltip">
                            <div class="profile-discount-widget__tooltip-title">@Localizer["Ваші персональні знижки"]</div>
                            @foreach (var discount in Model.PersonalDiscounts)
                            {
                                <div class="profile-discount-widget__tooltip-item">
                                    <div>
                                        <span class="profile-discount-widget__tooltip-store">@discount.StoreName</span>
                                        <span class="profile-discount-widget__tooltip-date">@Localizer["до"] <time utc-value="@discount.EndDate" date-only="true"></time></span>
                                    </div>
                                    <strong>-@discount.Percent.ToString("0.##")%</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="profile-hub">
        <a asp-controller="Order" asp-action="Index" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M21 8 12 3 3 8l9 5 9-5Z" />
                    <path d="M3 8v8l9 5 9-5V8" />
                    <path d="M12 13v8" />
                </svg>
            </span>
            <div>
                <strong>@SharedLocalizer["Мої замовлення"]</strong>
                <span>@Localizer["Історія покупок і статус доставки"]</span>
                <span class="profile-hub-card__badge">@Model.OrdersCount</span>
            </div>
        </a>

        <a asp-action="Addresses" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M3 11 12 3l9 8" />
                    <path d="M5 10v10h14V10" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Адреси"]</strong>
                <span>@Localizer["Керуйте адресами доставки"]</span>
                <span class="profile-hub-card__badge">@Model.AddressesCount</span>
            </div>
        </a>

        <a asp-action="Wishlist" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M12 20s-7-4.35-9.5-8.5C.9 8.1 2 5 5.4 5c2 0 3.6 1.3 4.6 2.9C11 6.3 12.6 5 14.6 5c3.4 0 4.5 3.1 2.9 6.5C19 15.65 12 20 12 20Z" />
                </svg>
            </span>
            <div>
                <strong>@SharedLocalizer["Список бажань"]</strong>
                <span>@Localizer["Товари, які ви зберегли"]</span>
                <span class="profile-hub-card__badge">@Model.WishlistCount</span>
            </div>
        </a>

        <a asp-action="Discounts" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="m20.59 13.41-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" />
                    <circle cx="7" cy="7" r="1.5" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Мої знижки"]</strong>
                <span>@Localizer["Персональні знижки від продавців"]</span>
                <span class="profile-hub-card__badge">@Model.DiscountsCount</span>
            </div>
        </a>

        <a asp-controller="WishlistCollection" asp-action="Index" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M4 5h16v14H4z" />
                    <path d="M4 10h16" />
                    <path d="M9 5v14" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Колекції бажань"]</strong>
                <span>@Localizer["Групуйте товари за своїми списками"]</span>
            </div>
        </a>

        <a asp-action="Activity" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M18 8a6 6 0 1 0-12 0c0 4-2 5-2 7h16c0-2-2-3-2-7" />
                    <path d="M10 21a2 2 0 0 0 4 0" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Сповіщення"]</strong>
                <span>@Localizer["Останні події за вашими замовленнями"]</span>
            </div>
        </a>

        <a asp-action="UpdateProfile" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Налаштування профілю"]</strong>
                <span>@Localizer["Ім'я користувача та аватар"]</span>
            </div>
        </a>

        <a asp-action="ChangePassword" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <rect x="5" y="11" width="14" height="9" rx="2" />
                    <path d="M8 11V7a4 4 0 1 1 8 0v4" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Зміна пароля"]</strong>
                <span>@Localizer["Оновіть пароль для входу"]</span>
            </div>
        </a>

        <a asp-action="ChangeEmail" class="profile-hub-card">
            <span class="profile-hub-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                </svg>
            </span>
            <div>
                <strong>@Localizer["Змінити Email"]</strong>
                <span>@Localizer["Оновіть адресу електронної пошти"]</span>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile-discounts.js" asp-append-version="true"></script>
    
    <script>
        (function () {
            const btn = document.getElementById('copyUserIdBtn');
            const input = document.getElementById('profileUserId');
            if (!btn || !input) return;

            const iconCopy = btn.querySelector('.icon-copy');
            const iconCheck = btn.querySelector('.icon-check');
            let timer;

            async function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                } else {
                    input.select();
                    input.setSelectionRange(0, text.length);
                    document.execCommand('copy');
                    input.setSelectionRange(0, 0);
                    input.blur();
                }
            }

            btn.addEventListener('click', async function () {
                try {
                    await copyText(input.value);
                    btn.classList.add('is-copied');
                    iconCopy.hidden = true;
                    iconCheck.hidden = false;
                    btn.title = btn.dataset.copiedText;

                    clearTimeout(timer);
                    timer = setTimeout(function () {
                        btn.classList.remove('is-copied');
                        iconCopy.hidden = false;
                        iconCheck.hidden = true;
                        btn.title = btn.getAttribute('aria-label');
                    }, 1800);
                } catch (e) {
                    console.error('Copy failed', e);
                }
            });
        })();
    </script>
}
