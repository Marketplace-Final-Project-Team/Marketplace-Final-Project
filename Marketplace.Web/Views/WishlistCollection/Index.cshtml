@model IEnumerable<Marketplace.BLL.DTOs.WishlistCollectionDto>

@{
    ViewData["Title"] = "Колекції бажань";
    var collections = Model.ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wishlist-collection.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-controller="Profile" asp-action="Index" class="profile-back">← До кабінету</a>

    <div class="profile-summary">
        <h1>Колекції бажань</h1>
        <p>Групуйте товари зі списку бажань у власні колекції — наприклад, подарунки або покупки на сезон.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <form asp-action="Create" method="post" class="wishlist-collection-create">
        <label for="new-collection-name">Нова колекція</label>
        <input type="text" id="new-collection-name" name="name" placeholder="Наприклад: Подарунки" maxlength="40" required />
        <button type="submit" class="btn btn-primary btn-sm">+ Створити</button>
    </form>

    @if (collections.Count == 0)
    {
        <div class="profile-empty">
            <div class="profile-empty__icon" aria-hidden="true">☆</div>
            <h2>Колекцій поки немає</h2>
            <p>Створіть першу колекцію вище, щоб почати групувати товари зі списку бажань.</p>
        </div>
    }
    else
    {
        <div class="wishlist-collection-grid">
            @foreach (var collection in collections)
            {
                <div class="wishlist-collection-card">
                    <a asp-action="Details" asp-route-id="@collection.Id" class="wishlist-collection-card__link">
                        <strong>@collection.Name</strong>
                        <span>@collection.ItemCount @(collection.ItemCount == 1 ? "товар" : "товарів")</span>
                    </a>
                    <div class="wishlist-collection-card__actions">
                        <a asp-action="Edit" asp-route-id="@collection.Id" class="btn btn-sm btn-outline-secondary">Перейменувати</a>
                        <form asp-action="Delete" asp-route-id="@collection.Id" method="post" onsubmit="return confirm('Видалити колекцію «@collection.Name» разом із товарами в ній?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
