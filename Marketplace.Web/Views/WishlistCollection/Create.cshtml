@{
    ViewData["Title"] = Localizer["Нова колекція"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wishlist-collection.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← @Localizer["До колекцій"]</a>

    <div class="profile-summary">
        <h1>@Localizer["Нова колекція"]</h1>
        <p>@Localizer["Дайте колекції назву, яку легко впізнати пізніше."]</p>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <form asp-action="Create" method="post" class="wishlist-collection-form">
        <label for="name">@Localizer["Назва колекції"]</label>
        <input type="text" id="name" name="name" placeholder="@Localizer["Наприклад: Подарунки"]" maxlength="40" required autofocus />
        <div class="wishlist-collection-form__actions">
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Скасувати"]</a>
            <button type="submit" class="btn btn-primary">@Localizer["Створити"]</button>
        </div>
    </form>
</div>
