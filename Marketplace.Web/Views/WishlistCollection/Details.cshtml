@model Marketplace.Web.Models.WishlistCollectionDetailsViewModel

@{
    ViewData["Title"] = Model.Collection.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wishlist-collection.css" asp-append-version="true" />
}

<div class="profile-page">
    <a asp-action="Index" class="profile-back">← До колекцій</a>

    <div class="profile-summary">
        <h1>@Model.Collection.Name</h1>
        <p>@Model.Collection.Items.Count @(Model.Collection.Items.Count == 1 ? "товар" : "товарів") у цій колекції.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    @if (Model.Collection.Items.Count == 0)
    {
        <div class="profile-empty">
            <div class="profile-empty__icon" aria-hidden="true">☆</div>
            <h2>У цій колекції поки немає товарів</h2>
            <p>Додайте товари зі свого списку бажань нижче.</p>
        </div>
    }
    else
    {
        <div class="wishlist-grid">
            @foreach (var item in Model.Collection.Items)
            {
                <article class="wishlist-card">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="wishlist-card__media">
                        @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                        {
                            <img src="@item.MainImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <span aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</span>
                        }
                    </a>
                    <div class="wishlist-card__body">
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.ProductId" class="wishlist-card__title">@item.ProductName</a>
                        <div class="wishlist-card__footer">
                            <span class="fw-semibold">@item.Price.ToString("N2") ₴</span>
                            <form asp-action="RemoveItem" method="post">
                                <input type="hidden" name="collectionId" value="@Model.Collection.Id" />
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="wishlist-remove">Прибрати</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    <section class="wishlist-collection-add">
        <h2>Додати зі списку бажань</h2>
        @if (Model.AvailableToAdd.Count == 0)
        {
            <p class="text-muted small">
                Усі товари з вашого списку бажань уже в цій колекції, або список бажань порожній.
                <a asp-controller="Profile" asp-action="Wishlist">Перейти до списку бажань</a>
            </p>
        }
        else
        {
            <div class="wishlist-collection-add__list">
                @foreach (var item in Model.AvailableToAdd)
                {
                    <div class="wishlist-collection-add__item">
                        @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                        {
                            <img src="@item.MainImageUrl" alt="@item.ProductName" />
                        }
                        else
                        {
                            <span class="wishlist-collection-add__placeholder" aria-hidden="true">@item.ProductName[..1].ToUpperInvariant()</span>
                        }
                        <span class="wishlist-collection-add__name">@item.ProductName</span>
                        <span class="wishlist-collection-add__price">@item.Price.ToString("N2") ₴</span>
                        <form asp-action="AddItem" method="post">
                            <input type="hidden" name="collectionId" value="@Model.Collection.Id" />
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">+ Додати</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>
</div>
